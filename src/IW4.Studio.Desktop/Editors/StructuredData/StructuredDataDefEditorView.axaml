<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:viewModels="using:IW4.Studio.Desktop.ViewModels"
             x:Class="IW4.Studio.Desktop.Editors.StructuredData.StructuredDataDefEditorView"
             x:DataType="viewModels:StructuredDataDefEditorViewModel"
             mc:Ignorable="d"
             SizeChanged="Editor_SizeChanged"
             d:DesignWidth="1120"
             d:DesignHeight="720">
  <UserControl.Styles>
    <Style Selector="TreeView.structuredDataNavigation TreeViewItem">
      <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
    </Style>

    <Style Selector="ListBox.structuredDataRows">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.structuredDataRows > ListBoxItem">
      <Setter Property="MinHeight" Value="58" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="ListBox.structuredDataRows > ListBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource StudioControlHoverBrush}" />
    </Style>
    <Style Selector="ListBox.structuredDataRows > ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource StudioControlSelectedBrush}" />
    </Style>
    <Style Selector="ListBox.structuredDataRows > ListBoxItem:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource StudioFocusBrush}" />
    </Style>
  </UserControl.Styles>

  <Border MinHeight="440"
          CornerRadius="8"
          ClipToBounds="True"
          Background="{DynamicResource StudioSurfaceBrush}"
          BorderBrush="{DynamicResource StudioBorderBrush}"
          BorderThickness="1">
    <Grid RowDefinitions="Auto,1,*,Auto">
      <Border Padding="24,18">
        <Grid x:Name="EditorHeaderGrid"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="24">
          <StackPanel MinWidth="0"
                      Spacing="5">
            <TextBlock Text="{Binding DisplayName}"
                       FontSize="21"
                       FontWeight="Medium"
                       Foreground="{DynamicResource StudioTextBrush}"
                       TextTrimming="CharacterEllipsis" />
            <Grid ColumnDefinitions="2*,Auto,3*"
                  ColumnSpacing="9">
              <TextBlock Text="{Binding Name}"
                         FontSize="10"
                         Foreground="{DynamicResource StudioTextMutedBrush}"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding Name}" />
              <Ellipse Grid.Column="1"
                       Width="5"
                       Height="5"
                       VerticalAlignment="Center"
                       Fill="{DynamicResource StudioAccentBrush}" />
              <TextBlock Grid.Column="2"
                         Text="{Binding SummaryText}"
                         FontSize="10"
                         Foreground="{DynamicResource StudioTextMutedBrush}"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding SummaryText}" />
            </Grid>
          </StackPanel>

          <StackPanel x:Name="EditorHeaderActions"
                      Grid.Column="1"
                      Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Spacing="8">
            <Button MinHeight="38"
                    Padding="14,8"
                    IsEnabled="{Binding CanRevert}"
                    ToolTip.Tip="Discard unapplied changes"
                    Click="RevertDraftButton_Click">
              <TextBlock Text="Revert" />
            </Button>
            <Button Classes="primary"
                    MinHeight="38"
                    Padding="17,8"
                    IsEnabled="{Binding CanApply}"
                    ToolTip.Tip="Apply changes to the working fastfile"
                    Click="ApplyDraftButton_Click">
              <TextBlock Text="Apply changes" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1"
              Background="{DynamicResource StudioBorderBrush}" />

      <Grid x:Name="EditorBodyGrid"
            Grid.Row="2"
            RowDefinitions="*"
            ColumnDefinitions="1.6*,1,5*">
        <Border x:Name="OutlinePane"
                Padding="20,22"
                Background="{DynamicResource StudioSurfaceSunkenBrush}">
          <Grid RowDefinitions="Auto,16,*">
            <TextBlock Text="SCHEMA OUTLINE"
                       Margin="4,0,0,0"
                       FontSize="9"
                       FontWeight="SemiBold"
                       LetterSpacing="0.9"
                       Foreground="{DynamicResource StudioTextSubtleBrush}" />

            <TreeView Grid.Row="2"
                      Classes="studioNavigatorTree structuredDataNavigation"
                      ItemsSource="{Binding NavigationRoots}"
                      SelectedItem="{Binding SelectedNavigationNode, Mode=TwoWay}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
              <TreeView.ItemTemplate>
                <TreeDataTemplate x:DataType="viewModels:StructuredDataNavigationNodeViewModel"
                                  ItemsSource="{Binding Children}">
                  <Grid MinHeight="38"
                        Margin="3,2,8,2">
                    <TextBlock Text="{Binding Title}"
                               Margin="4,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               FontWeight="Medium"
                               Foreground="{DynamicResource StudioTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Title}" />
                  </Grid>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </Grid>
        </Border>

        <Border x:Name="BodyDivider"
                Grid.Column="1"
                Background="{DynamicResource StudioBorderBrush}" />

        <Grid x:Name="DetailPane"
              Grid.Column="2"
              RowDefinitions="Auto,1,42,*">
          <Border Padding="30,24,30,22"
                  Background="{DynamicResource StudioSurfaceBrush}">
            <StackPanel Spacing="9">
              <TextBlock Text="{Binding SelectionBreadcrumb}"
                         FontSize="10"
                         Foreground="{DynamicResource StudioTextMutedBrush}"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding SelectionBreadcrumb}" />
              <Grid ColumnDefinitions="*,Auto"
                    ColumnSpacing="10">
                <TextBlock Text="{Binding SelectionTitle}"
                           VerticalAlignment="Center"
                           FontSize="20"
                           FontWeight="Medium"
                           Foreground="{DynamicResource StudioTextBrush}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding SelectionTitle}" />
                <Border Grid.Column="1"
                        Padding="8,4"
                        CornerRadius="6"
                        Background="{DynamicResource StudioAccentSurfaceBrush}">
                  <TextBlock Text="{Binding SelectionKindText}"
                             FontSize="9"
                             FontWeight="Bold"
                             LetterSpacing="0.6"
                             Foreground="{DynamicResource StudioAccentBrush}" />
                </Border>
              </Grid>
              <TextBlock Text="{Binding SchemaHelpText}"
                         FontSize="11"
                         Foreground="{DynamicResource StudioTextMutedBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Grid.Row="1"
                  Background="{DynamicResource StudioBorderBrush}" />

          <Border Grid.Row="2"
                  Margin="28,0"
                  Background="{DynamicResource StudioSurfaceSunkenBrush}"
                  BorderBrush="{DynamicResource StudioBorderBrush}"
                  BorderThickness="0,0,0,1">
            <Grid Margin="14,0"
                  ColumnDefinitions="1.5*,1.15*,0.85*"
                  ColumnSpacing="20">
              <TextBlock Text="{Binding SchemaFirstColumnTitle}"
                         VerticalAlignment="Center"
                         FontSize="9"
                         FontWeight="SemiBold"
                         LetterSpacing="0.8"
                         Foreground="{DynamicResource StudioTextSubtleBrush}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1"
                         Text="{Binding SchemaSecondColumnTitle}"
                         VerticalAlignment="Center"
                         FontSize="9"
                         FontWeight="SemiBold"
                         LetterSpacing="0.8"
                         Foreground="{DynamicResource StudioTextSubtleBrush}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2"
                         Text="{Binding SchemaThirdColumnTitle}"
                         VerticalAlignment="Center"
                         FontSize="9"
                         FontWeight="SemiBold"
                         LetterSpacing="0.8"
                         Foreground="{DynamicResource StudioTextSubtleBrush}"
                         TextTrimming="CharacterEllipsis" />
            </Grid>
          </Border>

          <Grid Grid.Row="3"
                Margin="28,0,28,20">
            <ListBox Classes="structuredDataRows"
                     ItemsSource="{Binding VisibleRows}"
                     SelectedItem="{Binding SelectedMember, Mode=TwoWay}"
                     IsVisible="{Binding HasVisibleRows}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="viewModels:StructuredDataMemberRowViewModel">
                  <Grid MinHeight="58"
                        Margin="14,0"
                        ColumnDefinitions="1.5*,1.15*,0.85*"
                        ColumnSpacing="20">
                    <TextBlock Text="{Binding PrimaryText}"
                               VerticalAlignment="Center"
                               FontSize="11"
                               FontWeight="Medium"
                               Foreground="{DynamicResource StudioTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding PrimaryText}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding SchemaTypeText}"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource StudioTextMutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding SchemaTypeText}" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding SchemaCardinalityText}"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource StudioTextMutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding SchemaCardinalityText}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock IsVisible="{Binding !HasVisibleRows}"
                       Margin="32"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       MaxWidth="440"
                       Text="{Binding EmptySelectionMessage}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="{DynamicResource StudioTextMutedBrush}" />
          </Grid>
        </Grid>
      </Grid>

      <Border Grid.Row="3"
              IsVisible="{Binding !HasNoDiagnostics}"
              Padding="14,9"
              Background="{DynamicResource StudioSurfaceSunkenBrush}"
              BorderBrush="{DynamicResource StudioBorderBrush}"
              BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="Auto,8,*">
          <materialIcons:MaterialIcon Kind="AlertCircleOutline"
                                      Width="14"
                                      Height="14"
                                      VerticalAlignment="Center"
                                      IsVisible="{Binding HasErrors}"
                                      Foreground="{DynamicResource StudioErrorBrush}" />
          <materialIcons:MaterialIcon Kind="AlertOutline"
                                      Width="14"
                                      Height="14"
                                      VerticalAlignment="Center"
                                      IsVisible="{Binding HasOnlyWarnings}"
                                      Foreground="{DynamicResource StudioWarningBrush}" />
          <TextBlock Grid.Column="2"
                     Text="{Binding ValidationSummary}"
                     VerticalAlignment="Center"
                     FontSize="9"
                     Foreground="{DynamicResource StudioTextMutedBrush}"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding ValidationSummary}" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
