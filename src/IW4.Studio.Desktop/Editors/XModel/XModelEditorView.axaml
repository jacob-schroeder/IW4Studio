<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:xmodel="using:IW4.Studio.Desktop.Editors.XModel"
             xmlns:viewModels="using:IW4.Studio.Desktop.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="IW4.Studio.Desktop.Editors.XModel.XModelEditorView"
             x:DataType="viewModels:XModelEditorViewModel"
             mc:Ignorable="d"
             d:DesignWidth="1120"
             d:DesignHeight="720">
  <Grid RowDefinitions="Auto,10,*">
    <Border Padding="12,9"
            CornerRadius="7"
            Background="{DynamicResource StudioSurfaceBrush}"
            BorderBrush="{DynamicResource StudioBorderBrush}"
            BorderThickness="1">
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="14">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding Name}"
                     FontSize="16"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource StudioTextBrush}" />
          <TextBlock Text="{Binding StatusMessage}"
                     FontSize="9"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource StudioTextMutedBrush}" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Spacing="7">
          <TextBlock Text="LOD"
                     VerticalAlignment="Center"
                     FontSize="9"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource StudioTextSubtleBrush}" />
          <ComboBox Width="164"
                    MinHeight="30"
                    Padding="8,3"
                    ItemsSource="{Binding Lods}"
                    SelectedItem="{Binding SelectedLod, Mode=TwoWay}" />
          <Button Classes="ghost"
                  MinHeight="30"
                  Padding="9,4"
                  ToolTip.Tip="Reset the orbit camera and fit the selected LOD"
                  Click="FitButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <materialIcons:MaterialIcon Kind="FitToPageOutline" Width="15" Height="15" />
              <TextBlock Text="Fit" />
            </StackPanel>
          </Button>
          <CheckBox Content="Wireframe"
                    VerticalAlignment="Center"
                    IsChecked="{Binding IsWireframeEnabled, Mode=TwoWay}" />
          <Button Classes="ghost"
                  MinHeight="30"
                  Padding="7,4"
                  IsEnabled="{Binding CanRevert}"
                  ToolTip.Tip="Revert the editable XModel draft"
                  AutomationProperties.Name="Revert XModel draft"
                  Click="RevertButton_Click">
            <materialIcons:MaterialIcon Kind="Undo" Width="15" Height="15" />
          </Button>
          <Button Classes="primary"
                  MinHeight="30"
                  Padding="12,5"
                  IsEnabled="{Binding CanApply}"
                  ToolTip.Tip="XModel authoring is not available in checkpoint 1">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <materialIcons:MaterialIcon Kind="Check" Width="15" Height="15" />
              <TextBlock Text="Apply" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            CornerRadius="8"
            ClipToBounds="True"
            Background="{DynamicResource StudioSurfaceSunkenBrush}"
            BorderBrush="{DynamicResource StudioBorderBrush}"
            BorderThickness="1">
      <Grid>
        <xmodel:XModelPreviewControl x:Name="Preview"
                                         Scene="{Binding Scene}"
                                         SelectedLodIndex="{Binding SelectedLodIndex}"
                                         ShowWireframe="{Binding IsWireframeEnabled}" />

        <Border HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="12"
                Padding="8,4"
                CornerRadius="4"
                IsHitTestVisible="False"
                Background="#C816191F"
                BorderBrush="#506D7683"
                BorderThickness="1">
          <TextBlock Text="CHECKPOINT 1 · MATERIAL-SLOT SHADING · TEXTURES NOT APPLIED"
                     FontSize="8"
                     FontWeight="Bold"
                     LetterSpacing="0.7"
                     Foreground="#CDD5DF" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
