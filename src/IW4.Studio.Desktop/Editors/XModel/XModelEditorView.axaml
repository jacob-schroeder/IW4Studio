<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:xmodel="using:IW4.Studio.Desktop.Editors.XModel"
             xmlns:viewModels="using:IW4.Studio.Desktop.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="IW4.Studio.Desktop.Editors.XModel.XModelEditorView"
             x:DataType="viewModels:XModelEditorViewModel"
             MinHeight="620"
             mc:Ignorable="d"
             d:DesignWidth="1120"
             d:DesignHeight="720">
  <UserControl.Styles>
    <Style Selector="ListBox.lodRail">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.lodRail > ListBoxItem">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Margin" Value="0,0,0,5" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,8,Auto,10,*,10,Auto">
    <Border Padding="12,9"
            CornerRadius="7"
            Background="{DynamicResource StudioSurfaceBrush}"
            BorderBrush="{DynamicResource StudioBorderBrush}"
            BorderThickness="1">
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="14">
        <TextBlock Text="{Binding Name}"
                   VerticalAlignment="Center"
                   FontSize="16"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource StudioTextBrush}" />

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Spacing="7">
          <Button Classes="ghost"
                  MinHeight="30"
                  Padding="10,4"
                  IsEnabled="{Binding CanRevert}"
                  ToolTip.Tip="Revert the editable XModel draft"
                  AutomationProperties.Name="Revert XModel draft"
                  Click="RevertButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <materialIcons:MaterialIcon Kind="Undo" Width="15" Height="15" />
              <TextBlock Text="Revert" />
            </StackPanel>
          </Button>
          <Button Classes="primary"
                  MinHeight="30"
                  Padding="12,5"
                  IsEnabled="{Binding CanApply}"
                  ToolTip.Tip="Apply the compiled XSurface candidate and generated providers"
                  Click="ApplyButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <materialIcons:MaterialIcon Kind="Check" Width="15" Height="15" />
              <TextBlock Text="Apply" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Padding="12,8"
            CornerRadius="7"
            Background="{DynamicResource StudioSurfaceBrush}"
            BorderBrush="{DynamicResource StudioBorderBrush}"
            BorderThickness="1">
        <Grid ColumnDefinitions="Auto,164,Auto,*,Auto,Auto,Auto,Auto"
            ColumnSpacing="9">
        <TextBlock Text="LOD"
                   VerticalAlignment="Center"
                   FontSize="9"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource StudioTextSubtleBrush}" />
        <ComboBox Grid.Column="1"
                  MinHeight="30"
                  Padding="8,3"
                  ItemsSource="{Binding ActiveAssemblyLods}"
                  SelectedItem="{Binding SelectedAssemblyLod, Mode=TwoWay}" />
        <Button Grid.Column="2"
                Classes="ghost"
                MinHeight="30"
                Padding="9,4"
                ToolTip.Tip="Reset orbit, pan, and zoom to fit the selected LOD"
                Click="FitButton_Click">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <materialIcons:MaterialIcon Kind="FitToPageOutline" Width="15" Height="15" />
            <TextBlock Text="Fit" />
          </StackPanel>
        </Button>
        <CheckBox Grid.Column="4"
                  Content="Studio light"
                  VerticalAlignment="Center"
                  ToolTip.Tip="Toggle the preview-only studio reflection environment; authored material passes remain unchanged"
                  IsChecked="{Binding IsStudioEnvironmentEnabled, Mode=TwoWay}" />
        <CheckBox Grid.Column="5"
                  Content="Wireframe"
                  VerticalAlignment="Center"
                  IsChecked="{Binding IsWireframeEnabled, Mode=TwoWay}" />
        <CheckBox Grid.Column="6"
                  Content="Collision"
                  VerticalAlignment="Center"
                  IsEnabled="{Binding CanShowCollision}"
                  IsChecked="{Binding IsCollisionEnabled, Mode=TwoWay}" />
        <CheckBox Grid.Column="7"
                  Content="Bone tags"
                  VerticalAlignment="Center"
                  IsChecked="{Binding ShowBoneTags, Mode=TwoWay}" />
      </Grid>
    </Border>

    <Border Grid.Row="4"
            MinHeight="400"
            CornerRadius="8"
            ClipToBounds="True"
            Background="{DynamicResource StudioSurfaceSunkenBrush}"
            BorderBrush="{DynamicResource StudioBorderBrush}"
            BorderThickness="1">
      <Grid>
        <xmodel:XModelPreviewControl x:Name="Preview"
                                    Scene="{Binding Scene}"
                                    SelectedLodIndex="{Binding SelectedLodIndex}"
                                    UseStudioEnvironment="{Binding IsStudioEnvironmentEnabled}"
                                    ShowWireframe="{Binding IsWireframeEnabled}"
                                    ShowCollision="{Binding IsCollisionEnabled}"
                                    ShowBoneTags="{Binding ShowBoneTags}" />

        <Border x:Name="PreviewInputSurface"
                Background="Transparent"
                ToolTip.Tip="Left-drag to orbit; right- or middle-drag to pan; scroll to zoom" />

        <xmodel:XModelBoneTagOverlay x:Name="BoneTagOverlay"
                                    IsHitTestVisible="False"
                                    ClipToBounds="True" />

        <Border HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="12"
                Padding="8,4"
                CornerRadius="4"
                IsHitTestVisible="False"
                Background="#C816191F"
                BorderBrush="#506D7683"
                BorderThickness="1">
          <TextBlock Text="{Binding MaterialExecutionBadge}"
                     FontSize="8"
                     FontWeight="Bold"
                     LetterSpacing="0.7"
                     Foreground="#CDD5DF" />
        </Border>

        <Border Background="Transparent"
                IsHitTestVisible="False"
                IsVisible="{Binding IsImportedLodSelected}"
                BorderBrush="#80FF8B8B"
                BorderThickness="1" />

        <Border HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="12"
                Padding="8,4"
                CornerRadius="4"
                IsHitTestVisible="False"
                Background="#C816191F"
                BorderBrush="#506D7683"
                BorderThickness="1">
          <TextBlock Text="LEFT DRAG · ORBIT   RIGHT/MIDDLE DRAG · PAN   SCROLL · ZOOM"
                     FontSize="8"
                     FontWeight="SemiBold"
                     LetterSpacing="0.4"
                     Foreground="#CDD5DF" />
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="6"
            MinHeight="82"
            Padding="12,9"
            CornerRadius="7"
            Background="{DynamicResource StudioSurfaceBrush}"
            BorderBrush="{DynamicResource StudioBorderBrush}"
            BorderThickness="1">
      <Grid ColumnDefinitions="210,1,*">
        <Grid RowDefinitions="Auto,8,*">
          <TextBlock Text="LODS"
                     FontSize="9"
                     FontWeight="Bold"
                     LetterSpacing="0.8"
                     Foreground="{DynamicResource StudioTextSubtleBrush}" />
          <ListBox Grid.Row="2"
                   Classes="lodRail"
                   ItemsSource="{Binding AssemblyLods}"
                   SelectedItem="{Binding SelectedAssemblyLod, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DisplayName}"
                           FontSize="10"
                           TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>

        <Border Grid.Column="1"
                Margin="12,0"
                Background="{DynamicResource StudioBorderBrush}" />

        <Grid Grid.Column="2"
              RowDefinitions="Auto,10,Auto,8,Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="LOD assembly"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource StudioTextBrush}" />
            <TextBlock Text="{Binding ImportedLodNotice}"
                       IsVisible="{Binding IsImportedLodSelected}"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="#FFE1A4A4" />
            <TextBlock Text="{Binding SelectedLodExportSummary}"
                       FontSize="11"
                       Foreground="{DynamicResource StudioTextSubtleBrush}" />
          </StackPanel>

          <WrapPanel Grid.Row="2"
                     Orientation="Horizontal">
            <Button Classes="ghost"
                    Margin="0,0,8,0"
                    IsEnabled="{Binding CanAddAssemblyLod}"
                    Click="AddLodButton_Click">
              <TextBlock Text="Add LOD" />
            </Button>
            <Button Classes="ghost"
                    Margin="0,0,8,0"
                    IsEnabled="{Binding CanReplaceAssemblyLod}"
                    Click="ReplaceLodButton_Click">
              <TextBlock Text="Replace LOD" />
            </Button>
            <Button Classes="ghost"
                    Margin="0,0,8,0"
                    IsEnabled="{Binding CanReplaceAssemblyLod}"
                    Click="ReplaceModelButton_Click">
              <TextBlock Text="Replace Model" />
            </Button>
            <Button Classes="ghost"
                    Margin="0,0,8,0"
                    IsEnabled="{Binding CanRemoveAssemblyLod}"
                    Click="RemoveLodButton_Click">
              <TextBlock Text="Remove" />
            </Button>
            <Button Classes="primary"
                    MinHeight="30"
                    Padding="12,5"
                    IsEnabled="{Binding CanExportXModel}"
                    ToolTip.Tip="Export the selected loaded LOD"
                    AutomationProperties.Name="Export selected XModel LOD">
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="XModel v6"
                            ToolTip.Tip="Export as XMODEL_EXPORT version 6"
                            Click="ExportXModelMenuItem_Click" />
                  <MenuItem Header="GLB"
                            ToolTip.Tip="Export as portable binary glTF"
                            Click="ExportGlbMenuItem_Click" />
                </MenuFlyout>
              </Button.Flyout>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <materialIcons:MaterialIcon Kind="Export" Width="15" Height="15" />
                <TextBlock Text="Export" />
                <materialIcons:MaterialIcon Kind="ChevronDown" Width="14" Height="14" />
              </StackPanel>
            </Button>
          </WrapPanel>

          <StackPanel Grid.Row="4"
                      IsVisible="{Binding IsImportedLodSelected}"
                      Spacing="4">
            <TextBlock Text="Import GLB materials"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource StudioTextSubtleBrush}" />
            <ItemsControl ItemsSource="{Binding ImportedMaterialMappings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="22,180,*"
                        RowDefinitions="Auto,Auto"
                        ColumnSpacing="8"
                        RowSpacing="2"
                        Margin="0,2">
                    <Border Width="18"
                            Height="18"
                            CornerRadius="3"
                            Background="{Binding PreviewColor}"
                            BorderBrush="#506D7683"
                            BorderThickness="1" />
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Text="{Binding MaterialName}"
                                 FontSize="10"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="{Binding ImportStatus}"
                                 FontSize="9"
                                 Foreground="{DynamicResource StudioTextSubtleBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="1">
                      <TextBlock Text="{Binding TargetMaterialName}"
                                 FontSize="10"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="New owned IW4 Material"
                                 FontSize="9"
                                 Foreground="{DynamicResource StudioTextSubtleBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Grid.ColumnSpan="2"
                               Text="{Binding WarningsText}"
                               IsVisible="{Binding HasWarnings}"
                               TextWrapping="Wrap"
                               FontSize="9"
                               Foreground="#FFE1A4A4" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
