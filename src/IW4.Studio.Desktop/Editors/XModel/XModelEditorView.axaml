<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:xmodel="using:IW4.Studio.Desktop.Editors.XModel"
             xmlns:viewModels="using:IW4.Studio.Desktop.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="IW4.Studio.Desktop.Editors.XModel.XModelEditorView"
             x:DataType="viewModels:XModelEditorViewModel"
             mc:Ignorable="d"
             d:DesignWidth="1120"
             d:DesignHeight="720">
  <Grid RowDefinitions="Auto,8,Auto,10,*,10,Auto">
    <Border Padding="12,9"
            CornerRadius="7"
            Background="{DynamicResource StudioSurfaceBrush}"
            BorderBrush="{DynamicResource StudioBorderBrush}"
            BorderThickness="1">
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="14">
        <TextBlock Text="{Binding Name}"
                   VerticalAlignment="Center"
                   FontSize="16"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource StudioTextBrush}" />

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Spacing="7">
          <Button Classes="ghost"
                  MinHeight="30"
                  Padding="10,4"
                  IsEnabled="{Binding CanRevert}"
                  ToolTip.Tip="Revert the editable XModel draft"
                  AutomationProperties.Name="Revert XModel draft"
                  Click="RevertButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <materialIcons:MaterialIcon Kind="Undo" Width="15" Height="15" />
              <TextBlock Text="Revert" />
            </StackPanel>
          </Button>
          <Button Classes="primary"
                  MinHeight="30"
                  Padding="12,5"
                  IsEnabled="{Binding CanApply}"
                  ToolTip.Tip="Apply the compiled XSurface candidate and generated providers"
                  Click="ApplyButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <materialIcons:MaterialIcon Kind="Check" Width="15" Height="15" />
              <TextBlock Text="Apply" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Padding="12,8"
            CornerRadius="7"
            Background="{DynamicResource StudioSurfaceBrush}"
            BorderBrush="{DynamicResource StudioBorderBrush}"
            BorderThickness="1">
        <Grid ColumnDefinitions="Auto,164,Auto,*,Auto,Auto,Auto,Auto"
            ColumnSpacing="9">
        <TextBlock Text="LOD"
                   VerticalAlignment="Center"
                   FontSize="9"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource StudioTextSubtleBrush}" />
        <ComboBox Grid.Column="1"
                  MinHeight="30"
                  Padding="8,3"
                  ItemsSource="{Binding ActiveAssemblyLods}"
                  SelectedItem="{Binding SelectedAssemblyLod, Mode=TwoWay}" />
        <Button Grid.Column="2"
                Classes="ghost"
                MinHeight="30"
                Padding="9,4"
                ToolTip.Tip="Reset orbit, pan, and zoom to fit the selected LOD"
                Click="FitButton_Click">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <materialIcons:MaterialIcon Kind="FitToPageOutline" Width="15" Height="15" />
            <TextBlock Text="Fit" />
          </StackPanel>
        </Button>
        <CheckBox Grid.Column="4"
                  Content="Studio light"
                  VerticalAlignment="Center"
                  ToolTip.Tip="Toggle the preview-only studio reflection environment; authored material passes remain unchanged"
                  IsChecked="{Binding IsStudioEnvironmentEnabled, Mode=TwoWay}" />
        <CheckBox Grid.Column="5"
                  Content="Wireframe"
                  VerticalAlignment="Center"
                  IsChecked="{Binding IsWireframeEnabled, Mode=TwoWay}" />
        <CheckBox Grid.Column="6"
                  Content="Collision"
                  VerticalAlignment="Center"
                  IsEnabled="{Binding CanShowCollision}"
                  IsChecked="{Binding IsCollisionEnabled, Mode=TwoWay}" />
        <CheckBox Grid.Column="7"
                  Content="Bone tags"
                  VerticalAlignment="Center"
                  IsChecked="{Binding ShowBoneTags, Mode=TwoWay}" />
      </Grid>
    </Border>

    <Border Grid.Row="4"
            CornerRadius="8"
            ClipToBounds="True"
            Background="{DynamicResource StudioSurfaceSunkenBrush}"
            BorderBrush="{DynamicResource StudioBorderBrush}"
            BorderThickness="1">
      <Grid>
        <xmodel:XModelPreviewControl x:Name="Preview"
                                    Scene="{Binding Scene}"
                                    SelectedLodIndex="{Binding SelectedLodIndex}"
                                    UseStudioEnvironment="{Binding IsStudioEnvironmentEnabled}"
                                    ShowWireframe="{Binding IsWireframeEnabled}"
                                    ShowCollision="{Binding IsCollisionEnabled}"
                                    ShowBoneTags="{Binding ShowBoneTags}" />

        <Border x:Name="PreviewInputSurface"
                Background="Transparent"
                ToolTip.Tip="Left-drag to orbit; right- or middle-drag to pan; scroll to zoom" />

        <xmodel:XModelBoneTagOverlay x:Name="BoneTagOverlay"
                                    IsHitTestVisible="False"
                                    ClipToBounds="True" />

        <Border HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="12"
                Padding="8,4"
                CornerRadius="4"
                IsHitTestVisible="False"
                Background="#C816191F"
                BorderBrush="#506D7683"
                BorderThickness="1">
          <TextBlock Text="{Binding MaterialExecutionBadge}"
                     FontSize="8"
                     FontWeight="Bold"
                     LetterSpacing="0.7"
                     Foreground="#CDD5DF" />
        </Border>

        <Border Background="#E6191D23"
                IsHitTestVisible="False"
                IsVisible="{Binding IsImportedLodSelected}"
                BorderBrush="#80FF8B8B"
                BorderThickness="1">
          <TextBlock Text="{Binding ImportedLodNotice}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     TextAlignment="Center"
                     FontSize="11"
                     FontWeight="Bold"
                     Foreground="#FFE1A4A4" />
        </Border>

        <Border HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="12"
                Padding="8,4"
                CornerRadius="4"
                IsHitTestVisible="False"
                Background="#C816191F"
                BorderBrush="#506D7683"
                BorderThickness="1">
          <TextBlock Text="LEFT DRAG · ORBIT   RIGHT/MIDDLE DRAG · PAN   SCROLL · ZOOM"
                     FontSize="8"
                     FontWeight="SemiBold"
                     LetterSpacing="0.4"
                     Foreground="#CDD5DF" />
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="6"
            MinHeight="82"
            Padding="12,9"
            CornerRadius="7"
            Background="{DynamicResource StudioSurfaceBrush}"
            BorderBrush="{DynamicResource StudioBorderBrush}"
            BorderThickness="1">
      <Grid RowDefinitions="Auto,8,Auto,6,Auto">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto"
            ColumnSpacing="14">
        <StackPanel Spacing="2"
                    VerticalAlignment="Center">
          <TextBlock Text="LOD assembly · XMODEL_EXPORT"
                     FontSize="10"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource StudioTextBrush}" />
          <TextBlock Text="{Binding SelectedLodExportSummary}"
                     FontSize="11"
                     Foreground="{DynamicResource StudioTextSubtleBrush}" />
        </StackPanel>
        <Button Grid.Column="1"
                Classes="ghost"
                IsEnabled="{Binding CanAddAssemblyLod}"
                Click="AddLodButton_Click">
          <TextBlock Text="Add LOD…" />
        </Button>
        <Button Grid.Column="2"
                Classes="ghost"
                IsEnabled="{Binding CanReplaceAssemblyLod}"
                Click="ReplaceLodButton_Click">
          <TextBlock Text="Replace…" />
        </Button>
        <Button Grid.Column="3"
                Classes="ghost"
                IsEnabled="{Binding CanRemoveAssemblyLod}"
                Click="RemoveLodButton_Click">
          <TextBlock Text="Remove" />
        </Button>
        <Button Grid.Column="4"
                Classes="primary"
                MinHeight="30"
                Padding="12,5"
                IsEnabled="{Binding CanExportXModel}"
                ToolTip.Tip="Export the selected loaded LOD as a portable binary glTF model"
                AutomationProperties.Name="Export selected XModel LOD as GLB"
                Click="ExportGlbButton_Click">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <materialIcons:MaterialIcon Kind="Export" Width="15" Height="15" />
            <TextBlock Text="Export GLB…" />
          </StackPanel>
        </Button>
        <Button Grid.Column="5"
                Classes="ghost"
                MinHeight="30"
                Padding="12,5"
                IsEnabled="{Binding CanExportXModel}"
                ToolTip.Tip="Validate and export the selected loaded LOD as XMODEL_EXPORT version 6"
                AutomationProperties.Name="Export selected XModel LOD as XMODEL_EXPORT"
                Click="ExportXModelButton_Click">
          <TextBlock Text="Export XMODEL_EXPORT…" />
        </Button>
      </Grid>
      <ListBox Grid.Row="2"
               Height="28"
               Background="Transparent"
               BorderThickness="0"
               ItemsSource="{Binding AssemblyLods}"
               SelectedItem="{Binding SelectedAssemblyLod, Mode=TwoWay}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="6" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding DisplayName}" FontSize="10" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <ItemsControl Grid.Row="4"
                    IsVisible="{Binding IsImportedLodSelected}"
                    ItemsSource="{Binding ImportedMaterialMappings}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="*,220" ColumnSpacing="8" Margin="0,2">
              <TextBlock Text="{Binding MaterialName}"
                         VerticalAlignment="Center"
                         FontSize="10" />
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding $parent[UserControl].DataContext.MaterialSlotOptions}"
                        SelectedItem="{Binding SelectedSourceSlot, Mode=TwoWay}"
                        MinHeight="26" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </Grid>
    </Border>
  </Grid>
</UserControl>
