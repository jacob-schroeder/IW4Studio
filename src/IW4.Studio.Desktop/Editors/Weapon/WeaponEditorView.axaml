<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IW4.Studio.Desktop.ViewModels"
             xmlns:xmodel="using:IW4.Studio.Desktop.Editors.XModel"
             x:Class="IW4.Studio.Desktop.Editors.Weapon.WeaponEditorView"
             x:DataType="vm:WeaponEditorViewModel">
  <Grid RowDefinitions="Auto,8,*">
    <Border Padding="12,9" CornerRadius="7"
            Background="{DynamicResource StudioSurfaceBrush}"
            BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="1">
      <Grid ColumnDefinitions="Auto,12,*,Auto" ColumnSpacing="8">
        <TextBlock Text="WEAPON" VerticalAlignment="Center" FontSize="9" FontWeight="Bold"
                   Foreground="{DynamicResource StudioTextSubtleBrush}" />
        <StackPanel Grid.Column="2" Spacing="2">
          <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding AccessText}" FontSize="9" Foreground="{DynamicResource StudioTextSubtleBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="7">
          <Button Classes="ghost" MinHeight="30" Padding="10,4"
                  IsEnabled="{Binding CanRevert}" ToolTip.Tip="Revert the editable Weapon draft"
                  AutomationProperties.Name="Revert Weapon draft" Click="RevertButton_Click">Revert</Button>
          <Button Classes="primary" MinHeight="30" Padding="12,5"
                  IsEnabled="{Binding CanApply}" ToolTip.Tip="Validate and apply the complete Weapon draft"
                  AutomationProperties.Name="Apply Weapon draft" Click="ApplyButton_Click">Apply</Button>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="2"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  VerticalContentAlignment="Stretch">
      <Grid MinHeight="560" RowDefinitions="Auto,10,*,10,Auto">
        <Border Padding="12,8" CornerRadius="7"
                Background="{DynamicResource StudioSurfaceBrush}"
                BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="1">
          <Grid ColumnDefinitions="Auto,260,Auto,150,Auto,Auto,Auto,Auto" ColumnSpacing="9">
            <TextBlock Text="STATIC MODEL" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold"
                       Foreground="{DynamicResource StudioTextSubtleBrush}" />
            <ComboBox Grid.Column="1" MinHeight="30" ItemsSource="{Binding ModelSlots}"
                      SelectedItem="{Binding SelectedModelSlot, Mode=TwoWay}"
                      AutomationProperties.Name="Weapon model selector" ToolTip.Tip="Inspect one selected static Weapon XModel reference; this is not an assembled or animated preview" />
            <TextBlock Grid.Column="2" Text="LOD" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold"
                       Foreground="{DynamicResource StudioTextSubtleBrush}" />
            <ComboBox Grid.Column="3" MinHeight="30" ItemsSource="{Binding Lods}"
                      SelectedItem="{Binding SelectedLod, Mode=TwoWay}"
                      AutomationProperties.Name="Weapon preview LOD selector" />
            <Button Grid.Column="4" Classes="ghost" MinHeight="30" Padding="9,4"
                    ToolTip.Tip="Reset orbit, pan, and zoom to fit the selected model"
                    AutomationProperties.Name="Fit Weapon model preview" Click="FitButton_Click">Fit</Button>
            <CheckBox Grid.Column="5" Content="Light" IsChecked="{Binding IsStudioEnvironmentEnabled, Mode=TwoWay}" />
            <CheckBox Grid.Column="6" Content="Wire" IsChecked="{Binding IsWireframeEnabled, Mode=TwoWay}" />
            <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="8">
              <CheckBox Content="Collision" IsEnabled="{Binding CanShowCollision}" IsChecked="{Binding IsCollisionEnabled, Mode=TwoWay}" />
              <CheckBox Content="Tags" IsChecked="{Binding ShowBoneTags, Mode=TwoWay}" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Row="2" MinHeight="320" CornerRadius="8" ClipToBounds="True"
                Background="{DynamicResource StudioSurfaceSunkenBrush}"
                BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="1">
          <Grid>
            <xmodel:XModelPreviewControl x:Name="Preview" Scene="{Binding Scene}"
                                        SelectedLodIndex="{Binding SelectedLodIndex}"
                                        UseStudioEnvironment="{Binding IsStudioEnvironmentEnabled}"
                                        ShowWireframe="{Binding IsWireframeEnabled}"
                                        ShowCollision="{Binding IsCollisionEnabled}"
                                        ShowBoneTags="{Binding ShowBoneTags}" />
            <Border x:Name="PreviewInputSurface" Background="Transparent"
                    AutomationProperties.Name="Weapon viewport input surface"
                    ToolTip.Tip="Left-drag to orbit; right- or middle-drag to pan; scroll to zoom" />
            <xmodel:XModelBoneTagOverlay x:Name="BoneTagOverlay" IsHitTestVisible="False" ClipToBounds="True" />
            <Border BorderBrush="{DynamicResource StudioWarningBrush}" BorderThickness="1"
                    CornerRadius="7" IsVisible="{Binding HasPreviewDiagnostics}" IsHitTestVisible="False" />
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="18,12" CornerRadius="6"
                    Background="#D816191F" BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="1"
                    IsVisible="{Binding HasPreviewMessage}" IsHitTestVisible="False">
              <StackPanel Spacing="4">
                <TextBlock Text="STATIC SELECTED-MODEL PREVIEW" HorizontalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Text="{Binding PreviewMessage}" HorizontalAlignment="Center" FontSize="10"
                           MaxWidth="520" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource StudioTextSubtleBrush}" />
              </StackPanel>
            </Border>
            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Padding="8,4"
                    CornerRadius="4" Background="#C816191F" IsHitTestVisible="False">
              <TextBlock Text="{Binding PreviewStatus}" FontSize="8" MaxWidth="420"
                         TextTrimming="CharacterEllipsis" Foreground="#CDD5DF" />
            </Border>
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Padding="8,4"
                    CornerRadius="4" Background="#C816191F" IsHitTestVisible="False">
              <TextBlock Text="LEFT DRAG · ORBIT   RIGHT/MIDDLE DRAG · PAN   SCROLL · ZOOM"
                         FontSize="8" Foreground="#CDD5DF" />
            </Border>
          </Grid>
        </Border>

        <Border Grid.Row="4" Padding="12,9" CornerRadius="7"
                Background="{DynamicResource StudioSurfaceBrush}"
                BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="1">
          <Grid ColumnDefinitions="220,16,260,16,*">
            <Grid RowDefinitions="Auto,5,*">
              <TextBlock Text="PROPERTY CATEGORY" FontSize="8" FontWeight="Bold"
                         Foreground="{DynamicResource StudioTextSubtleBrush}" />
              <ListBox Grid.Row="2" ItemsSource="{Binding Categories}"
                       SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       AutomationProperties.Name="Weapon property categories">
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" /></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </Grid>
            <Grid Grid.Column="2" RowDefinitions="Auto,5,*">
              <TextBlock Text="INDEXED ROW / MODEL SLOT" FontSize="8" FontWeight="Bold"
                         Foreground="{DynamicResource StudioTextSubtleBrush}" />
              <ListBox Grid.Row="2" ItemsSource="{Binding IndexedRows}"
                       SelectedItem="{Binding SelectedIndexedRow, Mode=TwoWay}"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       IsVisible="{Binding HasIndexedRows}" AutomationProperties.Name="Weapon indexed property rows">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding Detail}" FontSize="9"
                                 Foreground="{DynamicResource StudioTextSubtleBrush}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Grid.Row="2" Text="This category has scalar fields; edit them in Properties."
                         IsVisible="{Binding !HasIndexedRows}" TextWrapping="Wrap" FontSize="10"
                         Foreground="{DynamicResource StudioTextSubtleBrush}" />
            </Grid>
            <StackPanel Grid.Column="4" Spacing="6">
              <TextBlock Text="SELECTION SUMMARY" FontSize="8" FontWeight="Bold"
                         Foreground="{DynamicResource StudioTextSubtleBrush}" />
              <TextBlock Text="{Binding SelectedCategory.Title}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SelectedIndexedRow.Title}" FontSize="10" />
              <TextBlock Text="{Binding CandidateState}" FontSize="10" />
              <TextBlock Text="{Binding PreviewStatus}" FontSize="10" TextWrapping="Wrap"
                         Foreground="{DynamicResource StudioTextSubtleBrush}" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
