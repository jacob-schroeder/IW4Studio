<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behavior="using:IW4.Studio.Desktop.Editors.Menu.Behavior"
             x:Class="IW4.Studio.Desktop.Editors.Menu.Behavior.BehaviorKeyHandlersView"
             x:DataType="behavior:BehaviorKeyHandlersViewModel"
             mc:Ignorable="d"
             d:DesignWidth="680"
             d:DesignHeight="500">
  <Grid RowDefinitions="Auto,8,Auto,8,*,10,Auto">
    <StackPanel Spacing="3">
      <TextBlock Text="KEY HANDLERS"
                 FontSize="10"
                 FontWeight="Bold"
                 LetterSpacing="0.8"
                 Foreground="{DynamicResource StudioTextSubtleBrush}" />
      <TextBlock Text="{Binding Summary}"
                 FontSize="10"
                 Foreground="{DynamicResource StudioTextMutedBrush}" />
    </StackPanel>

    <Border Grid.Row="2"
            Padding="7,5"
            CornerRadius="4"
            IsVisible="{Binding HasTruncatedImportedTail}"
            Background="{DynamicResource StudioWarningSurfaceBrush}"
            BorderBrush="{DynamicResource StudioWarningBrush}"
            BorderThickness="1">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock Text="{Binding ImportedTailText}"
                   FontSize="9"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource StudioTextBrush}" />
        <Button Grid.Column="1"
                Content="Remove tail"
                Command="{Binding DiscardImportedTailCommand}"
                ToolTip.Tip="Discard the unresolved imported tail" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="4"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Handlers}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="behavior:BehaviorKeyHandlerDraftViewModel">
            <Border Margin="0,0,0,8"
                    Padding="10"
                    CornerRadius="6"
                    Background="{DynamicResource StudioSurfaceSunkenBrush}"
                    BorderBrush="{DynamicResource StudioBorderBrush}"
                    BorderThickness="1">
              <Grid RowDefinitions="Auto,4,Auto,8,*"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="7">
                <TextBlock Text="KEY HANDLER"
                           FontSize="9"
                           FontWeight="Bold"
                           LetterSpacing="0.7"
                           Foreground="{DynamicResource StudioTextSubtleBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3">
                  <Button Width="25" Height="24" Padding="2" Command="{Binding MoveUpCommand}" ToolTip.Tip="Move key handler up"><TextBlock Text="↑" /></Button>
                  <Button Width="25" Height="24" Padding="2" Command="{Binding MoveDownCommand}" ToolTip.Tip="Move key handler down"><TextBlock Text="↓" /></Button>
                  <Button Width="25" Height="24" Padding="2" Command="{Binding RemoveCommand}" ToolTip.Tip="Delete key handler"><TextBlock Text="×" FontSize="14" /></Button>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="2">
                  <TextBox Text="{Binding KeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           PlaceholderText="Signed engine key code"
                           AutomationProperties.Name="Key handler key code" />
                  <TextBlock Text="{Binding KeyErrorText}"
                             IsVisible="{Binding HasKeyError}"
                             FontSize="8"
                             Foreground="{DynamicResource StudioErrorBrush}" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Spacing="4">
                  <TextBlock Text="ACTIONS"
                             FontSize="8"
                             FontWeight="Bold"
                             LetterSpacing="0.6"
                             Foreground="{DynamicResource StudioTextSubtleBrush}" />
                  <behavior:BehaviorEventHandlerSetView DataContext="{Binding Action}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Button Grid.Row="6"
            MinWidth="126"
            HorizontalAlignment="Left"
            Classes="primary"
            Content="Add key handler"
            Command="{Binding AddKeyHandlerCommand}"
            AutomationProperties.Name="Add key handler" />
  </Grid>
</UserControl>
