<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behavior="using:IW4.Studio.Desktop.Editors.Menu.Behavior"
        x:Class="IW4.Studio.Desktop.Editors.Menu.Behavior.MenuItemBehaviorBuilderWindow"
        x:DataType="behavior:MenuItemBehaviorBuilderSessionViewModel"
        Title="{Binding WindowTitle}"
        Width="1060"
        Height="760"
        MinWidth="860"
        MinHeight="620"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown"
        mc:Ignorable="d"
        d:DesignWidth="1060"
        d:DesignHeight="760">
  <Border Padding="22,18"
          Background="{DynamicResource StudioBackgroundBrush}">
    <Grid RowDefinitions="Auto,14,*,14,Auto">
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="12">
        <StackPanel Spacing="3">
          <TextBlock Text="{Binding Heading}"
                     FontSize="19"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource StudioTextBrush}" />
          <TextBlock Text="{Binding ScopeText}"
                     FontSize="10"
                     Foreground="{DynamicResource StudioTextMutedBrush}" />
          <TextBlock Text="{Binding Description}"
                     FontSize="10"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource StudioTextMutedBrush}" />
          <TextBlock Text="Formulas support quoted strings, numbers, parentheses, +, -, *, /, %, comparisons, &amp;&amp;, ||, !, and the observed/advanced function catalog."
                     FontSize="9"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource StudioTextSubtleBrush}" />
          <TextBlock Text="Static dvars select existing rows or append a named static-dvar row in Bindings. expressionRef(index) always selects an existing reusable definition."
                     IsVisible="{Binding HasBindings}"
                     FontSize="9"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource StudioTextSubtleBrush}" />
        </StackPanel>
        <Border Grid.Column="1"
                Padding="8,3"
                CornerRadius="4"
                VerticalAlignment="Top"
                Background="{DynamicResource StudioAccentSurfaceBrush}"
                BorderBrush="{DynamicResource StudioAccentBrush}"
                BorderThickness="1">
          <TextBlock Text="LOCAL DRAFT"
                     FontSize="8"
                     FontWeight="Bold"
                     LetterSpacing="0.7"
                     Foreground="{DynamicResource StudioAccentBrush}" />
        </Border>
      </Grid>

      <Grid Grid.Row="2"
            ColumnDefinitions="218,16,*">
        <Border Padding="9"
                CornerRadius="7"
                Background="{DynamicResource StudioSurfaceSunkenBrush}"
                BorderBrush="{DynamicResource StudioBorderBrush}"
                BorderThickness="1">
          <Grid RowDefinitions="Auto,8,*">
            <TextBlock Text="BEHAVIOR"
                       FontSize="9"
                       FontWeight="Bold"
                       LetterSpacing="0.8"
                       Foreground="{DynamicResource StudioTextSubtleBrush}" />
            <ListBox x:Name="NavigationList"
                     Grid.Row="2"
                     ItemsSource="{Binding NavigationItems}"
                     SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     AutomationProperties.Name="Behavior builder sections">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="behavior:MenuItemBehaviorBuilderNavigationItemViewModel">
                  <Grid Margin="4,5"
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="7">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Title}"
                                 FontSize="11"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource StudioTextBrush}" />
                      <TextBlock Text="{Binding Description}"
                                 FontSize="8"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource StudioTextMutedBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               MaxWidth="56"
                               VerticalAlignment="Top"
                               Text="{Binding Summary}"
                               FontSize="8"
                               TextAlignment="Right"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource StudioAccentBrush}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>

        <Border Grid.Column="2"
                Padding="15"
                CornerRadius="7"
                Background="{DynamicResource StudioControlBrush}"
                BorderBrush="{DynamicResource StudioBorderBrush}"
                BorderThickness="1">
          <Grid>
            <Grid IsVisible="{Binding IsEventsSelected}">
              <behavior:BehaviorEventHooksView DataContext="{Binding Events}" />
            </Grid>
            <Grid IsVisible="{Binding IsKeysSelected}">
              <behavior:BehaviorKeyHandlersView DataContext="{Binding Keys}" />
            </Grid>
            <Grid IsVisible="{Binding IsBindingsSelected}">
              <behavior:BehaviorBindingsView DataContext="{Binding Bindings}" />
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <Grid Grid.Row="4"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="12">
        <StackPanel Spacing="6"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusMessage}"
                     FontSize="9"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource StudioTextMutedBrush}"
                     AutomationProperties.Name="Behavior builder status" />
          <Border Padding="8,6"
                  CornerRadius="4"
                  IsVisible="{Binding HasValidationError}"
                  Background="{DynamicResource StudioErrorSurfaceBrush}"
                  BorderBrush="{DynamicResource StudioErrorBrush}"
                  BorderThickness="1">
            <TextBlock Text="{Binding ValidationMessage}"
                       FontSize="9"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource StudioErrorBrush}" />
          </Border>
          <Border Padding="8,6"
                  CornerRadius="4"
                  IsVisible="{Binding IsDiscardConfirmationVisible}"
                  Background="{DynamicResource StudioWarningSurfaceBrush}"
                  BorderBrush="{DynamicResource StudioWarningBrush}"
                  BorderThickness="1">
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
              <TextBlock Text="Discard local behavior changes?"
                         VerticalAlignment="Center"
                         FontSize="9"
                         Foreground="{DynamicResource StudioTextBrush}" />
              <Button MinWidth="82"
                      Height="27"
                      Padding="7,2"
                      Content="Keep editing"
                      Click="KeepEditingButton_Click" />
              <Button MinWidth="66"
                      Height="27"
                      Padding="7,2"
                      Content="Discard"
                      Click="DiscardButton_Click" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="8">
          <Button MinWidth="88"
                  Content="Cancel"
                  Click="CancelButton_Click"
                  AutomationProperties.Name="Cancel behavior editing" />
          <Button Classes="primary"
                  MinWidth="132"
                  Content="Apply behavior"
                  IsDefault="True"
                  IsEnabled="{Binding CanApply}"
                  Click="ApplyButton_Click"
                  ToolTip.Tip="Apply the local behavior draft"
                  AutomationProperties.Name="Apply behavior changes" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
