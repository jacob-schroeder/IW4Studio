<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:menu="using:IW4.Studio.Desktop.Editors.Menu"
             xmlns:menuVm="using:IW4.Studio.Desktop.ViewModels.Menu"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="IW4.Studio.Desktop.Editors.Menu.MenuEditorView"
             x:DataType="menuVm:MenuEditorViewModel"
             mc:Ignorable="d"
             d:DesignWidth="1120"
             d:DesignHeight="720">
  <Grid RowDefinitions="Auto,10,*">
    <Border Padding="12,9"
            CornerRadius="7"
            Background="{DynamicResource StudioSurfaceBrush}"
            BorderBrush="{DynamicResource StudioBorderBrush}"
            BorderThickness="1">
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="12">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding Name}"
                     FontSize="16"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource StudioTextBrush}" />
          <TextBlock Text="{Binding StatusMessage}"
                     FontSize="9"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource StudioTextMutedBrush}" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Spacing="7">
          <Button Classes="ghost"
                  MinHeight="30"
                  Padding="7,4"
                  Command="{Binding RevertCommand}"
                  ToolTip.Tip="Revert this top-level Menu row">
            <materialIcons:MaterialIcon Kind="Undo" Width="15" Height="15" />
          </Button>
          <Button Classes="primary"
                  MinHeight="30"
                  Padding="12,5"
                  IsEnabled="{Binding Designer.HasStagedInput}"
                  ToolTip.Tip="Apply the staged Properties value to the Menu draft; use Save As to write the fastfile"
                  Click="ApplyChangesButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <materialIcons:MaterialIcon Kind="Check" Width="15" Height="15" />
              <TextBlock Text="Apply" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <menu:MenuDesignerView Grid.Row="2"
                           DataContext="{Binding Designer}" />
  </Grid>
</UserControl>
