<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:viewModels="using:IW4.Studio.Desktop.ViewModels"
             x:Class="IW4.Studio.Desktop.Editors.StringTable.StringTableEditorView"
             x:DataType="viewModels:StringTableEditorViewModel"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="640">
  <Grid RowDefinitions="Auto,10,*">
    <Border Grid.Row="0"
            Padding="14,10"
            CornerRadius="8"
            Background="{DynamicResource StudioSurfaceBrush}"
            BorderBrush="{DynamicResource StudioBorderBrush}"
            BorderThickness="1">
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="16">
        <StackPanel Spacing="3">
          <TextBlock Text="{Binding OriginalName}"
                     FontSize="17"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource StudioTextBrush}"
                     TextTrimming="CharacterEllipsis" />
          <StackPanel Orientation="Horizontal"
                      Spacing="8">
            <TextBlock Text="{Binding DimensionText}"
                       FontSize="10"
                       Foreground="{DynamicResource StudioTextMutedBrush}" />
            <TextBlock Text="·"
                       FontSize="10"
                       Foreground="{DynamicResource StudioTextSubtleBrush}" />
            <TextBlock Text="{Binding StatusMessage}"
                       MaxWidth="540"
                       TextTrimming="CharacterEllipsis"
                       FontSize="10"
                       Foreground="{DynamicResource StudioTextSubtleBrush}"
                       ToolTip.Tip="{Binding StatusMessage}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Spacing="7">
          <Border Padding="8,4"
                  CornerRadius="4"
                  Background="{DynamicResource StudioSurfaceSunkenBrush}"
                  BorderBrush="{DynamicResource StudioBorderBrush}"
                  BorderThickness="1">
            <TextBlock Text="{Binding ModeText}"
                       FontSize="9"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource StudioTextMutedBrush}" />
          </Border>
          <Button Classes="ghost"
                  MinHeight="31"
                  Padding="8,5"
                  IsEnabled="{Binding CanRevert}"
                  ToolTip.Tip="Revert changes"
                  AutomationProperties.Name="Revert changes"
                  Click="RevertDraftButton_Click">
            <materialIcons:MaterialIcon Kind="Undo" Width="16" Height="16" />
          </Button>
          <Button Classes="primary"
                  MinHeight="31"
                  Padding="12,5"
                  IsEnabled="{Binding CanApply}"
                  ToolTip.Tip="Apply changes"
                  Click="ApplyChangesButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <materialIcons:MaterialIcon Kind="Check" Width="16" Height="16" />
              <TextBlock Text="Apply" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            CornerRadius="8"
            ClipToBounds="True"
            Background="{DynamicResource StudioInputBrush}"
            BorderBrush="{DynamicResource StudioBorderBrush}"
            BorderThickness="1">
      <Grid>
        <Grid IsVisible="{Binding HasTable}"
              RowDefinitions="34,*">
          <ScrollViewer x:Name="ColumnHeaderScrollViewer"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
              <Border Width="52"
                      Height="34"
                      Background="{DynamicResource StudioSurfaceSunkenBrush}"
                      BorderBrush="{DynamicResource StudioBorderBrush}"
                      BorderThickness="0,0,1,1">
                <TextBlock Text="#"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource StudioTextSubtleBrush}" />
              </Border>
              <ItemsControl ItemsSource="{Binding Columns}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="viewModels:StringTableColumnHeaderViewModel">
                    <Border Width="220"
                            Height="34"
                            Background="{DynamicResource StudioSurfaceSunkenBrush}"
                            BorderBrush="{DynamicResource StudioBorderBrush}"
                            BorderThickness="0,0,1,1">
                      <TextBlock Text="{Binding Label}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 FontSize="10"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource StudioTextMutedBrush}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border x:Name="ColumnHeaderEndSpacer"
                      Width="0" />
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer x:Name="TableBodyScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto"
                        ScrollChanged="TableBodyScrollViewer_ScrollChanged">
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="viewModels:StringTableRowEditorViewModel">
                  <StackPanel Orientation="Horizontal"
                              Height="76">
                    <Border Width="52"
                            Height="76"
                            Background="{DynamicResource StudioSurfaceSunkenBrush}"
                            BorderBrush="{DynamicResource StudioBorderBrush}"
                            BorderThickness="0,0,1,1">
                      <TextBlock Text="{Binding Label}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 FontFamily="Consolas"
                                 FontSize="10"
                                 Foreground="{DynamicResource StudioTextMutedBrush}" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding Cells}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:StringTableCellEditorViewModel">
                          <Border Width="220"
                                  Height="76"
                                  Padding="7,6"
                                  Background="{DynamicResource StudioInputBrush}"
                                  BorderBrush="{DynamicResource StudioBorderBrush}"
                                  BorderThickness="0,0,1,1"
                                  ToolTip.Tip="{Binding CoordinateText}">
                            <Grid RowDefinitions="*,24">
                              <TextBox MinHeight="34"
                                       Padding="8,5"
                                       Text="{Binding ValueInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       IsReadOnly="{Binding IsValueReadOnly}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       TextWrapping="NoWrap" />
                              <Grid Grid.Row="1"
                                    ColumnDefinitions="*,Auto"
                                    Margin="2,4,0,0">
                                <TextBlock Text="{Binding FooterText}"
                                           VerticalAlignment="Center"
                                           FontFamily="Consolas"
                                           FontSize="9"
                                           Foreground="{DynamicResource StudioTextSubtleBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding FooterToolTipText}" />
                                <CheckBox Grid.Column="1"
                                          Content="NULL"
                                          IsChecked="{Binding IsNull, Mode=TwoWay}"
                                          IsEnabled="{Binding CanEdit}"
                                          VerticalAlignment="Center"
                                          FontSize="9"
                                          Foreground="{DynamicResource StudioTextMutedBrush}" />
                              </Grid>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>

        <StackPanel IsVisible="{Binding !HasTable}"
                    Margin="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="7">
          <TextBlock Text="StringTable content is unavailable"
                     HorizontalAlignment="Center"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource StudioTextBrush}" />
          <TextBlock Text="{Binding StatusMessage}"
                     MaxWidth="520"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     FontSize="11"
                     Foreground="{DynamicResource StudioTextMutedBrush}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
