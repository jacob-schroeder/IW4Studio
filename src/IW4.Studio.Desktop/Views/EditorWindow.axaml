<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:composition="using:IW4.Studio.Desktop.Workbench.Composition"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
        x:Class="IW4.Studio.Desktop.Views.EditorWindow"
        x:DataType="composition:StudioWorkbenchViewModel"
        mc:Ignorable="d"
        d:DesignWidth="1440"
        d:DesignHeight="900"
        Title="IW4 Studio"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="700"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,52,*,25">

    <Menu x:Name="WindowMenu" Grid.Row="0" Height="30" />
  
    <!-- Background="{DynamicResource StudioSurfaceBrush}" -->
    <Border Grid.Row="1"
            Padding="14,7"
            BorderBrush="{DynamicResource StudioBorderBrush}"
            BorderThickness="0,0,0,1">
      
      <Border.Background>
        <ImageBrush
          Source="{DynamicResource StudioBannerImage}"
          Stretch="Fill"
          TileMode="Tile" 
          AlignmentX="Left"
          AlignmentY="Top"
          Opacity="1" />
      </Border.Background>
            
      <Grid ColumnDefinitions="Auto,12,*,Auto" VerticalAlignment="Center">
        
        <!-- Background="{DynamicResource StudioAccentStrongBrush}" -->
        <Border Grid.Column="0"
                Width="48"
                Height="48"
                CornerRadius="3"
                ClipToBounds="True"
                >
          <Image
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Source="/Resources/logo_simple.png"
            Stretch="Uniform" />
        </Border>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="{Binding TargetFileName}"
                     HorizontalAlignment="Left"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource StudioTextBrush}" />
          <TextBlock Text="{Binding TargetPath}"
                     HorizontalAlignment="Left"
                     MaxWidth="760"
                     FontSize="10"
                     Foreground="{DynamicResource StudioTextSubtleBrush}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="9" Name="ActionBar">
          <Button Classes="ghost"
                  MinHeight="32"
                  Padding="11,5"
                  Content="Example Button"  />
        </StackPanel>
      </Grid>
    </Border>

    <composition:StudioWorkbenchView Grid.Row="2" />

    <Border Grid.Row="3"
            Padding="9,0"
            Background="{DynamicResource StudioSurfaceBrush}"
            BorderBrush="{DynamicResource StudioBorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="18">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7">
          <TextBlock Text="●"
                     VerticalAlignment="Center"
                     FontSize="9"
                     Foreground="{DynamicResource StudioSuccessBrush}" />
          <TextBlock Text="Workspace catalog loaded"
                     VerticalAlignment="Center"
                     FontSize="10"
                     Foreground="{DynamicResource StudioSuccessBrush}" />
        </StackPanel>
        <TextBlock Grid.Column="2"
                   Text="{Binding ModeName}"
                   VerticalAlignment="Center"
                   FontSize="10"
                   Foreground="{DynamicResource StudioTextMutedBrush}" />
        <TextBlock Grid.Column="3"
                   Text="{Binding SearchResultText}"
                   VerticalAlignment="Center"
                   FontSize="10"
                   Foreground="{DynamicResource StudioTextMutedBrush}" />
      </Grid>
    </Border>
  </Grid>
</Window>
