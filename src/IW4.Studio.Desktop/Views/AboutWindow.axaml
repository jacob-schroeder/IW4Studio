<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
        x:Class="IW4.Studio.Desktop.Views.AboutWindow"
        Title="About IW4 Studio"
        Width="520"
        Height="590"
        MinWidth="520"
        MinHeight="590"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Border Background="{DynamicResource StudioBackgroundBrush}"
          Padding="42,30,42,28">
    <Grid RowDefinitions="Auto,22,Auto,8,Auto,*,Auto,24,Auto,20"
          HorizontalAlignment="Stretch">
      <svg:Svg Grid.Row="0"
               Width="190"
               Height="190"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Stretch="Uniform"
               Path="/Resources/logo_alt.svg" />

      <TextBlock Grid.Row="2"
                 Text="IW4 Studio"
                 HorizontalAlignment="Center"
                 FontSize="30"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource StudioTextBrush}" />
      <TextBlock Grid.Row="4"
                 Text="v1.0.1"
                 HorizontalAlignment="Center"
                 FontSize="15"
                 Foreground="{DynamicResource StudioTextMutedBrush}" />

      <StackPanel Grid.Row="6" Spacing="14">
        <TextBlock Text="A fastfile workspace for exploring IW4 assets."
                   TextWrapping="Wrap"
                   FontSize="15"
                   Foreground="{DynamicResource StudioTextBrush}" />
        <TextBlock Text="Built with IW4.Studio and Avalonia."
                   TextWrapping="Wrap"
                   FontSize="15"
                   Foreground="{DynamicResource StudioTextBrush}" />
      </StackPanel>

      <Button Grid.Row="8"
              Classes="primary"
              Width="210"
              HorizontalAlignment="Center"
              Content="Close"
              Click="CloseButton_Click" />
      <TextBlock Grid.Row="9"
                 Text="© 2026 IW4 Studio"
                 HorizontalAlignment="Center"
                 FontSize="13"
                 Foreground="{DynamicResource StudioTextMutedBrush}" />
    </Grid>
  </Border>
</Window>
