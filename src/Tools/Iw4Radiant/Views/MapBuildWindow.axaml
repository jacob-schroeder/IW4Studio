<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Iw4Radiant.Views.MapBuildWindow"
        Title="Build PS3 map" Width="760" Height="760"
        MinWidth="640" MinHeight="680" WindowStartupLocation="CenterOwner">
    <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
        <StackPanel Spacing="6">
            <TextBlock x:Name="SourceName" FontSize="17" FontWeight="SemiBold" />
            <TextBlock x:Name="GameModesText" Classes="caption" FontWeight="SemiBold" IsVisible="False" />
            <TextBlock x:Name="ScopeText" Classes="caption" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel x:Name="BuildInputs" Grid.Row="1" Spacing="10">
            <StackPanel Spacing="4">
                <TextBlock Text="D3dbspLinker tool" Classes="panelTitle" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="LinkerPathBox" PlaceholderText="Select D3dbspLinker.dll or the executable"
                             AutomationProperties.Name="D3dbspLinker path" />
                    <Button Grid.Column="1" Content="Browse…" Click="BrowseLinker_Click" />
                </Grid>
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="Official bootstrap map fastfile" Classes="panelTitle" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="TemplatePathBox" PlaceholderText="Official PS3 map (.ff), beside its shared startup fastfiles"
                             AutomationProperties.Name="Bootstrap fastfile path" />
                    <Button Grid.Column="1" Content="Browse…" Click="BrowseTemplate_Click" />
                </Grid>
                <TextBlock Text="Supplies the Rangers/OpFor startup assets through the native dependency loader."
                           Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="Additional provider fastfiles · optional" Classes="panelTitle" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Add…" Click="AddProvider_Click" />
                    <Button x:Name="RemoveProviderButton" Grid.Column="2" Content="Remove" IsEnabled="False" Click="RemoveProvider_Click" />
                </Grid>
                <ListBox x:Name="ProviderList" Height="76" Background="#1B1D21"
                         BorderBrush="#454A52" BorderThickness="1" SelectionChanged="Provider_Changed"
                         AutomationProperties.Name="Additional provider fastfiles" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="Output folder" Classes="panelTitle" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="OutputFolderBox" AutomationProperties.Name="Build output folder" />
                    <Button Grid.Column="1" Content="Browse…" Click="BrowseOutput_Click" />
                </Grid>
                <TextBlock Text="Each build creates a new folder containing the compiled BSP and PS3 fastfile."
                           Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="6">
            <TextBlock x:Name="BuildStatus" Text="Ready to build the saved map." Classes="panelTitle" TextWrapping="Wrap" />
            <TextBox x:Name="ProgressOutput" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="Wrap" FontFamily="Menlo,Consolas,monospace" FontSize="11"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Build progress" />
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="BuildButton" Content="Build PS3 fastfile" Classes="panelAction" Click="Build_Click" />
            <Button x:Name="CloseButton" Content="Close" MinWidth="88" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
