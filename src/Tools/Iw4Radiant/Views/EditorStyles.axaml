<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Window">
        <Setter Property="Background" Value="#202226" />
        <Setter Property="Foreground" Value="#D9DCE1" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.panelTitle">
        <Setter Property="Foreground" Value="#D9DCE1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="Foreground" Value="#B1B5BE" />
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="#C1C5CC" />
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBox, NumericUpDown, ComboBox">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="#1B1D21" />
        <Setter Property="BorderBrush" Value="#454A52" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="NumericUpDown">
        <Setter Property="ShowButtonSpinner" Value="False" />
    </Style>
    <Style Selector=":is(Button)">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button, ToggleButton">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector=":is(TemplatedControl).compact">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector=":is(Button).panelAction">
        <Setter Property="Background" Value="#30343A" />
        <Setter Property="Foreground" Value="#E0E3E7" />
        <Setter Property="BorderBrush" Value="#454A52" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TabItem">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#BFC4CD" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="TabItem:selected">
        <Setter Property="Background" Value="#3D4B5E" />
        <Setter Property="Foreground" Value="#E4EAF1" />
    </Style>
    <Style Selector="Expander">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Background" Value="#25282D" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Border.panelHeader, Border.toolOptionsBar">
        <Setter Property="Background" Value="#25282D" />
        <Setter Property="BorderBrush" Value="#34383E" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector="Border.viewportPanel">
        <Setter Property="Background" Value="#1B1D21" />
        <Setter Property="BorderBrush" Value="#34383E" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.viewportPanel.activeViewport">
        <Setter Property="BorderBrush" Value="#63758C" />
    </Style>
    <Style Selector=":is(Button).toolbarButton">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="MinWidth" Value="26" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>
    <Style Selector="StackPanel.toolbarGroup">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="Border.toolbarSeparator">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Margin" Value="5,0" />
        <Setter Property="Background" Value="#34383E" />
    </Style>
    <Style Selector="ComboBox.toolbarCombo">
        <Setter Property="Height" Value="26" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="5,2" />
    </Style>
    <Style Selector=":is(Button).viewportAction">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>
    <Style Selector="Button.viewportLabel">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ToggleButton.toolbarButton:checked, ToggleButton.viewportAction:checked">
        <Setter Property="Background" Value="#3D4B5E" />
        <Setter Property="Foreground" Value="#E4EAF1" />
    </Style>
    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="#34383E" />
    </Style>
    <Style Selector="GridSplitter:pointerover">
        <Setter Property="Background" Value="#8195AE" />
    </Style>
</Styles>
