<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Iw4Radiant.Views"
             x:Class="Iw4Radiant.Views.SunlightInspector">
    <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Sunlight" Classes="panelTitle" VerticalAlignment="Center" />
            <CheckBox x:Name="SunEnabled" Grid.Column="1" Content="Enabled" ToolTip.Tip="Apply to author sunlight in worldspawn. Disabling removes only the three direct sunlight properties." />
        </Grid>
        <TextBlock x:Name="SourceError" Foreground="#E5B477" TextWrapping="Wrap" IsVisible="False" />
        <Button x:Name="EditSourceButton" Content="Edit world properties" IsVisible="False" />
        <StackPanel x:Name="SunFields" Spacing="8">
            <Grid ColumnDefinitions="*,*,*,34" RowDefinitions="Auto,Auto" ColumnSpacing="5" RowSpacing="4">
                <TextBlock Text="Red" Classes="caption" />
                <TextBlock Text="Green" Grid.Column="1" Classes="caption" />
                <TextBlock Text="Blue" Grid.Column="2" Classes="caption" />
                <TextBox x:Name="RedBox" Grid.Row="1" Text="1" ToolTip.Tip="Red component; values above 1 increase brightness." />
                <TextBox x:Name="GreenBox" Grid.Row="1" Grid.Column="1" Text="1" ToolTip.Tip="Green component; values above 1 increase brightness." />
                <TextBox x:Name="BlueBox" Grid.Row="1" Grid.Column="2" Text="1" ToolTip.Tip="Blue component; values above 1 increase brightness." />
                <Border x:Name="ColorSwatch" Grid.Row="1" Grid.Column="3" Background="White" BorderBrush="#454A52"
                        BorderThickness="1" CornerRadius="2" ToolTip.Tip="Color preview. Values above 1 appear at full brightness." />
            </Grid>
            <Grid ColumnDefinitions="65,*" ColumnSpacing="5">
                <TextBlock Text="Intensity" Classes="fieldLabel" />
                <TextBox x:Name="IntensityBox" Grid.Column="1" Text="1" ToolTip.Tip="Direct sunlight intensity. 1 lights a facing surface at full brightness." />
            </Grid>
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="5" RowSpacing="4">
                <TextBlock Text="Pitch (°)" Classes="caption" />
                <TextBlock Text="Yaw (°)" Grid.Column="1" Classes="caption" />
                <TextBlock Text="Roll (°)" Grid.Column="2" Classes="caption" />
                <TextBox x:Name="PitchBox" Grid.Row="1" Text="-45" ToolTip.Tip="Direction toward the sun. -90 is directly overhead; 0 is on the horizon." />
                <TextBox x:Name="YawBox" Grid.Row="1" Grid.Column="1" Text="0" ToolTip.Tip="0 points along +X; 90 points along +Y." />
                <TextBox x:Name="RollBox" Grid.Row="1" Grid.Column="2" Text="0" ToolTip.Tip="Preserved source roll; it does not change the sun direction." />
            </Grid>
            <views:SunDirectionControl x:Name="DirectionPicker" Height="90"
                                       ToolTip.Tip="Drag to aim the sun. Left/right changes yaw; up/down changes elevation. Arrow keys adjust by one degree; Shift uses 15 degrees. Apply commits the direction." />
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
            <Button x:Name="ApplySunButton" Content="Apply sunlight" Classes="panelAction" HorizontalAlignment="Stretch" />
            <Button x:Name="RevertSunButton" Grid.Column="1" Content="Revert" ToolTip.Tip="Discard unapplied sunlight changes." />
        </Grid>
        <TextBlock Text="Direct light and shadows preview after Apply. Bounced light is not baked in the editor." Classes="caption" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
