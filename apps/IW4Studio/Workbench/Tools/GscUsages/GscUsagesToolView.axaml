<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:usages="using:IW4.Studio.Desktop.Workbench.Tools.GscUsages"
             x:Class="IW4.Studio.Desktop.Workbench.Tools.GscUsages.GscUsagesToolView"
             x:DataType="usages:GscUsagesToolViewModel"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="260">
  <Grid>
    <Grid IsVisible="{Binding HasItems}" RowDefinitions="32,*">
      <Border Padding="10,0"
              Background="{DynamicResource StudioSurfaceSunkenBrush}"
              BorderBrush="{DynamicResource StudioBorderBrush}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="220,110,160,*" ColumnSpacing="10">
          <TextBlock Text="File"
                     VerticalAlignment="Center"
                     FontSize="9"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource StudioTextSubtleBrush}" />
          <TextBlock Grid.Column="1"
                     Text="Location"
                     VerticalAlignment="Center"
                     FontSize="9"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource StudioTextSubtleBrush}" />
          <TextBlock Grid.Column="2"
                     Text="Kind"
                     VerticalAlignment="Center"
                     FontSize="9"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource StudioTextSubtleBrush}" />
          <TextBlock Grid.Column="3"
                     Text="Reference"
                     VerticalAlignment="Center"
                     FontSize="9"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource StudioTextSubtleBrush}" />
        </Grid>
      </Border>

      <ListBox x:Name="UsagesList"
               Grid.Row="1"
               Classes="studioOutputList"
               Margin="6"
               ItemsSource="{Binding Items}"
               SelectionMode="Single"
               DoubleTapped="UsagesList_DoubleTapped">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="usages:GscUsagePresentationItem">
            <Grid ColumnDefinitions="220,110,160,*"
                  ColumnSpacing="10"
                  Margin="4,3">
              <TextBlock Text="{Binding DocumentPath}"
                         FontSize="10"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource StudioTextMutedBrush}" />
              <TextBlock Grid.Column="1"
                         Text="{Binding LocationText}"
                         FontSize="10"
                         Foreground="{DynamicResource StudioTextMutedBrush}" />
              <TextBlock Grid.Column="2"
                         Text="{Binding ContainerName}"
                         FontSize="10"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource StudioTextMutedBrush}" />
              <TextBlock Grid.Column="3"
                         Text="{Binding PreviewText}"
                         FontFamily="JetBrains Mono, Menlo, Consolas"
                         FontSize="10"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource StudioTextBrush}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <StackPanel IsVisible="{Binding !HasItems}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="5">
      <TextBlock Text="{Binding ResultText}"
                 HorizontalAlignment="Center"
                 FontSize="10"
                 Foreground="{DynamicResource StudioTextMutedBrush}" />
    </StackPanel>
  </Grid>
</UserControl>
