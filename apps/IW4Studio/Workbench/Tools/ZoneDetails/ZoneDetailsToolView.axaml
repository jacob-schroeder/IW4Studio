<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:zoneDetails="using:IW4.Studio.Desktop.Workbench.Tools.ZoneDetails"
             x:Class="IW4.Studio.Desktop.Workbench.Tools.ZoneDetails.ZoneDetailsToolView"
             x:DataType="zoneDetails:ZoneDetailsToolViewModel"
             Classes="studioInspectorDetails"
             mc:Ignorable="d"
             d:DesignWidth="360"
             d:DesignHeight="700">
  <Grid RowDefinitions="Auto,Auto,*">
    <StackPanel Margin="12"
                Spacing="8">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding ZoneName}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource StudioTextBrush}" />
        <TextBlock Text="DECODED TARGET ZONE"
                   FontSize="11"
                   FontWeight="Bold"
                   LetterSpacing="0.7"
                   Foreground="{DynamicResource StudioTextSubtleBrush}" />
      </StackPanel>

      <Border Padding="12"
              CornerRadius="6"
              Background="{DynamicResource StudioSurfaceSunkenBrush}"
              BorderBrush="{DynamicResource StudioBorderBrush}"
              BorderThickness="1">
        <Grid RowDefinitions="Auto,8,Auto"
              ColumnDefinitions="116,*">
          <TextBlock Text="Script strings" Classes="propertyLabel" />
          <TextBlock Grid.Column="1"
                     Text="{Binding ScriptStringCount}"
                     Classes="propertyValue" />
          <TextBlock Grid.Row="2" Text="Assets" Classes="propertyLabel" />
          <TextBlock Grid.Row="2"
                     Grid.Column="1"
                     Text="{Binding AssetCount}"
                     Classes="propertyValue" />
        </Grid>
      </Border>

      <StackPanel Spacing="8">
        <TextBlock Text="BLOCK STREAMS"
                   FontSize="11"
                   FontWeight="Bold"
                   LetterSpacing="0.8"
                   Foreground="{DynamicResource StudioTextSubtleBrush}" />
        <ItemsControl ItemsSource="{Binding BlockStreams}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="zoneDetails:ZoneBlockStreamViewModel">
              <WrapPanel Margin="0,0,0,8" ItemSpacing="8" LineSpacing="2">
                <TextBlock Text="{Binding TypeName}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource StudioTextBrush}" />
                <TextBlock Text="{Binding SizeText}"
                           FontSize="12"
                           Foreground="{DynamicResource StudioTextMutedBrush}" />
                <TextBlock Text="{Binding HexSizeText}"
                           FontSize="11"
                           FontFamily="Consolas"
                           Foreground="{DynamicResource StudioTextSubtleBrush}" />
              </WrapPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>

    <Border Grid.Row="1"
            Padding="12,8"
            Background="{DynamicResource StudioSurfaceSunkenBrush}"
            BorderBrush="{DynamicResource StudioBorderBrush}"
            BorderThickness="0,1">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBlock Text="SCRIPT STRINGS"
                   VerticalAlignment="Center"
                   FontSize="11"
                   FontWeight="Bold"
                   LetterSpacing="0.8"
                   Foreground="{DynamicResource StudioTextSubtleBrush}" />
        <TextBlock Grid.Column="1"
                   Text="{Binding ScriptStringCount}"
                   VerticalAlignment="Center"
                   FontSize="11"
                   Foreground="{DynamicResource StudioTextMutedBrush}" />
        <Button Grid.Column="2" Content="…" Width="28" MinHeight="28" Padding="0"
                FontSize="12" CornerRadius="4"
                ToolTip.Tip="Edit script strings" AutomationProperties.Name="Edit script strings"
                Click="EditScriptStrings_Click" />
      </Grid>
    </Border>

    <ListBox Grid.Row="2"
             Margin="12,8,12,12"
             ItemsSource="{Binding ScriptStrings}"
             Classes="studioOutputList">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="zoneDetails:ZoneScriptStringViewModel">
          <Grid ColumnDefinitions="48,*"
                ColumnSpacing="8">
            <TextBlock Text="{Binding Index, StringFormat='{}{0:N0}'}"
                       HorizontalAlignment="Right"
                       FontSize="11"
                       FontFamily="Consolas"
                       Foreground="{DynamicResource StudioTextSubtleBrush}" />
            <TextBlock Grid.Column="1"
                       Text="{Binding Value}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource StudioTextBrush}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
