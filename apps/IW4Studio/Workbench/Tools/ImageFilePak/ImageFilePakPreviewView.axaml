<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:imageFilePak="using:IW4.Studio.Desktop.Workbench.Tools.ImageFilePak"
             x:Class="IW4.Studio.Desktop.Workbench.Tools.ImageFilePak.ImageFilePakPreviewView"
             x:DataType="imageFilePak:ImageFilePakPreviewViewModel"
             mc:Ignorable="d"
             d:DesignWidth="920"
             d:DesignHeight="660">
  <Border CornerRadius="8"
          ClipToBounds="True"
          Background="{DynamicResource StudioSurfaceSunkenBrush}"
          BorderBrush="{DynamicResource StudioBorderBrush}"
          BorderThickness="1">
    <Grid RowDefinitions="38,*,Auto">
      <Border Padding="12,0"
              Background="{DynamicResource StudioSidebarBrush}"
              BorderBrush="{DynamicResource StudioBorderBrush}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,8,*"
              VerticalAlignment="Center">
          <materialIcons:MaterialIcon Kind="ImageOutline"
                                      Width="16"
                                      Height="16"
                                      Foreground="{DynamicResource StudioAccentBrush}" />
          <TextBlock Grid.Column="2"
                     Text="STREAMED IMAGE PREVIEW"
                     VerticalAlignment="Center"
                     FontSize="9"
                     FontWeight="Bold"
                     LetterSpacing="0.8"
                     Foreground="{DynamicResource StudioTextSubtleBrush}" />
        </Grid>
      </Border>

      <Grid Grid.Row="1"
            Margin="18">
        <Image Source="{Binding Preview}"
               IsVisible="{Binding HasPreview}"
               Stretch="Uniform" />
        <StackPanel IsVisible="{Binding !HasPreview}"
                    MaxWidth="330"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="9">
          <materialIcons:MaterialIcon Kind="ImageOutline"
                                      Width="42"
                                      Height="42"
                                      HorizontalAlignment="Center"
                                      Foreground="{DynamicResource StudioTextSubtleBrush}" />
          <TextBlock Text="{Binding PreviewMessage}"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     FontSize="10"
                     Foreground="{DynamicResource StudioTextMutedBrush}" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="2"
              Padding="11,8"
              Background="{DynamicResource StudioSidebarBrush}"
              BorderBrush="{DynamicResource StudioBorderBrush}"
              BorderThickness="0,1,0,0">
        <Grid RowDefinitions="Auto,Auto">
          <TextBlock Text="{Binding PreviewMessage}"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     FontSize="9"
                     Foreground="{DynamicResource StudioTextSubtleBrush}" />
          <ProgressBar Grid.Row="1"
                       Height="2"
                       Margin="0,7,0,0"
                       IsIndeterminate="True"
                       IsVisible="{Binding IsPreviewLoading}"
                       Foreground="{DynamicResource StudioAccentBrush}" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
