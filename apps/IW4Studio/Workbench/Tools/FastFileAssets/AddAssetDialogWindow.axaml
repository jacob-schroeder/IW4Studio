<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="IW4.Studio.Desktop.Workbench.Tools.FastFileAssets.AddAssetDialogWindow"
        Title="Add Asset"
        Width="430"
        Height="300"
        MinWidth="430"
        MinHeight="300"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Border Padding="28,24"
          Background="{DynamicResource StudioBackgroundBrush}">
    <Grid RowDefinitions="Auto,20,Auto,14,Auto,*,Auto">
      <StackPanel Grid.Row="0" Spacing="5">
        <TextBlock Text="Add Asset"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource StudioTextBrush}" />
        <TextBlock Text="Create a new asset in this fastfile."
                   FontSize="11"
                   Foreground="{DynamicResource StudioTextMutedBrush}" />
      </StackPanel>

      <StackPanel Grid.Row="2" Spacing="6">
        <TextBlock Text="Asset type"
                   FontSize="10"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource StudioTextBrush}" />
        <AutoCompleteBox x:Name="AssetTypeAutoCompleteBox"
                         MinHeight="34"
                         HorizontalAlignment="Stretch"
                         MinimumPrefixLength="0"
                         PlaceholderText="Type to filter asset types"
                         TextChanged="AssetTypeAutoCompleteBox_TextChanged"
                         DropDownClosed="AssetTypeAutoCompleteBox_DropDownClosed"
                         SelectionChanged="AssetTypeAutoCompleteBox_SelectionChanged">
          <AutoCompleteBox.InnerRightContent>
            <Button Width="30"
                    Height="30"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Focusable="False"
                    ToolTip.Tip="Show all asset types"
                    Click="AssetTypeDropDownButton_Click">
              <materialIcons:MaterialIcon Kind="ChevronDown"
                                          Width="14"
                                          Height="14"
                                          IsHitTestVisible="False" />
            </Button>
          </AutoCompleteBox.InnerRightContent>
        </AutoCompleteBox>
      </StackPanel>

      <StackPanel Grid.Row="4" Spacing="6">
        <TextBlock Text="Name"
                   FontSize="10"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource StudioTextBrush}" />
        <TextBox x:Name="NameTextBox"
                 MinHeight="34"
                 HorizontalAlignment="Stretch"
                 PlaceholderText="Enter a unique asset name"
                 TextChanged="NameTextBox_TextChanged" />
        <TextBlock x:Name="ValidationTextBlock"
                   MinHeight="16"
                   FontSize="9"
                   Foreground="{DynamicResource StudioErrorBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Grid.Row="6"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="10">
        <Button MinWidth="92"
                Content="Cancel"
                IsCancel="True"
                Click="CancelButton_Click" />
        <Button x:Name="AddButton"
                Classes="primary"
                MinWidth="92"
                Content="Add"
                IsDefault="True"
                IsEnabled="False"
                Click="AddButton_Click" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
