<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:fastfileAssets="using:IW4.Studio.Desktop.Workbench.Tools.FastFileAssets"
             x:Class="IW4.Studio.Desktop.Workbench.Tools.FastFileAssets.FastFileAssetsNavigatorView"
             x:DataType="fastfileAssets:FastFileAssetsNavigatorViewModel"
             mc:Ignorable="d"
             d:DesignWidth="250"
             d:DesignHeight="760">
  <UserControl.Styles>
    <Style Selector="ToggleButton.contentsAllTypes:checked">
      <Setter Property="Background" Value="{DynamicResource StudioControlSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderStrongBrush}" />
    </Style>
    <Style Selector="TextBlock.assetCount">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource StudioTextMutedBrush}" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,*">
    <Border Padding="12,8"
            BorderBrush="{DynamicResource StudioBorderBrush}"
            BorderThickness="0,0,0,1">
      <TextBlock Text="ASSET TYPES"
                 FontSize="11"
                 FontWeight="Bold"
                 LetterSpacing="0.8"
                 Foreground="{DynamicResource StudioTextSubtleBrush}" />
    </Border>

    <ToggleButton Grid.Row="1"
                  Classes="studioDockTab contentsAllTypes"
                  Margin="4,4,4,0"
                  MinHeight="30"
                  Padding="7,0"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  IsChecked="{Binding IsAllTypesSelected, Mode=OneWay}"
                  Click="AllTypes_Click">
      <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="8">
        <materialIcons:MaterialIcon Kind="FormatListBulleted"
                                    Width="16" Height="16"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource StudioAccentSecondaryBrush}" />
        <TextBlock Grid.Column="1" Text="All types" FontSize="12"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource StudioTextBrush}" />
        <TextBlock Grid.Column="2" Classes="assetCount"
                   IsVisible="{Binding IsThisFastFileScope}"
                   Text="{Binding TargetContentsCount, StringFormat='{}{0:N0}'}" />
        <TextBlock Grid.Column="2" Classes="assetCount"
                   IsVisible="{Binding IsDependenciesScope}"
                   Text="{Binding DependencyContentsCount, StringFormat='{}{0:N0}'}" />
        <TextBlock Grid.Column="2" Classes="assetCount"
                   IsVisible="{Binding IsAssetPoolScope}"
                   Text="{Binding PoolContentsCount, StringFormat='{}{0:N0}'}" />
      </Grid>
    </ToggleButton>

    <ListBox x:Name="CategoryList" Grid.Row="2"
             Classes="studioNavigatorList studioAssetList"
             Margin="4,0,4,4"
             ItemsSource="{Binding Groups}"
             SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
             SelectionMode="Single"
             KeyDown="Categories_KeyDown">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="fastfileAssets:FastFileAssetNavigatorGroup">
          <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="8">
            <materialIcons:MaterialIcon Kind="FolderOutline"
                                        Width="16"
                                        Height="16"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource StudioAccentSecondaryBrush}" />
            <TextBlock Grid.Column="1"
                       Text="{Binding Name}"
                       VerticalAlignment="Center"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource StudioTextBrush}" />
            <TextBlock Grid.Column="2" Classes="assetCount"
                       Text="{Binding Count, StringFormat='{}{0:N0}'}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
