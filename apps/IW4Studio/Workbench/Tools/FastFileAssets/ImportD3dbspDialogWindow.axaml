<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="IW4.Studio.Desktop.Workbench.Tools.FastFileAssets.ImportD3dbspDialogWindow"
        Title="Import D3DBSP"
        Width="540"
        Height="470"
        MinWidth="420"
        MinHeight="380"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Border Padding="28,24"
          Background="{DynamicResource StudioBackgroundBrush}">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
      <TextBlock Grid.Row="0" x:Name="SourceTextBlock"
                 FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                 Foreground="{DynamicResource StudioTextBrush}" />

      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">
          <StackPanel Spacing="5">
            <TextBlock Text="Internal map asset name"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource StudioTextBrush}" />
            <TextBox x:Name="NameTextBox"
                     MinHeight="34"
                     PlaceholderText="maps/mp/mp_example.d3dbsp"
                     TextChanged="Input_TextChanged" />
            <TextBlock Text="Creates or replaces a group of six map assets."
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource StudioTextSubtleBrush}" />
          </StackPanel>

          <StackPanel Spacing="5">
            <TextBlock Text="PS3 fragment-program capacity per arena (bytes)"
                       FontSize="12"
                       TextWrapping="Wrap"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource StudioTextBrush}" />
            <TextBox x:Name="CapacityTextBox"
                     MinHeight="34"
                     PlaceholderText="Decimal or 0x-prefixed hexadecimal"
                     TextChanged="Input_TextChanged" />
            <TextBlock Text="If blank, use the capacity from your PS3 template or target profile."
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource StudioTextSubtleBrush}" />
          </StackPanel>

          <StackPanel Spacing="5">
            <CheckBox x:Name="ForceFullbrightCheckBox"
                      Content="Force fullbright"
                      FontWeight="SemiBold" />
            <TextBlock Margin="24,0,0,0"
                       Text="Permanently removes lightmaps from the imported assets. Use only if they block import."
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource StudioTextSubtleBrush}" />
          </StackPanel>

          <TextBlock x:Name="ValidationTextBlock"
                     FontSize="11"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource StudioErrorBrush}" />
        </StackPanel>
      </ScrollViewer>

      <StackPanel Grid.Row="2"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="10">
        <Button x:Name="CancelButton"
                MinWidth="92"
                Content="Cancel"
                IsCancel="True"
                Click="CancelButton_Click" />
        <Button x:Name="ImportButton"
                Classes="primary"
                MinWidth="92"
                Content="Import"
                IsDefault="True"
                IsEnabled="False"
                Click="ImportButton_Click" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
