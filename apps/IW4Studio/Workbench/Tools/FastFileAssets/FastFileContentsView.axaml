<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:converters="using:Avalonia.Data.Converters"
             xmlns:fastfileAssets="using:IW4.Studio.Desktop.Workbench.Tools.FastFileAssets"
             x:Class="IW4.Studio.Desktop.Workbench.Tools.FastFileAssets.FastFileContentsView"
             x:DataType="fastfileAssets:FastFileAssetsNavigatorViewModel"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="760">
  <UserControl.Styles>
    <Style Selector="ToggleButton.contentsScopeButton">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Background" Value="{DynamicResource StudioSurfaceSunkenBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource StudioTextMutedBrush}" />
    </Style>
    <Style Selector="ToggleButton.contentsScopeButton:checked">
      <Setter Property="Background" Value="{DynamicResource StudioControlSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentSecondaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
    </Style>
    <Style Selector="Button.contentsAction">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <Border Padding="12,8"
            BorderBrush="{DynamicResource StudioBorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
          <ToggleButton x:Name="ThisFastFileScopeButton"
                        Classes="studioDockTab contentsScopeButton"
                        IsChecked="{Binding IsThisFastFileScope, Mode=OneWay}"
                        Click="ScopeButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="This fastfile" />
              <TextBlock Text="{Binding TargetContentsCount, StringFormat='{}{0:N0}'}"
                         FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton x:Name="DependenciesScopeButton"
                        Classes="studioDockTab contentsScopeButton"
                        IsChecked="{Binding IsDependenciesScope, Mode=OneWay}"
                        Click="ScopeButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Dependencies" />
              <TextBlock Text="{Binding DependencyContentsCount, StringFormat='{}{0:N0}'}"
                         FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton x:Name="AssetPoolScopeButton"
                        Classes="studioDockTab contentsScopeButton"
                        IsChecked="{Binding IsAssetPoolScope, Mode=OneWay}"
                        Click="ScopeButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Asset Pool" />
              <TextBlock Text="{Binding PoolContentsCount, StringFormat='{}{0:N0}'}"
                         FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Assets"
                     VerticalAlignment="Center"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource StudioTextBrush}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Classes="contentsAction" Content="Asset actions"
                    IsEnabled="{Binding SelectedContentsRow, Converter={x:Static converters:ObjectConverters.IsNotNull}}"
                    Click="SelectedAssetActions_Click" />
            <Button Classes="contentsAction" IsVisible="{Binding IsThisFastFileScope}">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="Import Asset…" Click="ImportAssetMenuItem_Click" />
                  <MenuItem Header="Import RawFile folder…" Click="ImportRawFileFolderMenuItem_Click" />
                  <MenuItem Header="Import .d3dbsp…" Click="ImportD3dbspMenuItem_Click" />
                  <MenuItem Header="Import Package…" Click="ImportPackageMenuItem_Click" />
                </MenuFlyout>
              </Button.Flyout>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Import" />
                <materialIcons:MaterialIcon Kind="ChevronDown" Width="14" Height="14"
                                            VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="contentsAction" Content="Add Asset…"
                    ToolTip.Tip="Add an asset to this fastfile"
                    IsEnabled="{Binding CanAddAssets}"
                    Click="AddAssetMenuItem_Click" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Padding="12,8"
            BorderBrush="{DynamicResource StudioBorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox Text="{Binding ContentsSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="32"
                 Padding="8,4"
                 CornerRadius="4"
                 PlaceholderText="Search asset names…"
                 FontSize="12" />
        <TextBlock Grid.Column="1"
                   Text="{Binding ContentsResultText}"
                   VerticalAlignment="Center"
                   FontSize="11"
                   Foreground="{DynamicResource StudioTextSubtleBrush}" />
      </Grid>
    </Border>

    <TextBlock Grid.Row="2"
               Margin="12,8"
               IsVisible="{Binding HasImportStatus}"
               Text="{Binding ImportStatusMessage}"
               FontSize="11"
               TextWrapping="Wrap"
               Foreground="{DynamicResource StudioTextSubtleBrush}" />

    <Grid x:Name="AssetTable" Grid.Row="3" RowDefinitions="Auto,*" ContextRequested="Contents_ContextRequested">
      <Grid.ContextFlyout>
        <MenuFlyout>
          <MenuItem x:Name="OpenContentsMenuItem" Header="Open" Click="OpenContentsMenuItem_Click" />
          <MenuItem x:Name="OverrideWeaponMenuItem" Header="Override in patch_mp.ff…" IsVisible="False">
            <MenuItem Header="Copy existing weapon" Click="CopyWeapon_Click" />
            <MenuItem Header="Use weapon file…" Click="UseWeaponFile_Click" />
          </MenuItem>
          <MenuItem x:Name="AddReferenceMenuItem" Header="Add reference only"
                    IsVisible="False" Click="AddReference_Click" />
          <MenuItem x:Name="ExportAssetMenuItem"
                    Header="Export Asset…"
                    IsVisible="False"
                    Click="ExportAssetMenuItem_Click" />
          <MenuItem x:Name="ExportPackageMenuItem"
                    Header="Export .iw4pkg with dependencies…"
                    IsVisible="False"
                    Click="ExportPackageMenuItem_Click" />
          <MenuItem x:Name="ImportAssetMenuItem"
                    Header="Import Asset…"
                    Click="ImportAssetMenuItem_Click" />
          <MenuItem x:Name="ImportRawFileFolderMenuItem"
                    Header="Import RawFile folder…"
                    IsVisible="False"
                    Click="ImportRawFileFolderMenuItem_Click" />
          <MenuItem x:Name="ImportPackageMenuItem"
                    Header="Import Package…"
                    IsVisible="False"
                    Click="ImportPackageMenuItem_Click" />
        </MenuFlyout>
      </Grid.ContextFlyout>
      <Border Padding="12,4"
              Background="{DynamicResource StudioSurfaceSunkenBrush}"
              BorderBrush="{DynamicResource StudioBorderBrush}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="16,5*,2*,3*" ColumnSpacing="8">
          <TextBlock Grid.Column="1" Text="Asset name" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource StudioTextSubtleBrush}" />
          <TextBlock Grid.Column="2" Text="Asset type" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource StudioTextSubtleBrush}" />
          <TextBlock Grid.Column="3" Text="Source file" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource StudioTextSubtleBrush}" />
        </Grid>
      </Border>
      <ListBox x:Name="ContentsList"
               Grid.Row="1"
               Classes="studioOutputList studioAssetList"
               Margin="4"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ItemsSource="{Binding ContentsRows}"
               SelectedItem="{Binding SelectedContentsRow, Mode=TwoWay}"
               SelectionMode="Multiple"
               DoubleTapped="ContentsList_DoubleTapped"
               KeyDown="ContentsList_KeyDown">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="fastfileAssets:FastFileContentsRow">
            <Grid ColumnDefinitions="16,5*,2*,3*" ColumnSpacing="8">
              <materialIcons:MaterialIcon Kind="FileCodeOutline"
                                          Width="16"
                                          Height="16"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource StudioAccentBrush}" />
              <DockPanel Grid.Column="1">
                <Border DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                        IsVisible="{Binding IsReferencePlaceholder}"
                        ToolTip.Tip="{Binding PlaceholderHint}"
                        Background="{DynamicResource StudioSurfaceSunkenBrush}"
                        BorderBrush="{DynamicResource StudioBorderStrongBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="5,1">
                  <TextBlock Text="Placeholder" FontSize="11"
                             Foreground="{DynamicResource StudioTextMutedBrush}" />
                </Border>
                <Border DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                        IsVisible="{Binding HasOverride}"
                        ToolTip.Tip="{Binding OverrideHint}"
                        Background="{DynamicResource StudioSurfaceSunkenBrush}"
                        BorderBrush="{DynamicResource StudioAccentSecondaryBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="5,1">
                  <TextBlock Text="Override" FontSize="11"
                             Foreground="{DynamicResource StudioTextMutedBrush}" />
                </Border>
                <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding ToolTipText}"
                           VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource StudioTextBrush}" />
              </DockPanel>
              <TextBlock Grid.Column="2"
                         Text="{Binding AssetType}"
                         VerticalAlignment="Center"
                         FontSize="11"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource StudioTextMutedBrush}" />
              <TextBlock Grid.Column="3"
                         Text="{Binding SourceFile}"
                         ToolTip.Tip="{Binding SourceHint}"
                         VerticalAlignment="Center"
                         FontSize="11"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource StudioTextMutedBrush}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.Row="1"
                  IsVisible="{Binding !HasContentsRows}"
                  Margin="24"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="8">
        <materialIcons:MaterialIcon Kind="FileSearchOutline"
                                    Width="28"
                                    Height="28"
                                    HorizontalAlignment="Center"
                                    Foreground="{DynamicResource StudioTextSubtleBrush}" />
        <TextBlock Text="{Binding EmptyContentsText}"
                   FontSize="12"
                   Foreground="{DynamicResource StudioTextMutedBrush}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
