<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fastFileDetails="using:IW4.Studio.Desktop.Workbench.Tools.FastFileDetails"
             x:Class="IW4.Studio.Desktop.Workbench.Tools.FastFileDetails.FastFileDetailsToolView"
             x:DataType="fastFileDetails:FastFileDetailsToolViewModel"
             Classes="studioInspectorDetails"
             mc:Ignorable="d"
             d:DesignWidth="360"
             d:DesignHeight="760">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="12" Spacing="8">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding FileName}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource StudioTextBrush}" />
        <TextBlock Text="AUTHORED FASTFILE HEADER"
                   TextWrapping="Wrap"
                   FontSize="11"
                   FontWeight="Bold"
                   LetterSpacing="0.7"
                   Foreground="{DynamicResource StudioTextSubtleBrush}" />
      </StackPanel>

      <Border Padding="12"
              CornerRadius="6"
              Background="{DynamicResource StudioSurfaceSunkenBrush}"
              BorderBrush="{DynamicResource StudioBorderBrush}"
              BorderThickness="1">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="96,*" ColumnSpacing="8">
            <TextBlock Text="Magic" Classes="propertyLabel" />
            <TextBlock Grid.Column="1"
                       Text="{Binding Magic}"
                       Classes="propertyValue"
                       FontFamily="Consolas" />
          </Grid>

          <Grid ColumnDefinitions="96,*" ColumnSpacing="8">
            <TextBlock Text="Magic type" Classes="propertyLabel" />
            <TextBlock Grid.Column="1"
                       Text="{Binding MagicType}"
                       Classes="propertyValue" />
          </Grid>

          <Grid ColumnDefinitions="96,*" ColumnSpacing="8">
            <TextBlock Text="Version" Classes="propertyLabel" />
            <TextBlock Grid.Column="1"
                       Text="{Binding Version}"
                       Classes="propertyValue"
                       TextWrapping="Wrap" />
          </Grid>

          <CheckBox FontSize="12" IsChecked="{Binding AllowOnlineUpdate, Mode=TwoWay}"
                    Content="Allow online update" />

          <WrapPanel ItemSpacing="8" LineSpacing="3">
            <TextBlock Text="File Created On (UTC)"
                       MinWidth="96"
                       Classes="propertyLabel"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding FileCreatedOnUtc}"
                       Classes="propertyValue"
                       TextWrapping="Wrap" />
          </WrapPanel>

          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="3">
            <TextBlock Text="Languages" Classes="propertyLabel" />
            <TextBlock Grid.Row="1" Classes="propertyValue"
                       Text="{Binding SelectedLanguagesText}" TextWrapping="Wrap" />
            <Button Grid.Column="1" Grid.RowSpan="2" Content="Edit" Padding="10,3" MinHeight="28"
                    FontSize="12" CornerRadius="4"
                    VerticalAlignment="Center" AutomationProperties.Name="Edit fastfile languages">
              <Button.Flyout>
                <Flyout>
                  <ScrollViewer MinWidth="180" MaxHeight="320" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Languages}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="fastFileDetails:FastFileLanguageOptionViewModel">
                          <CheckBox Content="{Binding DisplayName}"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Flyout>
              </Button.Flyout>
            </Button>
          </Grid>

          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="3">
            <TextBlock Text="Streamed images" Classes="propertyLabel" TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Classes="propertyValue" Text="{Binding StreamedImageCount}" />
            <Button Grid.Column="1" Grid.RowSpan="2" Content="Open" Padding="10,3" MinHeight="28"
                    FontSize="12" CornerRadius="4" VerticalAlignment="Center"
                    AutomationProperties.Name="Open streamed images pane"
                    Command="{Binding ShowStreamedImagesCommand}" />
          </Grid>
        </StackPanel>
      </Border>

      <Border IsVisible="{Binding HasError}"
              Padding="10,8"
              CornerRadius="6"
              Background="{DynamicResource StudioErrorSurfaceBrush}"
              BorderBrush="{DynamicResource StudioErrorBorderBrush}"
              BorderThickness="1">
        <TextBlock Text="{Binding ErrorMessage}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource StudioErrorBrush}" />
      </Border>

      <TextBlock IsVisible="{Binding HasStatus}"
                 Text="{Binding StatusMessage}"
                 FontSize="11"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource StudioAccentBrush}" />

      <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
        <Button Content="Revert"
                FontSize="12" MinHeight="32" CornerRadius="4"
                Command="{Binding RevertCommand}"
                HorizontalAlignment="Stretch" />
        <Button Grid.Column="1"
                Content="Apply"
                FontSize="12" MinHeight="32" CornerRadius="4"
                Command="{Binding ApplyCommand}"
                Classes="primary"
                HorizontalAlignment="Stretch" />
      </Grid>

      <TextBlock Text="Use Save As to write applied changes to disk."
                 FontSize="11"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource StudioTextSubtleBrush}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
