<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:IW4.Studio.Desktop.Views"
        xmlns:viewModels="using:IW4.Studio.Desktop.ViewModels"
        xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="IW4.Studio.Desktop.Views.WelcomeWindow"
        x:DataType="viewModels:WelcomeViewModel"
        Title="IW4 Studio / Welcome" Width="760" MinWidth="500" MinHeight="324"
        WindowDecorationsTheme="{StaticResource StudioWindowDecorations}"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="44"
        Background="{DynamicResource StudioWindowGradientBrush}"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="WelcomeCharcoal">#151718</SolidColorBrush>
    <SolidColorBrush x:Key="WelcomeText">#E2E4E4</SolidColorBrush>
    <SolidColorBrush x:Key="WelcomeMuted">#A2A7A9</SolidColorBrush>
    <SolidColorBrush x:Key="WelcomeBorder">#343934</SolidColorBrush>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="TextBlock.folder">
      <Setter Property="FontFamily" Value="Menlo, Consolas, monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource StudioTextMutedBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Button.recentFile">
      <Setter Property="MinHeight" Value="54" />
      <Setter Property="Padding" Value="11,7" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="{StaticResource WelcomeCharcoal}" />
      <Setter Property="BorderBrush" Value="{StaticResource WelcomeBorder}" />
    </Style>
    <Style Selector="Button.recentFile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#242925" />
      <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentStrongBrush}" />
    </Style>
    <Style Selector="Button.recentFile:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#20251F" />
    </Style>
    <Style Selector="Border.sheet">
      <Setter Property="MaxWidth" Value="470" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="18,8" />
      <Setter Property="Padding" Value="20,16" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource StudioSurfaceOverlayBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 8 24 0 #48000000" />
    </Style>
    <Style Selector="Border.selectedMode">
      <Setter Property="Background" Value="{DynamicResource StudioAccentSurfaceBrush}" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="RadioButton.mode">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="MinHeight" Value="52" />
    </Style>
    <!-- The Fluent template puts the radio glyph in a top-aligned inner grid. -->
    <Style Selector="RadioButton.mode /template/ Grid > Grid">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.modeTitle">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="TextBlock.modeDescription">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource StudioTextMutedBrush}" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="44,*,Auto" Margin="{Binding $parent[Window].OffScreenMargin}">
    <Border Classes="studioTitleBar" Background="Transparent" WindowDecorationProperties.ElementRole="TitleBar">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
        <Border Width="26" Height="26" CornerRadius="5" ClipToBounds="True" VerticalAlignment="Center">
          <Image Source="/Resources/logo_simple.png" Stretch="UniformToFill" />
        </Border>
        <TextBlock Grid.Column="1" Text="IW4 Studio" FontSize="13" FontWeight="SemiBold"
                   IsVisible="{Binding !#WindowMenu.IsVisible}" VerticalAlignment="Center" />
        <Menu x:Name="WindowMenu" Grid.Column="1" Background="Transparent" FontSize="13"
              IsEnabled="{Binding CanInteract}" VerticalAlignment="Center" WindowDecorationProperties.ElementRole="User" />
        <TextBlock Grid.Column="2" Text="/" Opacity="0.6" VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Text="Welcome" FontSize="13" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" RowDefinitions="Auto,*" ColumnDefinitions="3*,2*"
          ClipToBounds="True" SizeChanged="WelcomeBody_SizeChanged">
      <views:WelcomeBackdrop Grid.RowSpan="2" Grid.ColumnSpan="2" />
      <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top"
                  IsEnabled="{Binding CanInteract}" Margin="18,14,18,14" Spacing="9">
        <Button x:Name="OpenFastFileButton" Classes="primary" Click="OpenFastFileButton_Click"
                AutomationProperties.Name="Open Fastfile">
          <StackPanel Orientation="Horizontal" Spacing="9">
            <icons:MaterialIcon Kind="FolderOpen" Width="16" Height="16" />
            <TextBlock Text="Open Fastfile…" VerticalAlignment="Center" FontSize="13" />
          </StackPanel>
        </Button>
        <Button Click="CreateNewButton_Click" AutomationProperties.Name="New Fastfile">
          <StackPanel Orientation="Horizontal" Spacing="9">
            <icons:MaterialIcon Kind="Plus" Width="16" Height="16" />
            <TextBlock Text="New Fastfile…" VerticalAlignment="Center" FontSize="13" />
          </StackPanel>
        </Button>
      </StackPanel>

      <ScrollViewer x:Name="RecentFilesScroll" Grid.Row="1" IsEnabled="{Binding CanInteract}"
                    HorizontalScrollBarVisibility="Disabled" Margin="18,0,12,16">
        <StackPanel Spacing="12">
          <Border IsVisible="{Binding HasError}" Padding="12,8" CornerRadius="6"
                  Background="{DynamicResource StudioErrorSurfaceBrush}"
                  BorderBrush="{DynamicResource StudioErrorBorderBrush}" BorderThickness="1">
            <StackPanel Spacing="3">
              <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource StudioErrorBrush}"
                         FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <StackPanel Spacing="8">
            <TextBlock Text="Recent fastfiles" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource WelcomeText}" />
            <TextBlock IsVisible="{Binding !HasRecentFiles}"
                       Text="No recent fastfiles."
                       Foreground="{StaticResource WelcomeMuted}" TextWrapping="Wrap" />
            <ItemsControl IsVisible="{Binding HasRecentFiles}" ItemsSource="{Binding RecentFiles}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="viewModels:RecentFastFileItem">
                  <Button Classes="recentFile" Tag="{Binding Path}" Click="RecentFileButton_Click"
                          ToolTip.Tip="{Binding Path}" AutomationProperties.Name="{Binding FileName}"
                          AutomationProperties.HelpText="{Binding Directory}">
                    <Grid ColumnDefinitions="32,*,16" ColumnSpacing="11">
                      <Border Height="34" CornerRadius="5" Background="#1D2020" VerticalAlignment="Center"
                              BorderThickness="1" BorderBrush="{StaticResource WelcomeBorder}">
                        <icons:MaterialIcon Kind="FileOutline" Width="18" Height="18" Foreground="{StaticResource WelcomeMuted}" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource WelcomeText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="folder" Text="{Binding Directory}" Foreground="{StaticResource WelcomeMuted}" />
                      </StackPanel>
                      <icons:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="16" Height="16"
                                          Foreground="{StaticResource WelcomeMuted}" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" Padding="18,8" Background="{StaticResource WelcomeCharcoal}"
            BorderThickness="0,1,0,0" BorderBrush="{StaticResource WelcomeBorder}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
        <Ellipse Width="5" Height="5" Fill="{DynamicResource StudioAccentStrongBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding PlatformLabel}" FontSize="12" Foreground="{DynamicResource StudioAccentStrongBrush}" />
        <TextBlock Grid.Column="2" Text="{Binding DesktopVersionLabel, StringFormat='IW4 Studio {0}'}"
                   FontSize="12" Foreground="{StaticResource WelcomeMuted}" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" Grid.RowSpan="2" IsVisible="{Binding IsChoosingMode}" Background="#72000000">
      <Border x:Name="ModeSheet" Classes="sheet" KeyboardNavigation.TabNavigation="Cycle">
        <StackPanel Spacing="10">
          <StackPanel Spacing="3">
            <TextBlock Text="{Binding SelectedFileName, StringFormat='Open {0}'}"
                       FontWeight="SemiBold" FontSize="20" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding SelectedFileName}" />
            <Grid ColumnDefinitions="16,*" ColumnSpacing="8">
              <icons:MaterialIcon Kind="FolderOutline" Width="16" Height="16"
                                  Foreground="{DynamicResource StudioTextMutedBrush}" />
              <TextBlock Grid.Column="1" Classes="folder" Text="{Binding SelectedDirectory}"
                         ToolTip.Tip="{Binding SelectedDirectory}" />
            </Grid>
          </StackPanel>

          <Border BorderThickness="0,1" BorderBrush="{DynamicResource StudioBorderBrush}" Padding="0,8">
            <StackPanel Spacing="2">
              <Grid>
                <Border Classes="selectedMode" IsVisible="{Binding #DependencyModeRadio.IsChecked}" />
                <RadioButton x:Name="DependencyModeRadio" Classes="mode" GroupName="OpenMode"
                             AutomationProperties.Name="With dependencies"
                             AutomationProperties.HelpText="Loads linked zones and streamed images.">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="modeTitle" Text="With dependencies" />
                    <TextBlock Classes="modeDescription" Text="Loads linked zones and streamed images." />
                  </StackPanel>
                </RadioButton>
              </Grid>
              <Grid>
                <Border Classes="selectedMode" IsVisible="{Binding #SingleModeRadio.IsChecked}" />
                <RadioButton x:Name="SingleModeRadio" Classes="mode" GroupName="OpenMode"
                             AutomationProperties.Name="This fastfile only">
                  <TextBlock Classes="modeTitle" Text="This fastfile only" />
                </RadioButton>
              </Grid>
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Click="CancelOpenButton_Click" />
            <Button Content="Open" Classes="primary" MinWidth="78" IsDefault="{Binding IsChoosingMode}"
                    Click="ConfirmOpenButton_Click" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="1" Grid.RowSpan="2" IsVisible="{Binding IsBusy}" Background="{DynamicResource StudioScrimBrush}">
      <Border Classes="sheet">
        <StackPanel Spacing="12">
          <TextBlock Text="Loading workspace" FontSize="18" FontWeight="SemiBold" />
          <ProgressBar Height="5" IsIndeterminate="True" Foreground="{DynamicResource StudioAccentBrush}" />
          <TextBlock Text="{Binding StatusText}" FontSize="13" TextWrapping="Wrap"
                     Foreground="{DynamicResource StudioTextMutedBrush}" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
