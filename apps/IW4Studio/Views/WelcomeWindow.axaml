<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="using:IW4.Studio.Desktop.ViewModels"
        xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="IW4.Studio.Desktop.Views.WelcomeWindow"
        x:DataType="viewModels:WelcomeViewModel"
        Title="IW4 Studio" Width="760" MinWidth="500" MinHeight="324"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="TextBlock.folder">
      <Setter Property="FontFamily" Value="Menlo, Consolas, monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource StudioTextMutedBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.sheet">
      <Setter Property="MaxWidth" Value="470" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="18,8" />
      <Setter Property="Padding" Value="20,16" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource StudioSurfaceOverlayBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 8 24 0 #48000000" />
    </Style>
    <Style Selector="Border.selectedMode">
      <Setter Property="Background" Value="{DynamicResource StudioAccentSurfaceBrush}" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="RadioButton.mode">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="MinHeight" Value="52" />
    </Style>
    <!-- The Fluent template puts the radio glyph in a top-aligned inner grid. -->
    <Style Selector="RadioButton.mode /template/ Grid > Grid">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.modeTitle">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="TextBlock.modeDescription">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource StudioTextMutedBrush}" />
    </Style>
  </Window.Styles>

  <Grid>
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" IsEnabled="{Binding CanInteract}">
      <Menu x:Name="WindowMenu" Height="30" />

      <Grid Grid.Row="1" Height="170" Background="Black" ClipToBounds="True">
        <Image Source="/Resources/welcome_ridge.png" Stretch="Fill" />
        <Image Source="/Resources/logo_simple.png" Width="160" Height="160"
               Margin="24,0" HorizontalAlignment="Left" VerticalAlignment="Center"
               AutomationProperties.Name="IW4 Studio" />
      </Grid>

      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="24,18,24,16" Spacing="12">
        <Button x:Name="OpenFastFileButton" Classes="primary" Click="OpenFastFileButton_Click"
                AutomationProperties.Name="Open Fastfile">
          <StackPanel Orientation="Horizontal" Spacing="9">
            <icons:MaterialIcon Kind="FolderOpen" Width="19" Height="19" />
            <TextBlock Text="Open Fastfile…" VerticalAlignment="Center" FontSize="15" />
          </StackPanel>
        </Button>
        <Button Click="CreateNewButton_Click" AutomationProperties.Name="New Fastfile">
          <StackPanel Orientation="Horizontal" Spacing="9">
            <icons:MaterialIcon Kind="Plus" Width="19" Height="19" />
            <TextBlock Text="New Fastfile…" VerticalAlignment="Center" FontSize="15" />
          </StackPanel>
        </Button>
      </StackPanel>

      <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,0,24,12" Spacing="12">
          <Border IsVisible="{Binding HasError}" Padding="12,8" CornerRadius="6"
                  Background="{DynamicResource StudioErrorSurfaceBrush}"
                  BorderBrush="{DynamicResource StudioErrorBorderBrush}" BorderThickness="1">
            <StackPanel Spacing="3">
              <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource StudioErrorBrush}"
                         FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <StackPanel Spacing="6">
            <TextBlock Text="Recent fastfiles" FontSize="18" FontWeight="SemiBold" />
            <TextBlock IsVisible="{Binding !HasRecentFiles}"
                       Text="Fastfiles you open or create will appear here."
                       Foreground="{DynamicResource StudioTextMutedBrush}" TextWrapping="Wrap" />
            <ItemsControl IsVisible="{Binding HasRecentFiles}" ItemsSource="{Binding RecentFiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="viewModels:RecentFastFileItem">
                  <Border BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="0,0,0,1">
                    <Button Classes="recentFile" Tag="{Binding Path}" Click="RecentFileButton_Click"
                            ToolTip.Tip="{Binding Path}" AutomationProperties.Name="{Binding FileName}"
                            AutomationProperties.HelpText="{Binding Directory}">
                      <Grid ColumnDefinitions="22,*,16" ColumnSpacing="12">
                        <icons:MaterialIcon Kind="FileOutline" Width="21" Height="21"
                                            Foreground="{DynamicResource StudioTextMutedBrush}" />
                        <StackPanel Grid.Column="1" Spacing="1">
                          <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="folder" Text="{Binding Directory}" />
                        </StackPanel>
                        <icons:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="16" Height="16"
                                            Foreground="{DynamicResource StudioTextMutedBrush}" />
                      </Grid>
                    </Button>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="4" Padding="24,10" BorderThickness="0,1,0,0"
              BorderBrush="{DynamicResource StudioBorderBrush}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding PlatformLabel}" FontSize="12"
                     Foreground="{DynamicResource StudioAccentBrush}" />
          <TextBlock Grid.Column="1" Text="{Binding DesktopVersionLabel, StringFormat='IW4 Studio {0}'}"
                     FontSize="12" Foreground="{DynamicResource StudioTextMutedBrush}" />
        </Grid>
      </Border>
    </Grid>

    <Grid IsVisible="{Binding IsChoosingMode}" Background="#72000000">
      <Border x:Name="ModeSheet" Classes="sheet" KeyboardNavigation.TabNavigation="Cycle">
        <StackPanel Spacing="10">
          <StackPanel Spacing="3">
            <TextBlock Text="{Binding SelectedFileName, StringFormat='Open {0}'}"
                       FontWeight="SemiBold" FontSize="20" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding SelectedFileName}" />
            <Grid ColumnDefinitions="16,*" ColumnSpacing="8">
              <icons:MaterialIcon Kind="FolderOutline" Width="16" Height="16"
                                  Foreground="{DynamicResource StudioTextMutedBrush}" />
              <TextBlock Grid.Column="1" Classes="folder" Text="{Binding SelectedDirectory}"
                         ToolTip.Tip="{Binding SelectedDirectory}" />
            </Grid>
          </StackPanel>

          <Border BorderThickness="0,1" BorderBrush="{DynamicResource StudioBorderBrush}" Padding="0,8">
            <StackPanel Spacing="2">
              <Grid>
                <Border Classes="selectedMode" IsVisible="{Binding #DependencyModeRadio.IsChecked}" />
                <RadioButton x:Name="DependencyModeRadio" Classes="mode" GroupName="OpenMode"
                             AutomationProperties.Name="With dependencies"
                             AutomationProperties.HelpText="Include available dependency zones and streamed images.">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="modeTitle" Text="With dependencies" />
                    <TextBlock Classes="modeDescription" Text="Include available dependency zones and streamed images." />
                  </StackPanel>
                </RadioButton>
              </Grid>
              <Grid>
                <Border Classes="selectedMode" IsVisible="{Binding #SingleModeRadio.IsChecked}" />
                <RadioButton x:Name="SingleModeRadio" Classes="mode" GroupName="OpenMode"
                             AutomationProperties.Name="This fastfile only"
                             AutomationProperties.HelpText="Inspect the assets stored in this fastfile.">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="modeTitle" Text="This fastfile only" />
                    <TextBlock Classes="modeDescription" Text="Inspect the assets stored in this fastfile." />
                  </StackPanel>
                </RadioButton>
              </Grid>
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Click="CancelOpenButton_Click" />
            <Button Content="Open" Classes="primary" MinWidth="78" IsDefault="{Binding IsChoosingMode}"
                    Click="ConfirmOpenButton_Click" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <Border IsVisible="{Binding IsBusy}" Background="{DynamicResource StudioScrimBrush}">
      <Border Classes="sheet">
        <StackPanel Spacing="12">
          <TextBlock Text="Loading workspace" FontSize="18" FontWeight="SemiBold" />
          <ProgressBar Height="5" IsIndeterminate="True" Foreground="{DynamicResource StudioAccentBrush}" />
          <TextBlock Text="{Binding StatusText}" FontSize="13" TextWrapping="Wrap"
                     Foreground="{DynamicResource StudioTextMutedBrush}" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
