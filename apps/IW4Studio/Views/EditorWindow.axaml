<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:composition="using:IW4.Studio.Desktop.Workbench.Composition"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="IW4.Studio.Desktop.Views.EditorWindow"
        x:DataType="composition:StudioWorkbenchViewModel"
        mc:Ignorable="d"
        d:DesignWidth="1440"
        d:DesignHeight="900"
        Title="IW4 Studio"
        WindowDecorationsTheme="{StaticResource StudioWindowDecorations}"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="700"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44"
        Background="{DynamicResource StudioWindowGradientBrush}"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector=":is(Window)[IsActive=True] Border#GlassShine">
      <Style.Animations>
        <Animation Duration="0:0:16" IterationCount="Infinite">
          <KeyFrame KeyTime="0:0:0">
            <Setter Property="TranslateTransform.Y" Value="-600" />
          </KeyFrame>
          <KeyFrame KeyTime="0:0:4" KeySpline="0.42,0,0.58,1">
            <Setter Property="TranslateTransform.Y" Value="600" />
          </KeyFrame>
          <KeyFrame KeyTime="0:0:6">
            <Setter Property="TranslateTransform.Y" Value="600" />
          </KeyFrame>
          <KeyFrame KeyTime="0:0:10" KeySpline="0.42,0,0.58,1">
            <Setter Property="TranslateTransform.Y" Value="-600" />
          </KeyFrame>
          <KeyFrame KeyTime="0:0:16">
            <Setter Property="TranslateTransform.Y" Value="-600" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="44,*,25" Margin="{Binding $parent[Window].OffScreenMargin}">
    <!-- Scale the shine and its travel together so it clears both edges at any window size. -->
    <Viewbox Grid.RowSpan="3" ZIndex="-1" Stretch="Fill" ClipToBounds="True" IsHitTestVisible="False">
      <Canvas Width="1000" Height="600">
        <Border x:Name="GlassShine" Width="1000" Height="600" Opacity="0.12">
          <Border.RenderTransform>
            <TranslateTransform Y="-600" />
          </Border.RenderTransform>
          <Border.Background>
            <!-- In canvas coordinates the band slopes down 1 unit for every 2 across. -->
            <LinearGradientBrush StartPoint="500,250" EndPoint="460,330">
              <GradientStop Offset="0" Color="Transparent" />
              <GradientStop Offset="0.42" Color="{DynamicResource StudioWindowGlowColor}" />
              <GradientStop Offset="0.52" Color="#FFFFFBEF" />
              <GradientStop Offset="0.60" Color="#4DFFFBEF" />
              <GradientStop Offset="1" Color="#00FFFBEF" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>
      </Canvas>
    </Viewbox>
    <Border Classes="studioTitleBar" Background="Transparent"
            WindowDecorationProperties.ElementRole="TitleBar">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
        <Border Width="26" Height="26" VerticalAlignment="Center" CornerRadius="5" ClipToBounds="True">
          <Image Source="/Resources/logo_simple.png" Stretch="UniformToFill" />
        </Border>
        <TextBlock Grid.Column="1" Text="IW4 Studio" FontSize="13" FontWeight="SemiBold"
                   IsVisible="{Binding !#WindowMenu.IsVisible}" VerticalAlignment="Center" />
        <Menu x:Name="WindowMenu" Grid.Column="1" VerticalAlignment="Center" Background="Transparent"
              FontSize="13" WindowDecorationProperties.ElementRole="User" />
        <TextBlock Grid.Column="2" Text="/" Opacity="0.6" VerticalAlignment="Center" />
        <Button Grid.Column="3" Classes="ghost" Padding="6,3" MinHeight="28" MaxWidth="330"
                VerticalAlignment="Center" WindowDecorationProperties.ElementRole="User"
                ToolTip.Tip="{Binding TargetPath}" AutomationProperties.Name="{Binding TargetFileName}">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <SelectableTextBlock Text="{Binding TargetPath}" MaxWidth="500" TextWrapping="Wrap" />
            </Flyout>
          </Button.Flyout>
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
            <materialIcons:MaterialIcon Kind="PackageVariantClosed" Width="15" Height="15" />
            <TextBlock Grid.Column="1" Text="{Binding TargetFileName}" FontSize="13"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <materialIcons:MaterialIcon Grid.Column="2" Kind="ChevronDown" Width="13" Height="13" />
          </Grid>
        </Button>
        <TextBlock x:Name="SaveProgressText" Grid.Column="4" Margin="6,0"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" />

        <StackPanel Grid.Column="5" VerticalAlignment="Center"
                    WindowDecorationProperties.ElementRole="User"
                    Orientation="Horizontal"
                    Spacing="9"
                    Name="ActionBar"
                    IsVisible="{Binding HasSelectedWeaponEditor}">
          <Button Classes="ghost"
                  MinHeight="32"
                  Padding="10,5"
                  IsEnabled="{Binding SelectedWeaponEditor.CanRevert}"
                  ToolTip.Tip="Revert weapon changes"
                  AutomationProperties.Name="Revert weapon changes"
                  Click="RevertWeaponDraftButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <materialIcons:MaterialIcon Kind="Undo" Width="16" Height="16" />
              <TextBlock Text="Revert" />
            </StackPanel>
          </Button>
          <Button Classes="primary"
                  MinHeight="32"
                  Padding="12,5"
                  IsEnabled="{Binding SelectedWeaponEditor.CanApply}"
                  ToolTip.Tip="Validate and apply all weapon changes"
                  AutomationProperties.Name="Apply weapon changes"
                  Click="ApplyWeaponDraftButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <materialIcons:MaterialIcon Kind="Check" Width="16" Height="16" />
              <TextBlock Text="Apply" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <composition:StudioWorkbenchView Grid.Row="1" />

    <Border Grid.Row="2" Padding="12,0">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="18">
        <ContentPresenter Classes="platformBadge" />
        <composition:WorkbenchActivityIndicator
            Grid.Column="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{Binding ActivityStatus.IsActive}"
            Label="{Binding ActivityStatus.Label}" />
        <TextBlock Grid.Column="2"
                   Text="{Binding ModeName}"
                   VerticalAlignment="Center"
                   FontSize="10"
                   Foreground="{DynamicResource StudioTextMutedBrush}" />
        <TextBlock Grid.Column="3"
                   Text="{Binding SearchResultText}"
                   VerticalAlignment="Center"
                   FontSize="10"
                   Foreground="{DynamicResource StudioTextMutedBrush}" />
      </Grid>
    </Border>
  </Grid>
</Window>
