<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="IW4.Studio.Desktop.App"
             Name="IW4 Studio">
  <Application.Resources>
    <ControlTheme x:Key="StudioWindowDecorations" TargetType="WindowDrawnDecorations"
                  BasedOn="{StaticResource {x:Type WindowDrawnDecorations}}">
      <!-- Studio windows draw their title beside the native caption buttons. -->
      <Style Selector="^ /template/ Panel#PART_TitleTextPanel">
        <Setter Property="Opacity" Value="0" />
      </Style>
    </ControlTheme>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <materialIcons:MaterialIconStyles />
    <StyleInclude Source="Editors/Gsc/GscCompletionStyles.axaml" />

    <Style Selector="ListBox.menuNavigator > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.referenceCandidates > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StudioControlSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentSecondaryBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource StudioBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
      <Setter Property="FontFamily" Value="{DynamicResource StudioFontFamily}" />
    </Style>

    <Style Selector="Border.studioTitleBar">
      <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style Selector=":is(Window)[IsExtendedIntoWindowDecorations=True]:not(Window[WindowState=FullScreen]) Border.studioTitleBar">
      <Setter Property="Padding" Value="{OnPlatform Default='12,0,198,0', macOS='82,0,12,0', x:TypeArguments=Thickness}" />
    </Style>
    
    <Style Selector="TabStrip > TabStripItem, TabControl > TabItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="MinHeight" Value="32" />
    </Style>

    <Style Selector="TextBlock.editorAccessBadge">
      <Setter Property="VerticalAlignment" Value="Center" />
      <!-- Center Inter's uppercase lettering within its line box. -->
      <Setter Property="RenderTransform" Value="translateY(1px)" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource StudioTextMutedBrush}" />
    </Style>

    <!-- Align Inter's visual text baseline with centered vector icons in icon-and-label rows. -->
    <Style Selector="Grid.iconTextRow > TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,1,0,0" />
    </Style>

    <Style Selector="Button">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource StudioControlBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="{DynamicResource StudioControlHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderStrongBrush}" />
    </Style>

    <Style Selector="Button:pressed">
      <Setter Property="Background" Value="{DynamicResource StudioControlPressedBrush}" />
    </Style>

    <Style Selector="Button:disabled">
      <Setter Property="Background" Value="{DynamicResource StudioControlDisabledBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderDisabledBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource StudioTextDisabledBrush}" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource StudioAccentStrongBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentStrongBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource StudioOnAccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="{DynamicResource StudioAccentHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentHoverBrush}" />
    </Style>

    <Style Selector="Button.primary:pressed">
      <Setter Property="Background" Value="{DynamicResource StudioAccentPressedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentPressedBrush}" />
    </Style>

    <Style Selector="Button.primary:disabled">
      <Setter Property="Background" Value="{DynamicResource StudioControlDisabledBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderDisabledBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource StudioTextDisabledBrush}" />
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button.ghost:pointerover">
      <Setter Property="Background" Value="{DynamicResource StudioControlHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StudioControlHoverBrush}" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="11,8" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="{DynamicResource StudioInputBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource StudioSelectionBrush}" />
      <Setter Property="SelectionForegroundBrush" Value="{DynamicResource StudioSelectionTextBrush}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBox:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource StudioFocusBrush}" />
    </Style>

    <Style Selector="TreeView">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="TreeViewItem">
      <Setter Property="MinHeight" Value="27" />
      <Setter Property="Padding" Value="2" />
    </Style>

    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource StudioControlSelectedBrush}" />
    </Style>

    <Style Selector="ToolTip">
      <Setter Property="Background" Value="{DynamicResource StudioSurfaceOverlayBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
  </Application.Styles>
</Application>
