<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:menu="using:IW4.Studio.Desktop.Editors.Menu"
             xmlns:menuVm="using:IW4.Studio.Desktop.ViewModels.Menu"
             x:Class="IW4.Studio.Desktop.Editors.Menu.MenuDesignerView"
             x:DataType="menuVm:MenuDesignerViewModel"
             mc:Ignorable="d"
             d:DesignWidth="980"
             d:DesignHeight="650">
  <Grid RowDefinitions="Auto,*">
    <Grid x:Name="CompactToolbar" IsVisible="False" ColumnDefinitions="Auto,*"
          ColumnSpacing="10" Margin="0,0,0,6">
      <Button x:Name="BrowseButton" Content="Browse items" Padding="10,4" MinHeight="30" Click="Browse_Click" />
      <TextBlock Grid.Column="1" Text="{Binding DocumentName}" FontSize="12"
                 TextWrapping="Wrap" VerticalAlignment="Center"
                 Foreground="{DynamicResource StudioTextMutedBrush}" />
    </Grid>
    <SplitView x:Name="Workspace" Grid.Row="1" DisplayMode="Inline" IsPaneOpen="True"
               OpenPaneLength="244" PaneBackground="{DynamicResource StudioSurfaceSunkenBrush}">
      <SplitView.Pane>
        <menu:MenuOutlineView />
      </SplitView.Pane>
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <menu:MenuPreviewView />
      </ScrollViewer>
    </SplitView>
  </Grid>
</UserControl>
