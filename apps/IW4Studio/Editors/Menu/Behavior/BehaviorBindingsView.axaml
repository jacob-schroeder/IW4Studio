<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behavior="using:IW4.Studio.Desktop.Editors.Menu.Behavior"
             x:Class="IW4.Studio.Desktop.Editors.Menu.Behavior.BehaviorBindingsView"
             x:DataType="behavior:BehaviorBindingsViewModel"
             mc:Ignorable="d"
             d:DesignWidth="680"
             d:DesignHeight="500">
  <Grid RowDefinitions="Auto,12,*">
    <StackPanel Spacing="3">
      <TextBlock Text="BINDINGS"
                 FontSize="10"
                 FontWeight="Bold"
                 LetterSpacing="0.8"
                 Foreground="{DynamicResource StudioTextSubtleBrush}" />
      <TextBlock Text="{Binding Summary}"
                 FontSize="10"
                 Foreground="{DynamicResource StudioTextMutedBrush}" />
    </StackPanel>

    <ScrollViewer Grid.Row="2"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="8">
        <ItemsControl ItemsSource="{Binding FixedBindings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="behavior:BehaviorFixedBindingViewModel">
              <Expander Margin="0,0,0,6"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                <Expander.Header>
                  <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding ExpectedType}" VerticalAlignment="Center" FontSize="10"
                                 Foreground="{DynamicResource StudioTextMutedBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Expression.FormulaSummary}"
                               ToolTip.Tip="{Binding Expression.FormulaSummary}"
                               TextTrimming="CharacterEllipsis"
                               FontSize="10"
                               Foreground="{DynamicResource StudioTextMutedBrush}" />
                  </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="5">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox Text="{Binding Expression.Formula, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding Expression.IsFormulaEditable}"
                             PlaceholderText="Formula (optional)"
                             AutomationProperties.Name="{Binding Title}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3">
                      <Button IsVisible="{Binding Expression.IsOpaqueImported}"
                              Command="{Binding Expression.BeginReplacementCommand}"
                              Content="Replace" ToolTip.Tip="Replace unsupported imported expression" />
                      <Button Content="Clear"
                              Command="{Binding ClearExpressionCommand}"
                              ToolTip.Tip="Clear expression" />
                    </StackPanel>
                  </Grid>
                  <behavior:BehaviorExpressionOperationPickerView DataContext="{Binding Expression}" />
                  <TextBlock Text="{Binding Expression.ResultKindText}"
                             IsVisible="{Binding Expression.HasExpression}"
                             FontSize="10" Foreground="{DynamicResource StudioAccentBrush}" />
                  <TextBlock Text="{Binding Expression.DiagnosticsText}"
                             IsVisible="{Binding Expression.HasDiagnostics}"
                             FontSize="10" TextWrapping="Wrap"
                             Foreground="{DynamicResource StudioErrorBrush}" />
                </StackPanel>
              </Expander>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <TextBlock Text="FLOAT BINDINGS"
                     VerticalAlignment="Center"
                     FontSize="10" FontWeight="Bold" LetterSpacing="0.8"
                     Foreground="{DynamicResource StudioTextSubtleBrush}" />
          <Button Grid.Column="1"
                  Classes="primary"
                  Content="Add float binding"
                  Command="{Binding AddFloatBindingCommand}" />
        </Grid>

        <ItemsControl ItemsSource="{Binding FloatBindings}"
                      IsVisible="{Binding HasFloatBindings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="behavior:BehaviorFloatBindingDraftViewModel">
              <Grid Margin="0,0,0,6" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <Expander HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                  <Expander.Header>
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding SelectedTarget.Label}" FontSize="12" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Expression.FormulaSummary}"
                                 ToolTip.Tip="{Binding Expression.FormulaSummary}"
                                 TextTrimming="CharacterEllipsis"
                                 FontSize="10"
                                 Foreground="{DynamicResource StudioTextMutedBrush}" />
                      <TextBlock Text="{Binding TargetErrorText}"
                                 IsVisible="{Binding HasTargetError}"
                                 TextWrapping="Wrap" FontSize="10"
                                 Foreground="{DynamicResource StudioErrorBrush}" />
                    </StackPanel>
                  </Expander.Header>
                  <StackPanel Spacing="5">
                    <ComboBox ItemsSource="{Binding Targets}"
                              SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                              IsEnabled="{Binding IsTargetEditable}"
                              HorizontalAlignment="Stretch"
                              AutomationProperties.Name="Float binding target" />
                    <StackPanel IsEnabled="{Binding IsTargetEditable}">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox Text="{Binding Expression.Formula, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding Expression.IsFormulaEditable}"
                                 PlaceholderText="Number or boolean"
                                 AutomationProperties.Name="Float binding formula" />
                        <Button Grid.Column="1"
                                IsVisible="{Binding Expression.IsOpaqueImported}"
                                Command="{Binding Expression.BeginReplacementCommand}"
                                Content="Replace" />
                      </Grid>
                      <behavior:BehaviorExpressionOperationPickerView DataContext="{Binding Expression}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Expression.ResultKindText}"
                               IsVisible="{Binding Expression.HasExpression}"
                               FontSize="10" Foreground="{DynamicResource StudioAccentBrush}" />
                    <TextBlock Text="{Binding Expression.DiagnosticsText}"
                               IsVisible="{Binding Expression.HasDiagnostics}"
                               FontSize="10" TextWrapping="Wrap"
                               Foreground="{DynamicResource StudioErrorBrush}" />
                    <TextBlock Text="{Binding ImportedTargetText}"
                               IsVisible="{Binding IsReadOnlyImportedTarget}"
                               FontSize="10" TextWrapping="Wrap"
                               Foreground="{DynamicResource StudioWarningBrush}" />
                  </StackPanel>
                </Expander>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Spacing="3">
                  <Button Width="25" Height="26" Padding="2"
                          IsEnabled="{Binding IsTargetEditable}"
                          Command="{Binding MoveUpCommand}"
                          ToolTip.Tip="Move float binding up"><TextBlock Text="↑" /></Button>
                  <Button Width="25" Height="26" Padding="2"
                          IsEnabled="{Binding IsTargetEditable}"
                          Command="{Binding MoveDownCommand}"
                          ToolTip.Tip="Move float binding down"><TextBlock Text="↓" /></Button>
                  <Button Width="25" Height="26" Padding="2" Command="{Binding RemoveCommand}" ToolTip.Tip="Delete float binding"><TextBlock Text="×" FontSize="14" /></Button>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Expander Header="Static dvar support"
                  IsVisible="{Binding ExpressionSupport.CanAppendStaticDvar}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch">
          <StackPanel Spacing="5">
            <TextBlock Text="Add a name to the menu’s shared static dvar table."
                       FontSize="10" TextWrapping="Wrap"
                       Foreground="{DynamicResource StudioTextMutedBrush}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBox Text="{Binding ExpressionSupport.NewStaticDvarName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       PlaceholderText="New static dvar name"
                       AutomationProperties.Name="New static dvar name" />
              <Button Grid.Column="1" Content="Add static dvar"
                      Command="{Binding ExpressionSupport.AddStaticDvarCommand}" />
            </Grid>
            <TextBlock Text="{Binding ExpressionSupport.Summary}"
                       FontSize="10" Foreground="{DynamicResource StudioAccentBrush}" />
            <TextBlock Text="{Binding ExpressionSupport.StaticDvarError}"
                       IsVisible="{Binding ExpressionSupport.HasStaticDvarError}"
                       FontSize="10" TextWrapping="Wrap"
                       Foreground="{DynamicResource StudioErrorBrush}" />
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
