<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behavior="using:IW4.Studio.Desktop.Editors.Menu.Behavior"
             x:Class="IW4.Studio.Desktop.Editors.Menu.Behavior.BehaviorKeyHandlersView"
             x:DataType="behavior:BehaviorKeyHandlersViewModel"
             mc:Ignorable="d"
             d:DesignWidth="680"
             d:DesignHeight="500">
  <Grid RowDefinitions="Auto,8,Auto,8,*,10,Auto">
    <StackPanel Spacing="3">
      <TextBlock Text="KEY HANDLERS"
                 FontSize="10"
                 FontWeight="Bold"
                 LetterSpacing="0.8"
                 Foreground="{DynamicResource StudioTextSubtleBrush}" />
      <TextBlock Text="{Binding Summary}"
                 FontSize="10"
                 Foreground="{DynamicResource StudioTextMutedBrush}" />
    </StackPanel>

    <Border Grid.Row="2"
            Padding="7,5"
            CornerRadius="4"
            IsVisible="{Binding HasTruncatedImportedTail}"
            Background="{DynamicResource StudioWarningSurfaceBrush}"
            BorderBrush="{DynamicResource StudioWarningBrush}"
            BorderThickness="1">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock Text="{Binding ImportedTailText}"
                   FontSize="9"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource StudioTextBrush}" />
        <Button Grid.Column="1"
                Content="Remove tail"
                Command="{Binding DiscardImportedTailCommand}"
                ToolTip.Tip="Discard the unresolved imported tail" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="4"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="HandlerList" ItemsSource="{Binding Handlers}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="behavior:BehaviorKeyHandlerDraftViewModel">
            <Grid Margin="0,0,0,6" ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <Expander HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                <Expander.Header>
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Heading}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource StudioTextBrush}" />
                    <TextBlock Text="{Binding Action.Summary}"
                               ToolTip.Tip="{Binding Action.Summary}"
                               TextTrimming="CharacterEllipsis"
                               FontSize="10"
                               Foreground="{DynamicResource StudioTextMutedBrush}" />
                    <TextBlock Text="{Binding KeyErrorText}"
                               IsVisible="{Binding HasKeyError}"
                               TextWrapping="Wrap"
                               FontSize="10"
                               Foreground="{DynamicResource StudioErrorBrush}" />
                  </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="8">
                  <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="8" RowSpacing="4">
                    <TextBlock Text="Input type" FontSize="11" />
                    <TextBlock Grid.Column="1" Text="Key" IsVisible="{Binding !IsCustomKey}" FontSize="11" />
                    <TextBlock Grid.Column="1" Text="Engine code" IsVisible="{Binding IsCustomKey}" FontSize="11" />
                    <ComboBox x:Name="InputType" Grid.Row="1" ItemsSource="{Binding KeyGroups}"
                              SelectedItem="{Binding KeyGroup, Mode=TwoWay}"
                              AutomationProperties.Name="Key handler input category" />
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              ItemsSource="{Binding KeyOptions}"
                              SelectedItem="{Binding SelectedKey, Mode=TwoWay}"
                              IsVisible="{Binding !IsCustomKey}"
                              IsTextSearchEnabled="True"
                              MaxDropDownHeight="300"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="Choose a key"
                              AutomationProperties.Name="Key handler input" />
                    <TextBox Grid.Row="1" Grid.Column="1"
                             IsVisible="{Binding IsCustomKey}"
                             Text="{Binding KeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Signed engine key code"
                             AutomationProperties.Name="Key handler custom code" />
                  </Grid>
                  <TextBlock Text="{Binding KeyGroupHint}" IsVisible="{Binding KeyGroupHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                             TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource StudioTextMutedBrush}" />
                  <behavior:BehaviorEventHandlerSetView DataContext="{Binding Action}" />
                </StackPanel>
              </Expander>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Spacing="3">
                <Button Width="25" Height="24" Padding="2" Command="{Binding MoveUpCommand}" ToolTip.Tip="Move key handler up"><TextBlock Text="↑" /></Button>
                <Button Width="25" Height="24" Padding="2" Command="{Binding MoveDownCommand}" ToolTip.Tip="Move key handler down"><TextBlock Text="↓" /></Button>
                <Button Width="25" Height="24" Padding="2" Command="{Binding RemoveCommand}" ToolTip.Tip="Delete key handler"><TextBlock Text="×" FontSize="14" /></Button>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Button Grid.Row="6"
            MinWidth="126"
            HorizontalAlignment="Left"
            Classes="primary"
            Content="Add key handler"
            Click="AddKeyHandler_Click"
            AutomationProperties.Name="Add key handler" />
  </Grid>
</UserControl>
