<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behavior="using:IW4.Studio.Desktop.Editors.Menu.Behavior"
        x:Class="IW4.Studio.Desktop.Editors.Menu.Behavior.MenuItemBehaviorBuilderWindow"
        x:DataType="behavior:MenuItemBehaviorBuilderSessionViewModel"
        Title="{Binding WindowTitle}"
        Width="1060"
        Height="760"
        MinWidth="860"
        MinHeight="620"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown"
        mc:Ignorable="d"
        d:DesignWidth="1060"
        d:DesignHeight="760">
  <Border Padding="22,18"
          Background="{DynamicResource StudioBackgroundBrush}">
    <Grid RowDefinitions="Auto,14,*,14,Auto">
      <StackPanel Spacing="3">
        <TextBlock Text="{Binding Heading}"
                   FontSize="19"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource StudioTextBrush}" />
        <TextBlock Text="{Binding ScopeText}"
                   TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding ScopeText}"
                   FontSize="10"
                   Foreground="{DynamicResource StudioTextMutedBrush}" />
      </StackPanel>

      <Grid Grid.Row="2"
            ColumnDefinitions="218,16,*">
        <Border Padding="9"
                CornerRadius="7"
                Background="{DynamicResource StudioSurfaceSunkenBrush}"
                BorderBrush="{DynamicResource StudioBorderBrush}"
                BorderThickness="1">
          <Grid RowDefinitions="Auto,8,*">
            <TextBlock Text="BEHAVIOR"
                       FontSize="9"
                       FontWeight="Bold"
                       LetterSpacing="0.8"
                       Foreground="{DynamicResource StudioTextSubtleBrush}" />
            <ListBox x:Name="NavigationList"
                     Grid.Row="2"
                     Classes="menuNavigator"
                     ItemsSource="{Binding NavigationItems}"
                     SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Behavior builder sections">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="behavior:MenuItemBehaviorBuilderNavigationItemViewModel">
                  <StackPanel Margin="3,4" Spacing="3">
                    <TextBlock Text="{Binding Title}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource StudioTextBrush}" />
                    <TextBlock Text="{Binding Summary}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource StudioTextBrush}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>

        <Border Grid.Column="2"
                Padding="15"
                CornerRadius="7"
                Background="{DynamicResource StudioControlBrush}"
                BorderBrush="{DynamicResource StudioBorderBrush}"
                BorderThickness="1">
          <Grid>
            <Grid IsVisible="{Binding IsEventsSelected}">
              <behavior:BehaviorEventHooksView DataContext="{Binding Events}" />
            </Grid>
            <Grid IsVisible="{Binding IsKeysSelected}">
              <behavior:BehaviorKeyHandlersView DataContext="{Binding Keys}" />
            </Grid>
            <Grid IsVisible="{Binding IsBindingsSelected}">
              <behavior:BehaviorBindingsView DataContext="{Binding Bindings}" />
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <Grid Grid.Row="4"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="12">
        <StackPanel Spacing="6"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusMessage}"
                     FontSize="9"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource StudioTextMutedBrush}"
                     AutomationProperties.Name="Behavior builder status" />
          <Border Padding="8,6"
                  CornerRadius="4"
                  IsVisible="{Binding HasValidationError}"
                  Background="{DynamicResource StudioErrorSurfaceBrush}"
                  BorderBrush="{DynamicResource StudioErrorBrush}"
                  BorderThickness="1">
            <ScrollViewer MaxHeight="92"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <TextBlock Text="{Binding ValidationMessage}"
                         FontSize="9"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource StudioErrorBrush}" />
            </ScrollViewer>
          </Border>
          <Border Padding="8,6"
                  CornerRadius="4"
                  IsVisible="{Binding IsDiscardConfirmationVisible}"
                  Background="{DynamicResource StudioWarningSurfaceBrush}"
                  BorderBrush="{DynamicResource StudioWarningBrush}"
                  BorderThickness="1">
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
              <TextBlock Text="Discard behavior changes?"
                         VerticalAlignment="Center"
                         FontSize="9"
                         Foreground="{DynamicResource StudioTextBrush}" />
              <Button MinWidth="82"
                      Height="27"
                      Padding="7,2"
                      Content="Keep editing"
                      Click="KeepEditingButton_Click" />
              <Button MinWidth="66"
                      Height="27"
                      Padding="7,2"
                      Content="Discard"
                      Click="DiscardButton_Click" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="8">
          <Button MinWidth="88"
                  Content="Cancel"
                  Click="CancelButton_Click"
                  AutomationProperties.Name="Cancel behavior editing" />
          <Button Classes="primary"
                  MinWidth="132"
                  Content="Apply behavior"
                  IsDefault="True"
                  IsEnabled="{Binding CanApply}"
                  Click="ApplyButton_Click"
                  ToolTip.Tip="Apply behavior changes"
                  AutomationProperties.Name="Apply behavior changes" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
