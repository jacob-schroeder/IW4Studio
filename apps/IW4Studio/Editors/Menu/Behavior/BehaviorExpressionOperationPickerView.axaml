<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behavior="using:IW4.Studio.Desktop.Editors.Menu.Behavior"
             x:Class="IW4.Studio.Desktop.Editors.Menu.Behavior.BehaviorExpressionOperationPickerView"
             x:DataType="behavior:BehaviorExpressionDraftViewModel"
             mc:Ignorable="d">
  <UserControl.Resources>
    <DataTemplate x:Key="OperationSelection" x:DataType="behavior:BehaviorExpressionOperationOption">
      <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
    </DataTemplate>
    <DataTemplate x:Key="OperationChoice" x:DataType="behavior:BehaviorExpressionOperationOption">
      <TextBlock Text="{Binding Label}" MaxWidth="420" TextWrapping="Wrap" />
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="ComboBox">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="MaxDropDownHeight" Value="300" />
    </Style>
  </UserControl.Styles>

  <StackPanel Margin="0,4,0,0" Spacing="5">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
      <ComboBox ItemsSource="{Binding OperationOptions}"
                SelectedItem="{Binding SelectedOperation, Mode=TwoWay}"
                ItemTemplate="{StaticResource OperationChoice}"
                SelectionBoxItemTemplate="{StaticResource OperationSelection}"
                PlaceholderText="Browse expression functions"
                ToolTip.Tip="{Binding SelectedOperation.Label}"
                AutomationProperties.Name="Expression operation catalog" />
      <Button Grid.Column="1"
              Content="{Binding TemplateActionText}"
              Command="{Binding UseOperationTemplateCommand}"
              ToolTip.Tip="{Binding TemplateActionToolTip}"
              AutomationProperties.Name="Use expression operation template" />
    </Grid>

    <StackPanel IsVisible="{Binding HasStaticDvars}" Spacing="5">
      <ComboBox ItemsSource="{Binding StaticDvarOperationOptions}"
                SelectedItem="{Binding SelectedStaticDvarOperation, Mode=TwoWay}"
                ItemTemplate="{StaticResource OperationChoice}"
                SelectionBoxItemTemplate="{StaticResource OperationSelection}"
                PlaceholderText="Static dvar operation"
                ToolTip.Tip="{Binding SelectedStaticDvarOperation.Label}"
                AutomationProperties.Name="Static dvar operation" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
        <ComboBox ItemsSource="{Binding StaticDvars}"
                  SelectedItem="{Binding SelectedStaticDvar, Mode=TwoWay}"
                  PlaceholderText="Static dvar"
                  ToolTip.Tip="{Binding SelectedStaticDvar.Label}"
                  AutomationProperties.Name="Static dvar support row">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="behavior:BehaviorStaticDvarOption">
              <TextBlock Text="{Binding Label}" MaxWidth="420" TextWrapping="Wrap" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
          <ComboBox.SelectionBoxItemTemplate>
            <DataTemplate x:DataType="behavior:BehaviorStaticDvarOption">
              <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
            </DataTemplate>
          </ComboBox.SelectionBoxItemTemplate>
        </ComboBox>
        <Button Grid.Column="1"
                Content="{Binding TemplateActionText}"
                Command="{Binding UseStaticDvarTemplateCommand}"
                ToolTip.Tip="{Binding TemplateActionToolTip}"
                AutomationProperties.Name="Use static dvar formula" />
      </Grid>
    </StackPanel>

    <Grid IsVisible="{Binding HasReusableExpressions}"
          ColumnDefinitions="*,Auto"
          ColumnSpacing="5">
      <ComboBox ItemsSource="{Binding ReusableExpressions}"
                SelectedItem="{Binding SelectedReusableExpression, Mode=TwoWay}"
                PlaceholderText="Reusable expression"
                ToolTip.Tip="{Binding SelectedReusableExpression.Label}"
                AutomationProperties.Name="Reusable expression support row" />
      <Button Grid.Column="1"
              Content="{Binding TemplateActionText}"
              Command="{Binding UseReusableExpressionTemplateCommand}"
              ToolTip.Tip="{Binding TemplateActionToolTip}"
              AutomationProperties.Name="Use reusable expression formula" />
    </Grid>

    <Expander Header="Formula help" FontSize="10">
      <TextBlock Text="Use quoted strings, numbers, parentheses, +, -, *, /, %, comparisons, &amp;&amp;, ||, !, and catalog functions. Static dvar choices use the menu’s existing rows. expressionRef(index) selects an existing reusable definition."
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource StudioTextMutedBrush}" />
    </Expander>
  </StackPanel>
</UserControl>
