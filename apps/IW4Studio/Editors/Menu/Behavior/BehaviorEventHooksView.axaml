<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behavior="using:IW4.Studio.Desktop.Editors.Menu.Behavior"
             x:Class="IW4.Studio.Desktop.Editors.Menu.Behavior.BehaviorEventHooksView"
             x:DataType="behavior:BehaviorEventHooksViewModel"
             mc:Ignorable="d"
             d:DesignWidth="680"
             d:DesignHeight="500">
  <Grid RowDefinitions="Auto,12,*">
    <StackPanel Spacing="3">
      <TextBlock Text="EVENT HOOKS"
                 FontSize="10"
                 FontWeight="Bold"
                 LetterSpacing="0.8"
                 Foreground="{DynamicResource StudioTextSubtleBrush}" />
      <TextBlock Text="{Binding Summary}"
                 FontSize="10"
                 Foreground="{DynamicResource StudioTextMutedBrush}" />
    </StackPanel>

    <ScrollViewer Grid.Row="2"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Slots}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="behavior:BehaviorEventSlotViewModel">
            <Expander Margin="0,0,0,6"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
              <Expander.Header>
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Title}"
                             FontSize="12"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource StudioTextBrush}" />
                  <TextBlock Text="{Binding HandlerSummary}"
                             ToolTip.Tip="{Binding HandlerSummary}"
                             TextTrimming="CharacterEllipsis"
                             FontSize="10"
                             Foreground="{DynamicResource StudioTextMutedBrush}" />
                </StackPanel>
              </Expander.Header>
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding Description}"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource StudioTextMutedBrush}" />
                <behavior:BehaviorEventHandlerSetView DataContext="{Binding Handlers}" />
              </StackPanel>
            </Expander>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
