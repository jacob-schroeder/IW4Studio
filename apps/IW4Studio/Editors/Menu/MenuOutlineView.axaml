<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:menuVm="using:IW4.Studio.Desktop.ViewModels.Menu"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="IW4.Studio.Desktop.Editors.Menu.MenuOutlineView"
             x:DataType="menuVm:MenuDesignerViewModel"
             mc:Ignorable="d"
             d:DesignWidth="980"
             d:DesignHeight="250">
  <UserControl.Styles>
    <Style Selector="TreeView.menuOutline TreeViewItem">
      <Setter Property="IsExpanded"
              Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
    </Style>
  </UserControl.Styles>

  <Border Padding="8"
          CornerRadius="7"
          Background="{DynamicResource StudioSurfaceSunkenBrush}"
          BorderBrush="{DynamicResource StudioBorderBrush}"
          BorderThickness="1">
    <Grid RowDefinitions="Auto,8,*,8,Auto">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="MENU OUTLINE"
                   VerticalAlignment="Center"
                   FontSize="9"
                   FontWeight="Bold"
                   LetterSpacing="0.8"
                   Foreground="{DynamicResource StudioTextSubtleBrush}" />
        <TextBlock Grid.Column="1"
                   Text="{Binding ItemCount, StringFormat='{}{0:N0} items'}"
                   FontSize="9"
                   Foreground="{DynamicResource StudioTextMutedBrush}" />
      </Grid>

      <TreeView Grid.Row="2"
                Classes="menuOutline"
                ItemsSource="{Binding OutlineRoots}"
                SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                AutomationProperties.Name="Menu item outline"
                AutoScrollToSelectedItem="True"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto">
        <TreeView.ItemTemplate>
          <TreeDataTemplate x:DataType="menuVm:MenuOutlineNodeViewModel"
                            ItemsSource="{Binding Children}">
            <Border MinHeight="24" Padding="0,3,4,3"
                    Background="Transparent"
                    ToolTip.Tip="{Binding Title}"
                    PointerReleased="OutlineRow_PointerReleased">
              <TextBlock Text="{Binding Title}"
                         FontSize="12" VerticalAlignment="Center"
                         TextWrapping="Wrap" MaxLines="2"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource StudioTextBrush}" />
            </Border>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>

      <StackPanel Grid.Row="2"
                  IsVisible="{Binding HasNoDocument}"
                  Margin="14"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="6">
        <materialIcons:MaterialIcon Kind="FileQuestionOutline"
                                     Width="24"
                                     Height="24"
                                     HorizontalAlignment="Center"
                                     Foreground="{DynamicResource StudioTextSubtleBrush}" />
        <TextBlock Text="No Menu definition"
                   TextAlignment="Center"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource StudioTextBrush}" />
      </StackPanel>

      <Grid Grid.Row="4" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*"
            RowSpacing="4" ColumnSpacing="4">
        <Grid.Styles>
          <Style Selector="Button">
            <Setter Property="MinHeight" Value="29" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
          </Style>
        </Grid.Styles>
        <Button Content="Add item"
                Command="{Binding AddItemCommand}"
                ToolTip.Tip="Add a Text item" />
        <Button Grid.Column="1" Content="Duplicate"
                Command="{Binding DuplicateItemCommand}"
                ToolTip.Tip="Duplicate selected item" />
        <Button Grid.Row="1" Content="Move up"
                Command="{Binding MoveItemUpCommand}"
                ToolTip.Tip="Move selected item up" />
        <Button Grid.Row="1" Grid.Column="1" Content="Move down"
                Command="{Binding MoveItemDownCommand}"
                ToolTip.Tip="Move selected item down" />
        <Button Grid.Row="2" Content="Change type…"
                IsEnabled="{Binding CanChangeSelectedItemType}"
                Click="ChangeItemTypeButton_Click"
                ToolTip.Tip="Choose another type for the selected item" />
        <Button Grid.Row="2" Grid.Column="1" Content="Remove"
                Command="{Binding RemoveItemCommand}"
                ToolTip.Tip="Remove selected item" />
      </Grid>
    </Grid>
  </Border>
</UserControl>
