<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:menu="using:IW4.Studio.Desktop.Editors.Menu"
             xmlns:menuVm="using:IW4.Studio.Desktop.ViewModels.Menu"
             x:Class="IW4.Studio.Desktop.Editors.Menu.MenuPreviewStateComparisonView"
             x:DataType="menuVm:MenuDesignerViewModel">
  <Expander Header="Compare states"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            IsExpanded="{Binding PreviewDebug.Comparison.IsExpanded, Mode=TwoWay}">
    <StackPanel Spacing="8">
      <WrapPanel Orientation="Horizontal">
        <Button Margin="0,0,6,0"
                Content="Pin current state as A"
                Command="{Binding PreviewDebug.Comparison.PinBaselineCommand}" />
        <Button IsVisible="{Binding PreviewDebug.Comparison.HasBaseline}"
                Content="Clear A"
                Command="{Binding PreviewDebug.Comparison.ClearBaselineCommand}" />
      </WrapPanel>
      <TextBlock Text="Pin a state, then change simulation values, time, or focus to compare with the live canvas."
                 IsVisible="{Binding !PreviewDebug.Comparison.HasBaseline}"
                 FontSize="11"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource StudioTextMutedBrush}" />

      <StackPanel IsVisible="{Binding PreviewDebug.Comparison.HasBaseline}" Spacing="8">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
          <Grid.Styles>
            <Style Selector="Border.comparisonCanvas">
              <Setter Property="Height" Value="135" />
              <Setter Property="ClipToBounds" Value="True" />
              <Setter Property="CornerRadius" Value="4" />
              <Setter Property="Background" Value="{DynamicResource StudioBackgroundBrush}" />
              <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
              <Setter Property="BorderThickness" Value="1" />
            </Style>
          </Grid.Styles>
          <StackPanel Spacing="5">
            <TextBlock Text="{Binding PreviewDebug.Comparison.BaselineHeading}"
                       FontSize="11"
                       FontWeight="SemiBold" />
            <Border Classes="comparisonCanvas">
              <menu:MenuPreviewControl Scene="{Binding PreviewDebug.Comparison.BaselineScene}"
                                       IsHitTestVisible="False"
                                       MaterialResolver="{Binding MaterialResolver}"
                                       TextResourceResolver="{Binding TextResourceResolver}" />
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="5">
            <TextBlock Text="B · Live"
                       FontSize="11"
                       FontWeight="SemiBold" />
            <Border Classes="comparisonCanvas">
              <menu:MenuPreviewControl Scene="{Binding PreviewDebug.Comparison.LiveScene}"
                                       IsHitTestVisible="False"
                                       MaterialResolver="{Binding MaterialResolver}"
                                       TextResourceResolver="{Binding TextResourceResolver}" />
            </Border>
          </StackPanel>
        </Grid>

        <StackPanel Spacing="5">
          <TextBlock Text="{Binding PreviewDebug.Comparison.DifferenceSummary}"
                     FontSize="11"
                     FontWeight="SemiBold" />
          <Grid Margin="10,0,10,0" ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <TextBlock Text="Item / menu" FontSize="10" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="A · Pinned" FontSize="10" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="B · Live" FontSize="10" FontWeight="SemiBold" />
          </Grid>
          <ListBox MaxHeight="180" Classes="studioNavigatorList menuNavigator"
                   ItemsSource="{Binding PreviewDebug.Comparison.Rows}"
                   SelectedItem="{Binding PreviewDebug.Comparison.SelectedRow, Mode=TwoWay}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   AutomationProperties.Name="Compared state by item">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="MinHeight" Value="28" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="menuVm:MenuPreviewStateComparisonRowViewModel">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                  <TextBlock Text="{Binding Title}"
                             ToolTip.Tip="{Binding Title}"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center"
                             FontSize="11" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding Baseline}"
                             ToolTip.Tip="{Binding Baseline}"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center"
                             FontSize="11"
                             Foreground="{DynamicResource StudioTextMutedBrush}" />
                  <Grid Grid.Column="2" ColumnDefinitions="Auto,*" ColumnSpacing="4">
                    <Border Width="5" Height="5" CornerRadius="3"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsChanged}"
                            Background="{DynamicResource StudioAccentBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Live}"
                               ToolTip.Tip="{Binding Live}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               FontSize="11" />
                  </Grid>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel IsVisible="{Binding PreviewDebug.Comparison.HasSelectedRow}" Spacing="4">
            <TextBlock Text="{Binding PreviewDebug.Comparison.SelectedRow.Rules}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource StudioTextMutedBrush}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <TextBlock Text="{Binding PreviewDebug.Comparison.SelectedRow.BaselineDetails}"
                         FontSize="10"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource StudioWarningBrush}" />
              <TextBlock Grid.Column="1"
                         Text="{Binding PreviewDebug.Comparison.SelectedRow.LiveDetails}"
                         FontSize="10"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource StudioWarningBrush}" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </Expander>
</UserControl>
