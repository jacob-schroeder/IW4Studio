<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:menu="using:IW4.Studio.Desktop.Editors.Menu"
             xmlns:menuVm="using:IW4.Studio.Desktop.ViewModels.Menu"
             x:Class="IW4.Studio.Desktop.Editors.Menu.MenuPreviewView"
             x:DataType="menuVm:MenuDesignerViewModel"
             mc:Ignorable="d"
             d:DesignWidth="980"
             d:DesignHeight="560">
  <UserControl.Resources>
    <!-- ReSharper disable once Xaml.RedundantResource -->
    <ContextMenu x:Key="PreviewItemContextMenu"
                 x:DataType="menuVm:MenuDesignerViewModel"
                 Placement="Pointer">
      <MenuItem Header="New"
                Command="{Binding AddItemCommand}" />
      <MenuItem Header="Duplicate"
                Command="{Binding DuplicateItemCommand}" />
      <MenuItem Header="Delete"
                Command="{Binding RemoveItemCommand}" />
    </ContextMenu>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,8,Auto,8,Auto,Auto,Auto">
    <Border MinHeight="220"
            CornerRadius="7"
            ClipToBounds="True"
            Background="{DynamicResource StudioSurfaceSunkenBrush}"
            BorderBrush="{DynamicResource StudioBorderBrush}"
            BorderThickness="1">
      <Grid RowDefinitions="Auto,*">
        <Grid Margin="11,8" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{Binding PreviewHeading}" FontSize="13" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource StudioTextBrush}" />
            <TextBlock Text="1280 × 720 · PS3 safe area" FontSize="10"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource StudioTextMutedBrush}" />
          </StackPanel>
          <ComboBox Grid.Column="1" MinWidth="118" VerticalAlignment="Center"
                    AutomationProperties.Name="Preview mode"
                    ToolTip.Tip="Choose how to inspect the menu on the canvas."
                    SelectedValueBinding="{ReflectionBinding Tag}"
                    SelectedValue="{Binding PreviewDebug.Mode, Mode=TwoWay}">
            <ComboBoxItem Content="Edit layout" Tag="{x:Static menuVm:MenuPreviewMode.Authored}" />
            <ComboBoxItem Content="Inspect state" Tag="{x:Static menuVm:MenuPreviewMode.Simulate}" />
          </ComboBox>
          <Button Grid.Column="2" Content="Play" ToolTip.Tip="Open an interactive menu in a separate window"
                  AutomationProperties.Name="Play menu in a separate window" VerticalAlignment="Center" MinHeight="30"
                  IsEnabled="{Binding HasDocument}" Click="Play_Click" />
        </Grid>

        <Grid Grid.Row="1"
              Margin="8,0,8,8"
              Background="{DynamicResource StudioBackgroundBrush}">
          <menu:MenuPreviewControl Scene="{Binding PreviewScene}"
                                   ShowTextBounds="{Binding #TextGuides.IsChecked}"
                                   SelectedNodeId="{Binding SelectedPreviewNodeId}"
                                   IsDirectManipulationEnabled="{Binding CanDirectManipulateSelectedItem}"
                                   MaterialResolver="{Binding MaterialResolver}"
                                   TextResourceResolver="{Binding TextResourceResolver}"
                                   NodeSelected="PreviewControl_NodeSelected"
                                   ContextRequested="PreviewControl_ContextRequested"
                                   GeometryCommitted="PreviewControl_GeometryCommitted"
                                   MaterialResolutionCompleted="PreviewControl_MaterialResolutionCompleted"
                                   TextResolutionCompleted="PreviewControl_TextResolutionCompleted" />

          <Border IsVisible="{Binding CanDirectManipulateSelectedItem}"
                  IsHitTestVisible="False"
                  Margin="8"
                  Padding="7,4"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  CornerRadius="4"
                  Background="{DynamicResource StudioSurfaceBrush}"
                  BorderBrush="{DynamicResource StudioBorderBrush}"
                  BorderThickness="1">
            <TextBlock Text="Drag to move · use handles to resize · Esc cancels"
                       FontSize="11"
                       Foreground="{DynamicResource StudioTextMutedBrush}" />
          </Border>
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="2"
          RowDefinitions="Auto,Auto" RowSpacing="6"
          ColumnDefinitions="*,*"
          ColumnSpacing="10">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding SelectionBreadcrumb}" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource StudioTextMutedBrush}" />
        <TextBlock Text="{Binding MenuValidationStatus}" ToolTip.Tip="{Binding MenuValidationDetails}"
                   FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource StudioTextBrush}" />
      </StackPanel>
      <TextBlock Grid.Column="1"
                 Text="{Binding PreviewStatus}"
                 ToolTip.Tip="{Binding PreviewDetails}"
                 FontSize="11" TextAlignment="Right" TextWrapping="Wrap"
                 Foreground="{DynamicResource StudioTextMutedBrush}" />
      <WrapPanel Grid.Row="1" Grid.ColumnSpan="2">
        <Button Classes="ghost" Padding="8,4" Margin="0,0,8,0"
                Content="Edit behavior…" IsEnabled="{Binding CanEditBehavior}"
                Click="EditBehavior_Click" />
        <CheckBox x:Name="TextGuides" IsChecked="True" IsVisible="{Binding HasSelectedText}"
                  VerticalAlignment="Center" Content="Text bounds" Margin="0,0,10,0"
                  ToolTip.Tip="Show the glyph bounds and baseline using the resolved IW4 font." />
        <TextBlock Text="{Binding SelectedTextDetails}" IsVisible="{Binding HasSelectedText}"
                   VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource StudioTextMutedBrush}" />
      </WrapPanel>
    </Grid>

    <Border Grid.Row="4"
            IsVisible="{Binding PreviewDebug.IsAuthored}"
            Padding="9,7"
            CornerRadius="7"
            Background="{DynamicResource StudioInfoSurfaceBrush}"
            BorderBrush="{DynamicResource StudioInfoBorderBrush}"
            BorderThickness="1">
      <StackPanel Spacing="2">
        <TextBlock Text="Edit layout shows conditional items."
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource StudioInfoBrush}" />
        <TextBlock Text="Inspect state shows their simulated visibility."
                   TextWrapping="Wrap"
                   FontSize="11"
                   Foreground="{DynamicResource StudioTextMutedBrush}" />
        <TextBlock IsVisible="{Binding PreviewDebug.HasSelectedAuthoredVisibilityExpression}"
                   Text="Selected item has a visibility expression."
                   TextWrapping="Wrap"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource StudioInfoBrush}" />
      </StackPanel>
    </Border>

    <Border Grid.Row="4"
            IsVisible="{Binding PreviewDebug.IsSimulating}"
            Padding="9,7"
            CornerRadius="7"
            Background="{DynamicResource StudioSurfaceBrush}"
            BorderBrush="{DynamicResource StudioBorderBrush}"
            BorderThickness="1">
      <Grid RowDefinitions="Auto,Auto,Auto">
        <StackPanel Spacing="8">
          <TextBlock Text="State inspector" FontSize="13" FontWeight="SemiBold" />
          <WrapPanel>
            <CheckBox Content="Run clock" IsChecked="{Binding PreviewDebug.RunClock, Mode=TwoWay}"
                      Margin="0,0,12,4" VerticalAlignment="Center"
                      ToolTip.Tip="Pause to inspect a frame or compare two states." />
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,4">
              <NumericUpDown Width="170" MinHeight="32"
                             Minimum="0" Maximum="2147483647" Increment="100" FormatString="0"
                             AutomationProperties.Name="Simulation time in milliseconds"
                             ToolTip.Tip="Enter a time in milliseconds to inspect that frame."
                             GotFocus="SimulationTime_GotFocus" LostFocus="SimulationTime_LostFocus"
                             Value="{Binding PreviewDebug.Simulation.Milliseconds, Mode=TwoWay}" />
              <TextBlock Text="ms" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>
            <Button Content="Reset state" Padding="9,4" Margin="0,0,0,4"
                    Command="{Binding PreviewDebug.ResetSimulatedStateCommand}"
                    ToolTip.Tip="Returns to the current inputs and runs the menu's On open handlers." />
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,0,0,4"
                        IsVisible="{Binding PreviewDebug.HasLoadBar}">
              <TextBlock Text="Fastfile loaded" VerticalAlignment="Center" FontSize="12" />
              <NumericUpDown Width="90" MinHeight="32" Minimum="0" Maximum="100" Increment="5"
                             AutomationProperties.Name="Fastfile loaded, percent"
                             Value="{Binding PreviewDebug.LoadPercent, Mode=TwoWay}" />
              <TextBlock Text="%" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>
          </WrapPanel>

          <WrapPanel>
            <TextBlock Text="{Binding PreviewDebug.Interaction.SelectionSummary}" TextWrapping="Wrap"
                       Margin="0,0,12,4" FontSize="11" FontWeight="SemiBold" />
            <TextBlock Text="{Binding PreviewDebug.FocusedItemSummary}" TextWrapping="Wrap"
                       Margin="0,0,12,4" FontSize="11"
                       Foreground="{DynamicResource StudioAccentSecondaryForegroundBrush}" />
            <TextBlock Text="{Binding PreviewDebug.SelectedEvaluationSummary}" TextWrapping="Wrap"
                       FontSize="11" Foreground="{DynamicResource StudioTextMutedBrush}" />
          </WrapPanel>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ComboBox MinHeight="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      ItemsSource="{Binding PreviewDebug.Interaction.Options}"
                      SelectedItem="{Binding PreviewDebug.Interaction.SelectedOption, Mode=TwoWay}"
                      AutomationProperties.Name="Event to run" PlaceholderText="No event for selection">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="menuVm:MenuPreviewInteractionOption">
                  <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" Content="Run event" Padding="9,4"
                    Command="{Binding PreviewDebug.Interaction.DispatchCommand}" />
          </Grid>
          <Button Content="Focus selected item" Padding="9,4"
                  Command="{Binding PreviewDebug.Interaction.FocusSelectedCommand}"
                  ToolTip.Tip="Runs the selected item's authored focus lifecycle." />
        </StackPanel>

        <Border Grid.Row="1"
                IsVisible="{Binding PreviewDebug.HasEvaluationIssues}"
                Margin="0,7,0,0"
                Padding="8,6"
                CornerRadius="4"
                Background="{DynamicResource StudioWarningSurfaceBrush}"
                BorderBrush="{DynamicResource StudioWarningBorderBrush}"
                BorderThickness="1">
          <Grid ColumnDefinitions="*,Auto"
                ColumnSpacing="8">
            <StackPanel VerticalAlignment="Center" Spacing="3">
              <TextBlock Text="{Binding PreviewDebug.EvaluationSummary}" TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource StudioWarningBrush}" />
              <TextBlock Text="{Binding PreviewDebug.Simulation.MissingInputSummary}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource StudioTextBrush}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Height="24"
                    Padding="9,2"
                    Content="Review values"
                    Command="{Binding PreviewDebug.Simulation.OpenConfigurationCommand}" />
          </Grid>
        </Border>

        <Expander Grid.Row="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  Margin="0,6,0,0"
                  Header="{Binding PreviewDebug.Simulation.ValuesHeading}"
                  IsExpanded="{Binding PreviewDebug.Simulation.IsConfigurationOpen, Mode=TwoWay}">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
            <Grid ColumnDefinitions="*,Auto"
                  Margin="0,4,0,5">
              <TextBlock Text="Needed values affect the current frame or event."
                         VerticalAlignment="Center"
                         TextWrapping="Wrap"
                         FontSize="11"
                         Foreground="{DynamicResource StudioTextMutedBrush}" />
              <Button Grid.Column="1"
                      MinHeight="32"
                      Margin="8,0,0,0"
                      Padding="9,2"
                      Content="Clear overrides"
                      Command="{Binding PreviewDebug.Simulation.ClearOverridesCommand}" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,0,0,6" Spacing="6"
                        IsVisible="{Binding PreviewDebug.Simulation.HasInputs}">
              <TextBox PlaceholderText="Find a value…" AutomationProperties.Name="Find a simulation value"
                       Text="{Binding PreviewDebug.Simulation.InputFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Text="No matching values" IsVisible="{Binding PreviewDebug.Simulation.NoMatchingInputs}"
                         Foreground="{DynamicResource StudioTextMutedBrush}" />
            </StackPanel>

            <ScrollViewer Grid.Row="2"
                          IsVisible="{Binding PreviewDebug.Simulation.HasInputs}"
                          MaxHeight="245" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding PreviewDebug.Simulation.FilteredInputs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="menuVm:MenuPreviewScenarioInputViewModel">
                    <Border Margin="0,2"
                            Padding="7,5"
                            CornerRadius="4"
                            Background="{DynamicResource StudioSurfaceSunkenBrush}">
                      <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto"
                            RowSpacing="4" ColumnSpacing="8">
                        <StackPanel VerticalAlignment="Center"
                                    Spacing="1">
                          <TextBlock Text="{Binding DisplayName}" ToolTip.Tip="{Binding Name}"
                                     TextWrapping="Wrap"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Foreground="{DynamicResource StudioTextBrush}" />
                          <TextBlock Text="{Binding Detail}"
                                     TextWrapping="Wrap"
                                     FontSize="11"
                                     Foreground="{DynamicResource StudioTextMutedBrush}" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                IsVisible="{Binding IsRequired}"
                                Padding="5,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                CornerRadius="3"
                                Background="{DynamicResource StudioWarningSurfaceBrush}"
                                BorderBrush="{DynamicResource StudioWarningBorderBrush}"
                                BorderThickness="1">
                          <TextBlock Text="NEEDED"
                                     FontSize="10"
                                     FontWeight="Bold"
                                     Foreground="{DynamicResource StudioWarningBrush}" />
                        </Border>

                        <ComboBox Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="{Binding Name}"
                                  IsVisible="{Binding IsBoolean}"
                                  MinHeight="32"
                                  ItemsSource="{Binding BooleanOptions}"
                                  SelectedItem="{Binding SelectedBoolean, Mode=TwoWay}" />
                        <NumericUpDown Grid.Row="1" AutomationProperties.Name="{Binding Name}"
                                       IsVisible="{Binding IsInteger}"
                                       MinHeight="32"
                                       Minimum="-2147483648"
                                       Maximum="2147483647"
                                       Increment="1"
                                       FormatString="0"
                                       Value="{Binding NumericValue, Mode=TwoWay}"
                                       ToolTip.Tip="Press Enter or leave the field to apply; Escape cancels."
                                       LostFocus="ScenarioStagedInput_LostFocus"
                                       KeyDown="ScenarioStagedInput_KeyDown" />
                        <NumericUpDown Grid.Row="1" AutomationProperties.Name="{Binding Name}"
                                       IsVisible="{Binding IsFloat}"
                                       MinHeight="32"
                                       Minimum="-79228162514264337593543950335"
                                       Maximum="79228162514264337593543950335"
                                       Increment="0.1"
                                       FormatString="0.######"
                                       Value="{Binding NumericValue, Mode=TwoWay}"
                                       ToolTip.Tip="Press Enter or leave the field to apply; Escape cancels."
                                       LostFocus="ScenarioStagedInput_LostFocus"
                                       KeyDown="ScenarioStagedInput_KeyDown" />
                        <TextBox Grid.Row="1" AutomationProperties.Name="{Binding Name}"
                                 IsVisible="{Binding IsText}"
                                 MinHeight="32"
                                 Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="{Binding ValueState}"
                                 ToolTip.Tip="Press Enter or leave the field to apply; Escape cancels."
                                 LostFocus="ScenarioStagedInput_LostFocus"
                                 KeyDown="ScenarioStagedInput_KeyDown" />

                        <StackPanel Grid.Row="1" Grid.Column="1" IsVisible="{Binding !IsBoolean}"
                                    Orientation="Horizontal"
                                    Spacing="5">
                          <Button IsVisible="{Binding IsText}"
                                  MinHeight="32"
                                  Padding="8,2"
                                  Content="Set empty"
                                  Command="{Binding SetEmptyCommand}"
                                  ToolTip.Tip="Supplies an explicit empty string; this is different from leaving the value unknown." />
                          <Button MinHeight="32"
                                  Padding="8,2"
                                  Content="Unset"
                                  Command="{Binding ClearCommand}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2"
                                    VerticalAlignment="Center"
                                    Spacing="1">
                          <TextBlock IsVisible="{Binding HasPendingValue}"
                                     Text="Pending · Enter to apply"
                                     TextWrapping="Wrap"
                                     FontSize="11"
                                     Foreground="{DynamicResource StudioAccentSecondaryForegroundBrush}" />
                          <TextBlock IsVisible="{Binding HasValidationError}"
                                     Text="{Binding ValidationMessage}"
                                     TextWrapping="Wrap"
                                     FontSize="11"
                                     Foreground="{DynamicResource StudioErrorBrush}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="3"
                    IsVisible="{Binding PreviewDebug.Simulation.HasUnsupportedInputs}"
                    Margin="0,5,0,0"
                    Padding="7,5"
                    CornerRadius="4"
                    Background="{DynamicResource StudioWarningSurfaceBrush}">
              <StackPanel Spacing="3">
                <TextBlock Text="Runtime-computed inputs"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource StudioWarningBrush}" />
                <ItemsControl ItemsSource="{Binding PreviewDebug.Simulation.UnsupportedInputLines}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 Foreground="{DynamicResource StudioTextMutedBrush}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Expander Grid.Row="4"
                      Margin="0,5,0,0"
                      Header="{Binding PreviewDebug.AdvancedEvaluationHeading}">
              <StackPanel Spacing="5">
                <TextBox MaxHeight="110"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="11"
                         Text="{Binding PreviewDebug.AdvancedEvaluationDetails}" />
                <TextBox MaxHeight="100"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="11"
                         Text="{Binding PreviewDebug.DependencyDetails}" />
              </StackPanel>
            </Expander>

            <StackPanel Grid.Row="5"
                        Margin="0,4,0,0"
                        Spacing="4">
              <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        IsVisible="{Binding PreviewDebug.Interaction.HasActivationDetails}">
                <Expander.Header><TextBlock Text="{Binding PreviewDebug.Interaction.ActivationSummary}" TextWrapping="Wrap" /></Expander.Header>
                <TextBox MaxHeight="125"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="11"
                         Text="{Binding PreviewDebug.Interaction.ActivationDetails}" />
              </Expander>
              <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        IsVisible="{Binding PreviewDebug.Interaction.HasResult}">
                <Expander.Header><TextBlock Text="{Binding PreviewDebug.Interaction.ResultSummary}" TextWrapping="Wrap" /></Expander.Header>
                <TextBox MaxHeight="125"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="11"
                         Text="{Binding PreviewDebug.Interaction.ResultDetails}" />
              </Expander>
            </StackPanel>
          </Grid>
        </Expander>
      </Grid>
    </Border>

    <menu:MenuPreviewStateComparisonView Grid.Row="6"
                                         Margin="0,8,0,0"
                                         IsVisible="{Binding PreviewDebug.IsSimulating}" />
  </Grid>
</UserControl>
