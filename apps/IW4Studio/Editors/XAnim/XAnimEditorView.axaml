<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:viewModels="using:IW4.Studio.Desktop.ViewModels"
             xmlns:xanim="using:IW4.Studio.Desktop.Editors.XAnim"
             xmlns:xmodel="using:IW4.Studio.Desktop.Editors.XModel"
             x:Class="IW4.Studio.Desktop.Editors.XAnim.XAnimEditorView"
             x:DataType="viewModels:XAnimPreviewViewModel"
             mc:Ignorable="d"
             d:DesignWidth="1080"
             d:DesignHeight="720">
  <Grid RowDefinitions="Auto,12,*">
    <Border Padding="14,10"
            CornerRadius="8"
            Background="{DynamicResource StudioSurfaceBrush}"
            BorderBrush="{DynamicResource StudioBorderBrush}"
            BorderThickness="1">
      <Grid>
        <StackPanel Spacing="3">
          <TextBlock Text="{Binding Name}"
                     FontSize="17"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource StudioTextBrush}"
                     TextTrimming="CharacterEllipsis" />
          <StackPanel Orientation="Horizontal"
                      Spacing="8">
            <TextBlock Text="{Binding BoneCountText}"
                       FontSize="10"
                       Foreground="{DynamicResource StudioTextMutedBrush}" />
            <TextBlock Text="·"
                       FontSize="10"
                       Foreground="{DynamicResource StudioTextSubtleBrush}" />
            <TextBlock Text="{Binding FrameCountText}"
                       FontSize="10"
                       Foreground="{DynamicResource StudioTextMutedBrush}" />
            <TextBlock Text="·"
                       FontSize="10"
                       Foreground="{DynamicResource StudioTextSubtleBrush}" />
            <TextBlock Text="{Binding FramerateText}"
                       FontSize="10"
                       Foreground="{DynamicResource StudioTextMutedBrush}" />
            <TextBlock Text="·"
                       FontSize="10"
                       Foreground="{DynamicResource StudioTextSubtleBrush}" />
            <TextBlock Text="{Binding LoopText}"
                       FontSize="10"
                       Foreground="{DynamicResource StudioTextMutedBrush}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            CornerRadius="8"
            ClipToBounds="True"
            Background="{DynamicResource StudioSurfaceSunkenBrush}"
            BorderBrush="{DynamicResource StudioBorderBrush}"
            BorderThickness="1">
      <Grid RowDefinitions="50,1,*,1,78">
        <Grid Margin="14,0"
              ColumnDefinitions="*,12,Auto"
              VerticalAlignment="Center">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding HasReferences}">
            <TextBlock Text="Used by" VerticalAlignment="Center"
                       Foreground="{DynamicResource StudioTextMutedBrush}" />
            <ComboBox Grid.Column="1" MaxWidth="520" MinHeight="32"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      IsVisible="{Binding HasMultipleReferences}"
                      ItemsSource="{Binding References}"
                      SelectedItem="{Binding SelectedReference, Mode=TwoWay}"
                      AutomationProperties.Name="Animation reference"
                      ToolTip.Tip="{Binding ReferenceDetail}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="xanim:XAnimPreviewReference">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Source}" FontSize="10" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource StudioTextMutedBrush}" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Column="1" Text="{Binding SelectedReference.Name}"
                       IsVisible="{Binding !HasMultipleReferences}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ReferenceDetail}"
                       Foreground="{DynamicResource StudioTextBrush}" />
          </Grid>
          <TextBlock Text="Local bone motion" IsVisible="{Binding ShowBoneHeading}"
                     VerticalAlignment="Center" FontWeight="SemiBold"
                     Foreground="{DynamicResource StudioTextBrush}" />

          <CheckBox Grid.Column="2"
                    Content="Skeleton"
                    VerticalAlignment="Center"
                    IsVisible="{Binding CanToggleSkeleton}"
                    IsChecked="{Binding ShowSkeleton, Mode=TwoWay}"
                    ToolTip.Tip="Show the animated skeleton instead of the selected model" />
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource StudioBorderBrush}" />

        <Grid Grid.Row="2">
          <xmodel:XModelPreviewControl x:Name="Preview"
                                      Scene="{Binding ModelScene}"
                                      AnimationPose="{Binding Pose}"
                                      CameraPreset="{Binding CameraPreset}"
                                      IsVisible="{Binding ShowModelView}"
                                      UseCheckerboard="False"
                                      UseStudioEnvironment="True" />

          <Border x:Name="PreviewInputSurface"
                  Background="Transparent"
                  IsVisible="{Binding ShowModelView}"
                  AutomationProperties.Name="Animation model viewport input surface"
                  ToolTip.Tip="Left-drag to orbit; right- or middle-drag to pan; scroll to zoom" />

          <xanim:XAnimSkeletonPreviewControl Scene="{Binding PoseScene}"
                                             Pose="{Binding Pose}"
                                             IsVisible="{Binding ShowSkeletonView}" />

          <ScrollViewer x:Name="BoneTrackScroller"
                        IsVisible="{Binding ShowBoneTracks}"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        AutomationProperties.Name="Animated bone tracks">
            <xanim:XAnimBoneTracksControl AnimationClip="{Binding BoneTracksClip}"
                                          MinHeight="{Binding #BoneTrackScroller.Viewport.Height}"
                                          Frame="{Binding CurrentFrame}" />
          </ScrollViewer>

          <Border x:Name="PreviewUnavailableOverlay"
                  MaxWidth="560"
                  Margin="24"
                  Padding="18,14"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsHitTestVisible="False"
                  CornerRadius="7"
                  Background="{DynamicResource StudioSurfaceOverlayBrush}"
                  BorderBrush="{DynamicResource StudioBorderBrush}"
                  BorderThickness="1">
            <StackPanel Spacing="7">
              <materialIcons:MaterialIcon Kind="AnimationPlayOutline"
                                          Width="28"
                                          Height="28"
                                          HorizontalAlignment="Center"
                                          Foreground="{DynamicResource StudioTextSubtleBrush}" />
              <TextBlock x:Name="PreviewUnavailableTitleText"
                         HorizontalAlignment="Center"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource StudioTextBrush}" />
              <TextBlock x:Name="PreviewUnavailableReasonText"
                         HorizontalAlignment="Center"
                         TextAlignment="Center"
                         TextWrapping="Wrap"
                         FontSize="9"
                         Foreground="{DynamicResource StudioTextMutedBrush}" />
            </StackPanel>
          </Border>

          <Button Margin="12"
                  Padding="8,5"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Classes="ghost"
                  IsVisible="{Binding ShowModelView}"
                  Click="FitButton_Click"
                  ToolTip.Tip="Fit the complete model in view">
            <Grid Classes="iconTextRow"
                  ColumnDefinitions="Auto,5,Auto">
              <materialIcons:MaterialIcon Kind="FitToPageOutline"
                                          Width="15"
                                          Height="15" />
              <TextBlock Grid.Column="2"
                         Text="Fit"
                         FontSize="9" />
            </Grid>
          </Button>

          <Border Margin="12"
                  Padding="8,4"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  IsHitTestVisible="False"
                  IsVisible="{Binding ShowSkeletonView}"
                  CornerRadius="4"
                  Background="#C816191F"
                  BorderBrush="#506D7683"
                  BorderThickness="1">
            <TextBlock Text="GREEN · ANIMATED TRACK   GRAY · BIND POSE"
                       FontSize="8"
                       FontWeight="SemiBold"
                       LetterSpacing="0.35"
                       Foreground="#CDD5DF" />
          </Border>
        </Grid>

        <Border Grid.Row="3"
                Background="{DynamicResource StudioBorderBrush}" />

        <Grid Grid.Row="4"
              Margin="14,10"
              ColumnDefinitions="Auto,8,Auto,16,*,16,Auto"
              VerticalAlignment="Center">
          <Button Width="38"
                  Height="38"
                  MinWidth="38"
                  MinHeight="38"
                  Padding="0"
                  CornerRadius="19"
                  Classes="primary"
                  IsEnabled="{Binding CanPlay}"
                  ToolTip.Tip="{Binding PlayPauseToolTip}"
                  Click="PlayPauseButton_Click">
            <Grid>
              <materialIcons:MaterialIcon Kind="PlayCircleOutline"
                                          Width="21"
                                          Height="21"
                                          IsVisible="{Binding ShowPlayIcon}" />
              <materialIcons:MaterialIcon Kind="PauseCircleOutline"
                                          Width="21"
                                          Height="21"
                                          IsVisible="{Binding ShowPauseIcon}" />
            </Grid>
          </Button>

          <Button Grid.Column="2"
                  Width="38"
                  Height="38"
                  MinWidth="38"
                  MinHeight="38"
                  Padding="0"
                  CornerRadius="19"
                  Classes="ghost"
                  IsEnabled="{Binding CanRestart}"
                  ToolTip.Tip="Restart animation preview"
                  Click="RestartButton_Click">
            <materialIcons:MaterialIcon Kind="Restart"
                                        Width="19"
                                        Height="19" />
          </Button>

          <Grid Grid.Column="4"
                RowDefinitions="Auto,7,Auto">
            <ProgressBar Height="5"
                         Minimum="0"
                         Maximum="1"
                         Value="{Binding Progress}" />
            <TextBlock Grid.Row="2"
                       Text="{Binding PlaybackStatus}"
                       FontSize="9"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource StudioTextMutedBrush}" />
          </Grid>

          <StackPanel Grid.Column="6"
                      MinWidth="150"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Right"
                      Spacing="2">
            <TextBlock Text="{Binding CurrentFrameText}"
                       HorizontalAlignment="Right"
                       FontFamily="Consolas"
                       FontSize="10"
                       Foreground="{DynamicResource StudioTextBrush}" />
            <TextBlock Text="{Binding TimeText}"
                       HorizontalAlignment="Right"
                       FontFamily="Consolas"
                       FontSize="9"
                       Foreground="{DynamicResource StudioTextMutedBrush}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
