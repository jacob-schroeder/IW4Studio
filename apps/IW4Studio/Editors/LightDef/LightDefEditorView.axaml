<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:editors="using:IW4.Studio.Desktop.Editors"
             xmlns:viewModels="using:IW4.Studio.Desktop.ViewModels"
             x:Class="IW4.Studio.Desktop.Editors.LightDef.LightDefEditorView"
             x:DataType="viewModels:LightDefEditorViewModel"
             mc:Ignorable="d"
             d:DesignWidth="1080"
             d:DesignHeight="720">
  <Grid RowDefinitions="Auto,10,Auto,10,*">
    <Border Padding="14,10"
            CornerRadius="8"
            Background="{DynamicResource StudioSurfaceBrush}"
            BorderBrush="{DynamicResource StudioBorderBrush}"
            BorderThickness="1">
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="16">
        <StackPanel Spacing="3">
          <TextBlock Text="{Binding Name}"
                     FontSize="17"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource StudioTextBrush}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Text="Reusable attenuation profile for dynamic point and spot lights"
                     FontSize="10"
                     Foreground="{DynamicResource StudioTextMutedBrush}" />
        </StackPanel>

        <Border Grid.Column="1"
                Padding="9,4"
                CornerRadius="4"
                VerticalAlignment="Center"
                Background="{DynamicResource StudioSurfaceSunkenBrush}"
                BorderBrush="{DynamicResource StudioBorderBrush}"
                BorderThickness="1">
          <TextBlock Text="READ ONLY"
                     FontSize="9"
                     FontWeight="SemiBold"
                     LetterSpacing="0.5"
                     Foreground="{DynamicResource StudioTextMutedBrush}" />
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Padding="12,9"
            CornerRadius="8"
            Background="{DynamicResource StudioSurfaceBrush}"
            BorderBrush="{DynamicResource StudioBorderBrush}"
            BorderThickness="1">
      <Grid ColumnDefinitions="Auto,12,*">
        <TextBlock Text="ENGINE PURPOSE"
                   FontSize="9"
                   FontWeight="Bold"
                   LetterSpacing="0.7"
                   Foreground="{DynamicResource StudioTextSubtleBrush}" />
        <TextBlock Grid.Column="2"
                   Text="{Binding PurposeText}"
                   TextWrapping="Wrap"
                   FontSize="10"
                   Foreground="{DynamicResource StudioTextMutedBrush}" />
      </Grid>
    </Border>

    <Grid Grid.Row="4"
          ColumnDefinitions="*,12,340">
      <Border CornerRadius="8"
              ClipToBounds="True"
              Background="{DynamicResource StudioSurfaceSunkenBrush}"
              BorderBrush="{DynamicResource StudioBorderBrush}"
              BorderThickness="1">
        <Grid RowDefinitions="38,*,Auto">
          <Border Padding="11,0"
                  Background="{DynamicResource StudioSurfaceBrush}"
                  BorderBrush="{DynamicResource StudioBorderBrush}"
                  BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="8">
              <TextBlock Text="MAGNIFIED ATTENUATION LOOKUP"
                         VerticalAlignment="Center"
                         FontSize="9"
                         FontWeight="Bold"
                         LetterSpacing="0.7"
                         Foreground="{DynamicResource StudioTextSubtleBrush}" />
              <TextBlock Grid.Column="2"
                         Text="{Binding PreviewStatus}"
                         MaxWidth="380"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         FontSize="9"
                         Foreground="{DynamicResource StudioTextMutedBrush}" />
            </Grid>
          </Border>

          <Grid Grid.Row="1"
                Margin="18">
            <Border IsVisible="{Binding HasPreview}"
                    MinHeight="260"
                    Background="#FF050607"
                    BorderBrush="{DynamicResource StudioBorderBrush}"
                    BorderThickness="1">
              <Image Source="{Binding AttenuationPreview}"
                     Stretch="Fill"
                     IsHitTestVisible="False"
                     AutomationProperties.Name="Magnified light attenuation lookup"
                     AutomationProperties.HelpText="{Binding PreviewStatus}" />
            </Border>

            <StackPanel IsVisible="{Binding IsPreviewLoading}"
                        Width="280"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="9">
              <ProgressBar Height="3"
                           IsIndeterminate="True" />
              <TextBlock Text="Loading attenuation image…"
                         TextAlignment="Center"
                         FontSize="10"
                         Foreground="{DynamicResource StudioTextMutedBrush}" />
            </StackPanel>

            <StackPanel IsVisible="{Binding ShowsPreviewUnavailable}"
                        MaxWidth="440"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
              <TextBlock Text="Attenuation preview unavailable"
                         TextAlignment="Center"
                         FontSize="13"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource StudioTextBrush}" />
              <TextBlock Text="{Binding PreviewDetails}"
                         TextAlignment="Center"
                         TextWrapping="Wrap"
                         FontSize="10"
                         Foreground="{DynamicResource StudioTextMutedBrush}" />
            </StackPanel>
          </Grid>

          <Border Grid.Row="2"
                  Padding="11,8"
                  Background="{DynamicResource StudioSurfaceBrush}"
                  BorderBrush="{DynamicResource StudioBorderBrush}"
                  BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding PreviewDetails}"
                       TextWrapping="Wrap"
                       FontSize="9"
                       Foreground="{DynamicResource StudioTextSubtleBrush}" />
          </Border>
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="2"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10">
          <Border Padding="12,10"
                  CornerRadius="8"
                  Background="{DynamicResource StudioSurfaceBrush}"
                  BorderBrush="{DynamicResource StudioBorderBrush}"
                  BorderThickness="1">
            <StackPanel Spacing="9">
              <TextBlock Text="LIGHTDEF DATA"
                         FontSize="9"
                         FontWeight="Bold"
                         LetterSpacing="0.7"
                         Foreground="{DynamicResource StudioTextSubtleBrush}" />
              <ItemsControl ItemsSource="{Binding EditorProperties}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="editors:AssetEditorProperty">
                    <Grid Margin="0,0,0,7"
                          ColumnDefinitions="118,*"
                          ColumnSpacing="9">
                      <TextBlock Text="{Binding Name}"
                                 FontSize="9"
                                 Foreground="{DynamicResource StudioTextSubtleBrush}" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding Value}"
                                 TextWrapping="Wrap"
                                 FontSize="9"
                                 FontFamily="Consolas"
                                 Foreground="{DynamicResource StudioTextMutedBrush}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Padding="12,10"
                  CornerRadius="8"
                  Background="{DynamicResource StudioSurfaceBrush}"
                  BorderBrush="{DynamicResource StudioBorderBrush}"
                  BorderThickness="1">
            <StackPanel Spacing="7">
              <TextBlock Text="SHADER LOOKUP PLACEMENT"
                         FontSize="9"
                         FontWeight="Bold"
                         LetterSpacing="0.7"
                         Foreground="{DynamicResource StudioTextSubtleBrush}" />
              <TextBlock Text="{Binding LookupPlacementText}"
                         FontSize="11"
                         FontFamily="Consolas"
                         Foreground="{DynamicResource StudioTextBrush}" />
              <TextBlock Text="{Binding LookupPlacementDetailsText}"
                         TextWrapping="Wrap"
                         FontSize="9"
                         Foreground="{DynamicResource StudioTextMutedBrush}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
