<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:IW4.Studio.Desktop.Editors.PhysPreset"
             xmlns:vm="using:IW4.Studio.Desktop.ViewModels"
             xmlns:inspector="using:IW4.Studio.Desktop.Editors.Inspector"
             xmlns:documents="using:IW4.Studio.Documents"
             x:Class="IW4.Studio.Desktop.Editors.PhysPreset.PhysPresetEditorView"
             x:DataType="vm:PhysPresetEditorViewModel">
  <UserControl.Styles>
    <Style Selector="ContentControl.numericField">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Expander">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="6,3" />
    </Style>
  </UserControl.Styles>
  <UserControl.DataTemplates>
    <DataTemplate DataType="{x:Type inspector:InspectorFloatPropertyRowViewModel}"
                  x:DataType="inspector:InspectorFloatPropertyRowViewModel">
      <Grid ColumnDefinitions="Auto,*,90" ColumnSpacing="8">
        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
        <Slider Grid.Column="1" Minimum="{Binding SliderMinimum}" Maximum="{Binding SliderMaximum}"
                Value="{Binding SliderValue, Mode=TwoWay}" TickFrequency="{Binding SliderTickFrequency}"
                IsVisible="{Binding HasSlider}" IsEnabled="{Binding IsEditable}"
                AutomationProperties.Name="{Binding Label}" />
        <TextBox Grid.Column="2" Text="{Binding Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 IsReadOnly="{Binding IsReadOnly}" IsEnabled="{Binding !IsInteractionBlocked}"
                 AutomationProperties.Name="{Binding Label}" />
      </Grid>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
    <Border Background="{DynamicResource StudioSurfaceBrush}" BorderBrush="{DynamicResource StudioBorderBrush}"
            BorderThickness="1" CornerRadius="8" Padding="12,8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <StackPanel>
          <TextBlock Text="PhysPreset" FontSize="11" Foreground="{DynamicResource StudioTextMutedBrush}" />
          <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="{DynamicResource StudioTextMutedBrush}" />
          <Button Classes="ghost" Content="Revert" IsVisible="{Binding IsEditable}" IsEnabled="{Binding HasUnappliedChanges}"
                  ToolTip.Tip="Discard edits since the last Apply" Click="Revert_Click" />
          <Button Classes="primary" Content="Apply" IsVisible="{Binding IsEditable}" IsEnabled="{Binding CanApply}"
                  ToolTip.Tip="Apply this preset to the workspace" Click="Apply_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="Panes" Grid.Row="1" ColumnDefinitions="*,320" ColumnSpacing="8">
      <local:PhysPresetMotionPreview Bounce="{Binding PreviewBounce}" Friction="{Binding PreviewFriction}"
                                     InfiniteFriction="{Binding InfiniteFriction}" />
      <Border x:Name="PropertiesPane" Grid.Column="1" CornerRadius="8" BorderThickness="1"
              Background="{DynamicResource StudioSurfaceBrush}" BorderBrush="{DynamicResource StudioBorderBrush}">
        <Grid RowDefinitions="Auto,*,Auto">
          <TextBlock Text="Properties" FontWeight="SemiBold" Margin="12,8" />
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="6,0,6,6" Spacing="3">
              <Expander Header="Physical response" IsExpanded="True">
                <StackPanel Spacing="6">
                  <ContentControl Classes="numericField" Content="{Binding Mass}" />
                  <ContentControl Classes="numericField" Content="{Binding Bounce}" />
                  <ContentControl Classes="numericField" Content="{Binding Friction}" />
                  <CheckBox Content="Infinite friction" IsChecked="{Binding InfiniteFriction, Mode=TwoWay}"
                            IsEnabled="{Binding IsEditable}" />
                </StackPanel>
              </Expander>
              <Expander Header="Used by" IsExpanded="{Binding IsUsedByExpanded, Mode=TwoWay}">
                <StackPanel Spacing="6">
                  <TextBlock Text="Direct XModel, ClipMap, Fx glass and Vehicle references in the workspace catalog, including applied edits."
                             TextWrapping="Wrap" Foreground="{DynamicResource StudioTextMutedBrush}" />
                  <TextBlock Text="No direct references found." IsVisible="{Binding HasNoUsages}" />
                  <ItemsControl ItemsSource="{Binding Usages}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="documents:PhysPresetUsage">
                        <StackPanel Margin="0,0,0,5">
                          <TextBlock Text="{Binding AssetName}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Field}" TextWrapping="Wrap"
                                     Foreground="{DynamicResource StudioTextMutedBrush}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Expander>
              <Expander Header="Force scales">
                <StackPanel Spacing="6">
                  <ContentControl Classes="numericField" Content="{Binding BulletForceScale}" />
                  <ContentControl Classes="numericField" Content="{Binding ExplosiveForceScale}" />
                </StackPanel>
              </Expander>
              <Expander Header="Pieces">
                <StackPanel Spacing="6">
                  <ContentControl Classes="numericField" Content="{Binding PiecesSpreadFraction}" />
                  <ContentControl Classes="numericField" Content="{Binding PiecesUpwardVelocity}" />
                </StackPanel>
              </Expander>
              <Expander Header="Sound">
                <StackPanel Spacing="6">
                  <CheckBox Content="Sound alias prefix" IsChecked="{Binding HasSoundPrefix, Mode=TwoWay}"
                            ToolTip.Tip="An unchecked prefix is stored as NULL. A checked prefix can be an empty string."
                            IsEnabled="{Binding IsEditable}" />
                  <TextBox Text="{Binding SoundPrefix.Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           IsReadOnly="{Binding SoundPrefix.IsReadOnly}" IsEnabled="{Binding HasSoundPrefix}"
                           PlaceholderText="Empty prefix" AutomationProperties.Name="Sound alias prefix text" />
                  <CheckBox Content="Use per-surface sound aliases" IsChecked="{Binding PerSurfaceSndAlias, Mode=TwoWay}"
                            IsEnabled="{Binding IsEditable}" />
                </StackPanel>
              </Expander>
              <Expander Header="Native settings">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,90">
                    <TextBlock Text="Sound class index" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding SoundClassIndex.Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding SoundClassIndex.IsReadOnly}" AutomationProperties.Name="Physics sound class index" />
                  </Grid>
                  <CheckBox Content="Temporarily default to cylinder" IsChecked="{Binding TempDefaultToCylinder, Mode=TwoWay}"
                            IsEnabled="{Binding IsEditable}" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
          <TextBlock Grid.Row="2" Text="{Binding InputError}" IsVisible="{Binding HasInputError}" TextWrapping="Wrap"
                     Margin="10,5" Foreground="{DynamicResource StudioErrorBrush}" />
        </Grid>
      </Border>
    </Grid>
    <TextBlock Grid.Row="2" Text="{Binding SourceZone}" FontSize="11" TextTrimming="CharacterEllipsis"
               Foreground="{DynamicResource StudioTextMutedBrush}" />
  </Grid>
</UserControl>
