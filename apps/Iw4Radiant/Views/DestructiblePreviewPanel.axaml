<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Iw4Radiant.Views.DestructiblePreviewPanel">
    <StackPanel Spacing="8">
        <StackPanel Spacing="2">
            <TextBlock Text="LAPD Police Car" FontWeight="SemiBold" />
            <TextBlock Text="Preview only · Map unchanged" Classes="caption" />
        </StackPanel>
        <Grid ColumnDefinitions="90,*" ColumnSpacing="6">
            <TextBlock Text="Appearance" Classes="fieldLabel" VerticalAlignment="Center" />
            <ComboBox x:Name="AppearanceBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0">
                <ComboBoxItem Content="Intact" />
                <ComboBoxItem Content="Light smoke" />
                <ComboBoxItem Content="Heavy smoke" />
                <ComboBoxItem Content="Burning" />
                <ComboBoxItem Content="Wreck" />
            </ComboBox>
        </Grid>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
            <Button x:Name="PlayButton" Content="Play destruction" Classes="panelAction" HorizontalAlignment="Stretch" />
            <Button x:Name="ResetButton" Grid.Column="1" Content="Reset" />
        </Grid>
        <Expander Header="Parts" IsExpanded="False">
            <StackPanel Spacing="7" Margin="0,8,0,0">
                <Grid ColumnDefinitions="90,*" ColumnSpacing="6">
                    <TextBlock Text="Windshield" Classes="fieldLabel" VerticalAlignment="Center" />
                    <ComboBox x:Name="WindshieldBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <ComboBoxItem Content="Intact" />
                        <ComboBoxItem Content="Damaged" />
                        <ComboBoxItem Content="Broken" />
                    </ComboBox>
                </Grid>
                <Grid ColumnDefinitions="90,*" ColumnSpacing="6">
                    <TextBlock Text="Front-left tire" Classes="fieldLabel" VerticalAlignment="Center" />
                    <ComboBox x:Name="TireBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <ComboBoxItem Content="Intact" />
                        <ComboBoxItem Content="Flat" />
                    </ComboBox>
                </Grid>
                <TextBlock x:Name="PartsAvailabilityHint" Classes="caption" TextWrapping="Wrap"
                           Text="Parts do not affect the wreck appearance." IsVisible="False" />
                <TextBlock x:Name="TireAvailabilityHint" Classes="caption" TextWrapping="Wrap" IsVisible="False" />
            </StackPanel>
        </Expander>
        <TextBlock x:Name="PreviewStatus" Classes="caption" TextWrapping="Wrap" IsVisible="False" />
    </StackPanel>
</UserControl>
