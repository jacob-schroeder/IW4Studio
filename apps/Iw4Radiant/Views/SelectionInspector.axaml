<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Iw4Radiant.Views"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Iw4Radiant.Views.SelectionInspector">
    <UserControl.Styles>
        <Style Selector="TabItem">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*" Background="#292B2F">
        <Border Padding="12,10" BorderBrush="#3A3D42" BorderThickness="0,0,0,1">
            <StackPanel Spacing="5">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon Kind="TuneVariant" Width="15" Height="15" />
                    <TextBlock Text="Inspector" Classes="panelTitle" />
                </StackPanel>
                <TextBlock x:Name="SelectionText" Text="No selection" TextWrapping="Wrap" Classes="caption" />
            </StackPanel>
        </Border>
        <TabControl x:Name="InspectorTabs" Grid.Row="1" Padding="0">
            <TabItem x:Name="SelectionTab" ToolTip.Tip="Selection · bounds and transforms" AutomationProperties.Name="Selection">
                <TabItem.Header><materialIcons:MaterialIcon Kind="CursorDefaultOutline" Width="16" Height="16" /></TabItem.Header>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12" Spacing="10">
                        <TextBlock Text="Bounds" Classes="panelTitle"
                                   ToolTip.Tip="Bounds describe the current selection. Select one whole brush to resize it." />
                        <Grid ColumnDefinitions="48,*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="4" RowSpacing="4">
                            <TextBlock Grid.Column="1" Text="X" Classes="caption" />
                            <TextBlock Grid.Column="2" Text="Y" Classes="caption" />
                            <TextBlock Grid.Column="3" Text="Z" Classes="caption" />
                            <TextBlock Grid.Row="1" Text="Min" Classes="fieldLabel" />
                            <TextBox x:Name="MinX" Grid.Row="1" Grid.Column="1" ToolTip.Tip="Minimum X" />
                            <TextBox x:Name="MinY" Grid.Row="1" Grid.Column="2" ToolTip.Tip="Minimum Y" />
                            <TextBox x:Name="MinZ" Grid.Row="1" Grid.Column="3" ToolTip.Tip="Minimum Z" />
                            <TextBlock Grid.Row="2" Text="Size" Classes="fieldLabel" />
                            <TextBox x:Name="SizeX" Grid.Row="2" Grid.Column="1" ToolTip.Tip="Size X" />
                            <TextBox x:Name="SizeY" Grid.Row="2" Grid.Column="2" ToolTip.Tip="Size Y" />
                            <TextBox x:Name="SizeZ" Grid.Row="2" Grid.Column="3" ToolTip.Tip="Size Z" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
                            <Button x:Name="ApplyBoundsButton" Content="Apply bounds" Classes="panelAction" HorizontalAlignment="Stretch"
                                    ToolTip.Tip="Resize the selected brush to these bounds." />
                            <Button x:Name="RevertBoundsButton" Grid.Column="1" Content="Revert"
                                    ToolTip.Tip="Restore the current selection bounds without editing the map." />
                        </Grid>
                        <Separator />
                        <views:TransformInspector x:Name="Transforms" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="GeometryTab" ToolTip.Tip="Geometry · curves, arches and stairs" AutomationProperties.Name="Geometry">
                <TabItem.Header><materialIcons:MaterialIcon Kind="VectorPolygon" Width="16" Height="16" /></TabItem.Header>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <views:GeometryInspector x:Name="Geometry" Margin="12" />
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="SurfaceTab" ToolTip.Tip="Surfaces · texture alignment and decals" AutomationProperties.Name="Surfaces">
                <TabItem.Header><materialIcons:MaterialIcon Kind="TextureBox" Width="16" Height="16" /></TabItem.Header>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12" Spacing="10">
                        <views:SurfaceInspector x:Name="Surfaces" />
                        <views:DecalInspector x:Name="Decals" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="EntityTab" ToolTip.Tip="Entities · gameplay, links and lights" AutomationProperties.Name="Entities">
                <TabItem.Header><materialIcons:MaterialIcon Kind="CubeOutline" Width="16" Height="16" /></TabItem.Header>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12" Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
                            <ComboBox x:Name="EntityList" HorizontalAlignment="Stretch" ToolTip.Tip="Select an entity to inspect." />
                            <Button x:Name="WorldButton" Grid.Column="1" Content="World" ToolTip.Tip="Select the worldspawn entity." />
                        </Grid>
                        <TextBlock x:Name="EntitySelectionInfo" Text="Edits apply to the active entity only."
                                   Foreground="#E5B477" TextWrapping="Wrap" IsVisible="False" />
                        <views:GameplayEntityInspector x:Name="Gameplay" />
                        <views:LightInspector x:Name="Lights" />
                        <Expander x:Name="PropertiesExpander" Header="Entity properties" IsExpanded="False">
                            <StackPanel Spacing="7" Margin="0,8,0,0">
                                <TextBox x:Name="PropertiesBox" AcceptsReturn="True" MinHeight="180" TextWrapping="NoWrap"
                                         FontFamily="monospace" PlaceholderText="Select an entity."
                                         ToolTip.Tip="One key=value pair per line. Property names must be unique and classname must remain present."
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                    <Button x:Name="ApplyPropertiesButton" Content="Apply properties" Classes="panelAction" HorizontalAlignment="Stretch" />
                                    <Button x:Name="RevertPropertiesButton" Grid.Column="1" Content="Revert"
                                            ToolTip.Tip="Restore the entity's current properties without editing the map." />
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="TerrainTab" ToolTip.Tip="Terrain · sculpting, vertex noise, color and alpha" AutomationProperties.Name="Terrain">
                <TabItem.Header><materialIcons:MaterialIcon Kind="Terrain" Width="16" Height="16" /></TabItem.Header>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12" Spacing="12">
                        <views:TerrainInspector x:Name="Terrain" />
                        <Separator />
                        <views:TerrainPaintInspector x:Name="TerrainPaint" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="OrganizationTab" ToolTip.Tip="Organization · layers, groups and visibility" AutomationProperties.Name="Organization">
                <TabItem.Header><materialIcons:MaterialIcon Kind="LayersOutline" Width="16" Height="16" /></TabItem.Header>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <views:OrganizationInspector x:Name="Organization" Margin="12" />
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="EnvironmentTab" ToolTip.Tip="Environment · sunlight and skies" AutomationProperties.Name="Environment">
                <TabItem.Header>
                    <materialIcons:MaterialIcon Kind="WeatherSunny" Width="16" Height="16" />
                </TabItem.Header>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12" Spacing="12">
                        <views:SunlightInspector x:Name="Sunlight" />
                        <Separator />
                        <views:SkyInspector x:Name="Skies" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="PainterTab" ToolTip.Tip="Painter · model brush palette and settings" AutomationProperties.Name="Painter">
                <TabItem.Header><materialIcons:MaterialIcon Kind="Spray" Width="16" Height="16" /></TabItem.Header>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <views:FoliagePainterInspector x:Name="Painter" Margin="12" />
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
