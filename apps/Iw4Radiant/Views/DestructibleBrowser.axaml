<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Iw4Radiant.Views"
             x:Class="Iw4Radiant.Views.DestructibleBrowser">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Background="#222427" RowSpacing="5">
        <Grid ColumnDefinitions="*,Auto" Margin="12,5,12,0" ColumnSpacing="8">
            <TextBox x:Name="PresetFilter" Classes="compact" PlaceholderText="Search destructibles" />
            <Button x:Name="BrowseButton" Grid.Column="1" Classes="panelAction" Content="Choose library…" />
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" Margin="12,0" ColumnSpacing="8">
            <ComboBox x:Name="CategoryBox" Classes="compact" MinWidth="110" />
            <CheckBox x:Name="ShowUnavailableBox" Grid.Column="1" Content="Unavailable"
                      ToolTip.Tip="Show presets with missing assets" />
            <TextBlock x:Name="CatalogSummary" Grid.Column="2" Classes="caption" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding #CatalogSummary.Text}" />
        </Grid>
        <ListBox x:Name="PresetList" Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0" Margin="9,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="CornerRadius" Value="7" />
                    <Setter Property="Width" Value="116" /><Setter Property="Height" Value="96" />
                    <Setter Property="Padding" Value="4" /><Setter Property="Margin" Value="3" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="views:DestructibleThumbnail">
                    <Grid RowDefinitions="*,18,16" ToolTip.Tip="{CompiledBinding Status}">
                        <Border Background="#303237" CornerRadius="5">
                            <Grid>
                                <Image Source="{CompiledBinding Preview}" Stretch="Uniform" MaxHeight="48" />
                                <TextBlock Text="Intact model unavailable" IsVisible="{CompiledBinding IsUnavailable}"
                                           Classes="caption" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="1" Text="{CompiledBinding Name}" FontSize="11" FontWeight="SemiBold"
                                   Margin="0,2,0,0" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" ToolTip.Tip="{CompiledBinding Name}" />
                        <TextBlock Grid.Row="2" Text="{CompiledBinding ReadinessLabel}" Classes="caption"
                                   TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="EmptyState" Grid.Row="2" Classes="caption" Margin="12" TextWrapping="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
        <Border Grid.Row="3" BorderBrush="#393C42" BorderThickness="0,1,0,0" Padding="12,4,12,8">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                <WrapPanel Grid.Row="0" Orientation="Horizontal">
                <Grid x:Name="VariantRow" ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="False" Margin="0,0,8,4" VerticalAlignment="Center">
                    <TextBlock Text="Variant" Classes="fieldLabel" VerticalAlignment="Center" />
                    <ComboBox x:Name="VariantBox" Grid.Column="1" HorizontalAlignment="Left" Width="130">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="views:DestructibleThumbnail">
                                <TextBlock Text="{CompiledBinding VariantLabel}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                    <Button x:Name="PlaceButton" Classes="panelAction" Content="Place destructible" IsEnabled="False" Margin="0,0,6,4" />
                    <Button x:Name="RefreshButton" Content="Refresh assets" Margin="0,0,6,4" />
                    <Button x:Name="IssuesButton" Content="Review missing assets…" IsVisible="False" Margin="0,0,0,4" />
                </WrapPanel>
                <TextBlock x:Name="PresetInfo" Grid.Row="1" Classes="caption" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding #PresetInfo.Text}"
                           Text="Load extracted XModels to preview and place a destructible." />
            </Grid>
        </Border>
    </Grid>
</UserControl>
