<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Iw4Radiant.Views"
             x:Class="Iw4Radiant.Views.DestructibleBrowser">
    <Grid RowDefinitions="Auto,*,Auto" Background="#222427">
        <TextBlock Text="Destructibles" Classes="panelTitle" Margin="8,5" />
        <ListBox x:Name="PresetList" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Width" Value="168" /><Setter Property="Height" Value="170" />
                    <Setter Property="Padding" Value="5" /><Setter Property="Margin" Value="3" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="views:DestructibleThumbnail">
                    <Grid RowDefinitions="*,Auto,Auto" ToolTip.Tip="{CompiledBinding Status}">
                        <Border Background="#303237" CornerRadius="2">
                            <Grid>
                                <Image Source="{CompiledBinding Preview}" Stretch="Uniform" />
                                <TextBlock Text="Intact model unavailable" IsVisible="{CompiledBinding IsUnavailable}"
                                           Classes="caption" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="1" Text="{CompiledBinding Name}" FontSize="11" FontWeight="SemiBold"
                                   Margin="0,4,0,0" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="2" Text="{CompiledBinding Description}" Classes="caption"
                                   TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="2" BorderBrush="#393C42" BorderThickness="0,1,0,0" Padding="8,5">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                <Button x:Name="PlaceButton" Classes="panelAction" Content="Place destructible" IsEnabled="False"
                        HorizontalAlignment="Left" />
                <TextBlock x:Name="PresetInfo" Grid.Row="1" Classes="caption" TextWrapping="Wrap"
                           Text="Load extracted XModels to preview and place a destructible." />
            </Grid>
        </Border>
    </Grid>
</UserControl>
