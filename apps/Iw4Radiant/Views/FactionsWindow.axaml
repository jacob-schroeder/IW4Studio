<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:character="using:IW4.Formats.SourceFormat.Character"
        x:Class="Iw4Radiant.Views.FactionsWindow" x:CompileBindings="False"
        Title="Factions" Width="1080" Height="880" MinWidth="900" MinHeight="740"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24" RowSpacing="18">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
            <StackPanel Spacing="5">
                <TextBlock Text="Factions" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Choose the default teams for this map." Opacity="0.7" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="5" MaxWidth="350">
                <Button x:Name="SaveBlenderKit" Content="Save Blender kit…" Click="SaveBlenderKit_Click"
                        HorizontalAlignment="Right" IsVisible="False"
                        ToolTip.Tip="Body and viewhands rigs, plus a simple robot example." />
                <TextBlock x:Name="BlenderKitStatus" FontSize="11" TextWrapping="Wrap" Opacity="0.7" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
            <Border x:Name="AlliesCard" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Button x:Name="AlliesButton" Content="Allies" MinWidth="86" Click="Allies_Click" />
                    <ComboBox x:Name="AlliesFaction" Grid.Column="1" HorizontalAlignment="Stretch"
                              SelectionChanged="Faction_Changed" AutomationProperties.Name="Allies faction" />
                </Grid>
            </Border>
            <Border x:Name="AxisCard" Grid.Column="1" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Button x:Name="AxisButton" Content="Axis" MinWidth="86" Click="Axis_Click" />
                    <ComboBox x:Name="AxisFaction" Grid.Column="1" HorizontalAlignment="Stretch"
                              SelectionChanged="Faction_Changed" AutomationProperties.Name="Axis faction" />
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="250,*" ColumnSpacing="18">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                <TextBlock x:Name="RosterTitle" FontWeight="SemiBold" FontSize="16" />
                <TextBox x:Name="Search" Grid.Row="1" PlaceholderText="Find a player model…"
                         TextChanged="Search_Changed" AutomationProperties.Name="Find player models" />
                <ListBox x:Name="Variants" Grid.Row="2" SelectionChanged="Variant_Changed"
                         AutomationProperties.Name="Player model variants">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5,7" Spacing="3">
                                <TextBlock Text="{Binding Label}" FontWeight="Medium" />
                                <TextBlock Text="{Binding Detail}" Opacity="0.6" FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <Border Grid.Column="1" Background="#191B1F" CornerRadius="8" Padding="16">
                <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="PreviewTitle" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="PreviewSubtitle" Text="Appearance preview · default pose" Opacity="0.55" FontSize="11" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Reset view" Click="ResetView_Click" />
                    </Grid>
                    <Grid Grid.Row="1" ClipToBounds="True" Background="Transparent">
                        <Image x:Name="PreviewImage" Stretch="Uniform" Focusable="True" KeyDown="Preview_KeyDown"
                               PointerPressed="Preview_Pressed" PointerMoved="Preview_Moved"
                               PointerReleased="Preview_Released" PointerCaptureLost="Preview_CaptureLost"
                               PointerWheelChanged="Preview_Wheel" AutomationProperties.Name="Player appearance preview" />
                        <TextBlock x:Name="PreviewMessage" TextWrapping="Wrap" MaxWidth="410"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Grid>
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <TextBlock x:Name="PartLabel" Text="Preview head" VerticalAlignment="Center" Opacity="0.7" />
                        <ComboBox x:Name="Heads" Grid.Column="1" HorizontalAlignment="Stretch"
                                  SelectionChanged="Head_Changed" AutomationProperties.Name="Preview head" />
                        <ComboBox x:Name="HandModels" Grid.Column="1" HorizontalAlignment="Stretch" IsVisible="False"
                                  SelectionChanged="Head_Changed" AutomationProperties.Name="Preview hands" />
                        <TextBlock x:Name="ReplacementPartPreview" Grid.Column="1" IsVisible="False"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <CheckBox x:Name="HandsPreview" Grid.Column="2" Content="View hands"
                                  IsCheckedChanged="Hands_Changed" />
                    </Grid>
                    <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                        <TextBlock Text="Preview detail" VerticalAlignment="Center" Opacity="0.7" />
                        <ComboBox x:Name="PreviewLod" Grid.Column="1" MinWidth="80"
                                  SelectionChanged="PreviewLod_Changed" AutomationProperties.Name="Preview detail level" />
                        <TextBlock x:Name="PreviewGeometry" Grid.Column="2" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Opacity="0.7" FontSize="11" />
                    </Grid>
                    <Border Grid.Row="4" MaxHeight="190" BorderBrush="#505861" BorderThickness="1" CornerRadius="6" Padding="12">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Replace appearance" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ReplacementStatus" TextWrapping="Wrap" Opacity="0.7" FontSize="11" />
                                </StackPanel>
                                <Button x:Name="ReplaceAppearance" Grid.Column="1" Content="Replace appearance"
                                        Click="ReplaceAppearance_Click" />
                                <Button x:Name="RestoreStock" Grid.Column="2" Content="Restore stock"
                                        Click="RestoreStock_Click" IsVisible="False" />
                            </Grid>
                            <Grid x:Name="ReplacementEditor" ColumnDefinitions="*,*,*" ColumnSpacing="8" IsVisible="False">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Body" FontSize="11" Opacity="0.8" />
                                    <ComboBox x:Name="ReplacementBody" SelectionChanged="Replacement_Changed"
                                              AutomationProperties.Name="Replacement body" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="Head" FontSize="11" Opacity="0.8" />
                                    <ComboBox x:Name="ReplacementHead" SelectionChanged="Replacement_Changed"
                                              AutomationProperties.Name="Replacement head" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="3">
                                    <TextBlock Text="View hands" FontSize="11" Opacity="0.8" />
                                    <ComboBox x:Name="ReplacementHands" SelectionChanged="Replacement_Changed"
                                              AutomationProperties.Name="Replacement view hands" />
                                </StackPanel>
                            </Grid>
                            <StackPanel x:Name="BlenderImportPanel" Spacing="5" IsVisible="False">
                                <Button x:Name="ImportBlender" Content="Import Blender model…"
                                        HorizontalAlignment="Left" Click="ImportBlender_Click" />
                                <SelectableTextBlock x:Name="ImportStatus" TextWrapping="Wrap" FontSize="11" />
                                <TextBlock Text="Export the body (head included) and matching hands as two GLBs from the Blender kit. Import optimizes both for PS3 and creates body distance LODs. Your originals stay unchanged. Color-only materials are supported for now."
                                           TextWrapping="Wrap" FontSize="11" Opacity="0.7" />
                                <TextBlock Text="{x:Static character:CharacterModelBudget.Summary}"
                                           TextWrapping="Wrap" FontSize="11" Opacity="0.8" />
                            </StackPanel>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <TextBlock Grid.Row="5" Text="Right-drag orbit · middle-drag or Shift+right-drag pan · scroll zoom · End frame. Appearance varies by class and environment."
                               TextWrapping="Wrap" Opacity="0.6" FontSize="11" />
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel VerticalAlignment="Center" Spacing="3">
                <TextBlock x:Name="Summary" TextWrapping="Wrap" />
                <TextBlock Text="Apply saves team choices and replacements. Walk previews Allies · Assault · 1. Other models are preview-only."
                           TextWrapping="Wrap" FontSize="11" Opacity="0.6" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="CancelAction" Content="Cancel" MinWidth="80" Click="Cancel_Click" />
                <Button x:Name="ApplyAction" Content="Apply" MinWidth="88" Classes="primary" Click="Apply_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
