<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Iw4Radiant.Views.MapBuildWindow"
        Title="Build PS3 map" Width="760" Height="830"
        MinWidth="640" MinHeight="740" WindowStartupLocation="CenterOwner">
    <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
        <StackPanel Spacing="6">
            <TextBlock x:Name="SourceName" FontSize="17" FontWeight="SemiBold" />
            <TextBlock x:Name="GameModesText" Classes="caption" FontWeight="SemiBold" IsVisible="False" />
            <TextBlock x:Name="ScopeText" Classes="caption" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel x:Name="BuildInputs" Grid.Row="1" Spacing="10">
            <StackPanel Spacing="4">
                <TextBlock Text="D3dbspLinker tool" Classes="panelTitle" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="LinkerPathBox" PlaceholderText="Select D3dbspLinker.dll or the executable"
                             AutomationProperties.Name="D3dbspLinker path" />
                    <Button Grid.Column="1" Content="Browse…" Click="BrowseLinker_Click" />
                </Grid>
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="Asset library" Classes="panelTitle" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="EmitterAssetDirectoryBox" PlaceholderText="Choose the raw folder containing your source assets"
                             AutomationProperties.Name="Asset library folder" />
                    <Button Grid.Column="1" Content="Browse…" Click="BrowseEmitterAssets_Click" />
                </Grid>
                <TextBlock Text="Your models, materials, textures, FX and sounds come from this folder. Startup assets are included with the linker."
                           Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="Output folder" Classes="panelTitle" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="OutputFolderBox" AutomationProperties.Name="Build output folder" />
                    <Button Grid.Column="1" Content="Browse…" Click="BrowseOutput_Click" />
                </Grid>
                <TextBlock Text="Each build creates a new folder with your compiled map and its texture package. Keep the .ff and matching .pak together."
                           Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
        <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto" RowSpacing="6">
            <TextBlock x:Name="BuildStatus" Text="Ready to build the saved map." Classes="panelTitle" TextWrapping="Wrap" />
            <TextBox x:Name="ProgressOutput" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="Wrap" FontFamily="Menlo,Consolas,monospace" FontSize="11"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Build progress" />
            <Grid x:Name="ErrorLocation" Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10"
                  IsVisible="False">
                <TextBlock x:Name="ErrorLocationText" VerticalAlignment="Center" TextWrapping="Wrap"
                           Classes="caption" />
                <Button x:Name="ShowErrorButton" Grid.Column="1" Content="Show in map"
                        Classes="panelAction" Click="ShowError_Click"
                        AutomationProperties.Name="Show build error in map" />
            </Grid>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="BuildButton" Content="Build PS3 fastfile" Classes="panelAction" Click="Build_Click" />
            <Button x:Name="PreviewButton" Content="Preview compiled map" Classes="panelAction"
                    IsVisible="False" Click="Preview_Click" AutomationProperties.Name="Preview compiled map" />
            <Button x:Name="CloseButton" Content="Close" MinWidth="88" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
