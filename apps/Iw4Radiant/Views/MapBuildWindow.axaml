<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Iw4Radiant.Views.MapBuildWindow"
        Title="Build PS3 map (.ff)" Width="720" Height="560"
        MinWidth="600" MinHeight="480" WindowStartupLocation="CenterOwner">
    <Grid Margin="18" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
        <StackPanel Spacing="4">
            <TextBlock x:Name="SourceName" FontSize="17" FontWeight="SemiBold" />
            <TextBlock x:Name="GameModesText" Classes="caption" FontWeight="SemiBold" IsVisible="False" />
        </StackPanel>
        <StackPanel x:Name="BuildInputs" Grid.Row="1" Spacing="12">
            <StackPanel Spacing="4">
                <TextBlock Text="Asset library" Classes="panelTitle" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="EmitterAssetDirectoryBox" PlaceholderText="Select raw asset folder"
                             ToolTip.Tip="Source models, materials, textures, FX, and sounds."
                             AutomationProperties.Name="Asset library folder" />
                    <Button Grid.Column="1" Content="Browse…" Click="BrowseEmitterAssets_Click" />
                </Grid>
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="Output folder" Classes="panelTitle" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="OutputFolderBox" ToolTip.Tip="Each build creates a folder with the .ff and matching .pak."
                             AutomationProperties.Name="Build output folder" />
                    <Button Grid.Column="1" Content="Browse…" Click="BrowseOutput_Click" />
                </Grid>
            </StackPanel>
        </StackPanel>
        <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="6">
            <TextBlock x:Name="BuildStatus" Text="Ready to build the saved map." FontSize="14"
                       FontWeight="SemiBold" TextWrapping="Wrap" />
            <ProgressBar x:Name="BuildProgress" Grid.Row="1" Height="4" IsIndeterminate="True"
                         IsVisible="False" AutomationProperties.Name="Build in progress" />
            <TextBlock Grid.Row="2" Text="Build log" Classes="caption" />
            <TextBox x:Name="ProgressOutput" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="Wrap" FontFamily="Menlo,Consolas,monospace" FontSize="11"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Build log" />
            <Grid x:Name="ErrorLocation" Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="10"
                  IsVisible="False">
                <TextBlock x:Name="ErrorLocationText" VerticalAlignment="Center" TextWrapping="Wrap"
                           Classes="caption" />
                <Button x:Name="ShowErrorButton" Grid.Column="1" Content="Show in map"
                        Classes="panelAction" Click="ShowError_Click"
                        AutomationProperties.Name="Show build error in map" />
            </Grid>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="BuildButton" Content="Build PS3 map (.ff)" Classes="panelAction" Click="Build_Click" />
            <Button x:Name="PreviewButton" Content="Preview compiled map" Classes="panelAction"
                    IsVisible="False" Click="Preview_Click" AutomationProperties.Name="Preview compiled map" />
            <Button x:Name="CloseButton" Content="Close" MinWidth="88" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
