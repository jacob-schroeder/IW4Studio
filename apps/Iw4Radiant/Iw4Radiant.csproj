<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <VersionPrefix>0.1</VersionPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Authoring/IW4.Formats/IW4.Formats.csproj" />
    <ProjectReference Include="../../src/Authoring/IW4.Unlinker/IW4.Unlinker.csproj" />
    <ProjectReference Include="../../src/Rendering/IW4.Render.WebGpu/IW4.Render.WebGpu.csproj" />
    <ProjectReference Include="../../src/Rendering/IW4.Render/IW4.Render.csproj" />
    <ProjectReference Include="../../src/Rendering/IW4.Render.OpenGl/IW4.Render.OpenGl.csproj" />
    <ProjectReference Include="../../src/Engine/IW4.Game/IW4.Game.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../IW4Studio/Editors/Sound/SoundPreviewPlayer.cs" Link="Views/SoundPreviewPlayer.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Shaders/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../src/Authoring/IW4.Formats/SourceFormat/Material/Shaders/ocean-waves.hlsl" Link="Shaders/ocean-waves.hlsl" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../src/Authoring/IW4.Formats/SourceFormat/Material/Shaders/ocean-surface.hlsl" Link="Shaders/ocean-surface.hlsl" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
