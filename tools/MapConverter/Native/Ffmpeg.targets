<Project>
  <PropertyGroup>
    <_FfmpegRid>$(RuntimeIdentifier)</_FfmpegRid>
    <_FfmpegRid Condition="'$(_FfmpegRid)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</_FfmpegRid>
    <MapConverterFfmpegName Condition="$(_FfmpegRid.StartsWith('win-'))">ffmpeg.exe</MapConverterFfmpegName>
    <MapConverterFfmpegName Condition="'$(MapConverterFfmpegName)' == ''">ffmpeg</MapConverterFfmpegName>
  </PropertyGroup>
  <!-- Normal Studio builds and release publishes use the same target-specific distribution. -->
  <PropertyGroup Condition="'$(MapConverterFfmpegPath)' == '' and '$(_FfmpegRid)' == 'osx-arm64'">
    <_FfmpegUrl>https://ffmpeg.martin-riedl.de/download/macos/arm64/1795207104_9.1/ffmpeg.zip</_FfmpegUrl>
    <_FfmpegHash>1f66e9a690a7f1c9e60b012379f8869c11818d1797f45b21dbb2f2564ba61ae1</_FfmpegHash>
    <_FfmpegBinary>ffmpeg</_FfmpegBinary>
    <_FfmpegLicense>COPYING.GPLv3</_FfmpegLicense>
    <_FfmpegNotice>NOTICE.txt</_FfmpegNotice>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MapConverterFfmpegPath)' == '' and '$(_FfmpegRid)' == 'win-x64'">
    <_FfmpegUrl>https://www.gyan.dev/ffmpeg/builds/packages/ffmpeg-9.0.2-essentials_build.zip</_FfmpegUrl>
    <_FfmpegHash>60f467265b1e312373dbcd92200c2618a74850f98d3d078e94296bb3fa2047ba</_FfmpegHash>
    <_FfmpegBinary>ffmpeg-9.0.2-essentials_build/bin/ffmpeg.exe</_FfmpegBinary>
    <_FfmpegLicense>ffmpeg-9.0.2-essentials_build/LICENSE</_FfmpegLicense>
    <_FfmpegNotice>ffmpeg-9.0.2-essentials_build/README.txt</_FfmpegNotice>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_FfmpegUrl)' != ''">
    <_FfmpegDir>$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/$(_FfmpegRid)/ffmpeg/$(_FfmpegHash)</_FfmpegDir>
    <MapConverterFfmpegPath>$(_FfmpegDir)/$(_FfmpegBinary)</MapConverterFfmpegPath>
    <MapConverterFfmpegLicensePath>$(_FfmpegDir)/$(_FfmpegLicense)</MapConverterFfmpegLicensePath>
    <MapConverterFfmpegNoticePath>$(_FfmpegDir)/$(_FfmpegNotice)</MapConverterFfmpegNoticePath>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(MapConverterFfmpegPath)" Condition="'$(MapConverterFfmpegPath)' != ''"
             Link="$(MapConverterFfmpegName)" ExcludeFromSingleFile="true" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(MapConverterFfmpegLicensePath)" Condition="'$(MapConverterFfmpegLicensePath)' != ''"
             Link="ffmpeg-license.txt" ExcludeFromSingleFile="true" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(MapConverterFfmpegNoticePath)" Condition="'$(MapConverterFfmpegNoticePath)' != ''"
             Link="ffmpeg-notice.txt" ExcludeFromSingleFile="true" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PrepareMapConverterFfmpeg"
          Condition="'$(_FfmpegUrl)' != '' and (!Exists('$(_FfmpegDir)/ready') or !Exists('$(MapConverterFfmpegPath)') or !Exists('$(MapConverterFfmpegLicensePath)') or !Exists('$(MapConverterFfmpegNoticePath)'))">
    <MakeDir Directories="$(_FfmpegDir)" />
    <DownloadFile SourceUrl="$(_FfmpegUrl)" DestinationFolder="$(_FfmpegDir)" DestinationFileName="ffmpeg.zip" />
    <VerifyFileHash File="$(_FfmpegDir)/ffmpeg.zip" Hash="$(_FfmpegHash)" Algorithm="SHA256" />
    <Unzip SourceFiles="$(_FfmpegDir)/ffmpeg.zip" DestinationFolder="$(_FfmpegDir)" />
    <DownloadFile Condition="'$(_FfmpegRid)' == 'osx-arm64'" SourceUrl="https://raw.githubusercontent.com/FFmpeg/FFmpeg/n9.1/COPYING.GPLv3"
                  DestinationFolder="$(_FfmpegDir)" DestinationFileName="$(_FfmpegLicense)" />
    <VerifyFileHash Condition="'$(_FfmpegRid)' == 'osx-arm64'" File="$(MapConverterFfmpegLicensePath)"
                    Hash="8ceb4b9ee5adedde47b31e975c1d90c73ad27b6b165a1dcd80c7c545eb65b903" Algorithm="SHA256" />
    <WriteLinesToFile Condition="'$(_FfmpegRid)' == 'osx-arm64'" File="$(MapConverterFfmpegNoticePath)" Overwrite="true"
                      Lines="FFmpeg 9.1 macOS arm64 distribution:;https://ffmpeg.martin-riedl.de/info/detail/macos/arm64/1795207104_9.1;FFmpeg source: https://github.com/FFmpeg/FFmpeg/tree/n9.1" />
    <Exec Condition="'$(_FfmpegRid)' == 'osx-arm64' and !$([MSBuild]::IsOSPlatform('Windows'))" Command="chmod +x &quot;$(MapConverterFfmpegPath)&quot;" />
    <Touch Files="$(_FfmpegDir)/ready" AlwaysCreate="true" />
  </Target>
  <Target Name="ValidateMapConverterFfmpeg" BeforeTargets="PrepareForBuild;GetCopyToOutputDirectoryItems;ComputeFilesToPublish"
          DependsOnTargets="PrepareMapConverterFfmpeg"
          Condition="'$(MapConverterFfmpegPath)' != ''">
    <Error Condition="!Exists('$(MapConverterFfmpegPath)')"
           Text="MapConverterFfmpegPath must name a distribution FFmpeg executable." />
    <Error Condition="'$(MapConverterFfmpegLicensePath)' == '' or !Exists('$(MapConverterFfmpegLicensePath)')"
           Text="Bundled FFmpeg requires MapConverterFfmpegLicensePath for the distribution license." />
    <Error Condition="'$(MapConverterFfmpegNoticePath)' != '' and !Exists('$(MapConverterFfmpegNoticePath)')"
           Text="MapConverterFfmpegNoticePath does not exist." />
  </Target>
  <Target Name="RequireMapConverterFfmpegForPublish" BeforeTargets="ComputeFilesToPublish" Condition="'$(SelfContained)' == 'true'">
    <Error Condition="'$(MapConverterFfmpegPath)' == ''"
           Text="A self-contained MapConverter distribution needs a target-platform FFmpeg executable with libmp3lame. Set MapConverterFfmpegPath and MapConverterFfmpegLicensePath." />
  </Target>
</Project>
